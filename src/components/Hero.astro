      看看部落格
    </a>
    <a
      href="/committee"
      data-magnetic
      class="px-6 py-3 border-2 border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors"
    >
      兒少委員專區
    </a>
  </div>
</section>
