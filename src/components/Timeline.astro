---
import { getCollection } from 'astro:content';

const entries = (await getCollection('timeline')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<ol class="relative border-l border-sage-light ml-3 space-y-10">
  {entries.map((entry, i) => (
    <li class="reveal relative pl-8" style={`animation-delay: ${i * 0.1}s`}>
      <span class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-sage border-4 border-cream"></span>
      <p class="text-sm text-sage-dark font-medium mb-1">{formatDate(entry.data.date)}</p>
      <h3 class="font-display text-lg text-ink mb-1">{entry.data.title}</h3>
      <p class="text-ink-light leading-relaxed">{entry.data.description}</p>
    </li>
  ))}
</ol>
