---
import { getCollection } from 'astro:content';

const entries = (await getCollection('timeline')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<ol class="relative border-l-4 border-ink ml-3 space-y-12">
  {entries.map((entry, i) => (
    <li class="reveal relative pl-10" style={`animation-delay: ${i * 0.1}s`}>
      <span class="absolute -left-[15px] top-1 w-6 h-6 bg-clay border-4 border-cream"></span>
      <p class="inline-block bg-ink text-cream text-xs font-semibold px-2.5 py-1 mb-2">
        {formatDate(entry.data.date)}
      </p>
      <h3 class="font-display text-xl text-ink mb-1">{entry.data.title}</h3>
      <p class="text-ink-light leading-relaxed">{entry.data.description}</p>
    </li>
  ))}
</ol>
