---
import { supabase } from '../lib/supabase';

const { data: entries } = await supabase
  .from('timeline_entries')
  .select('*')
  .order('date', { ascending: false });

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });

const statusColor: Record<string, string> = {
  提案中: 'bg-butter text-ink',
  已回應: 'bg-sage text-cream',
  已採納: 'bg-clay text-cream',
};
---

<ol class="relative border-l-4 border-ink ml-3 space-y-12">
  {(entries ?? []).map((entry, i) => (
    <li class="reveal relative pl-10" style={`animation-delay: ${i * 0.1}s`}>
      <span class="absolute -left-[15px] top-1 w-6 h-6 bg-clay border-4 border-cream"></span>
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <p class="inline-block bg-ink text-cream text-xs font-semibold px-2.5 py-1">
          {formatDate(entry.date)}
        </p>
        {entry.status && (
          <p class={`inline-block text-xs font-semibold px-2.5 py-1 ${statusColor[entry.status] ?? 'bg-cream-dark text-ink'}`}>
            {entry.status}
          </p>
        )}
      </div>
      <h3 class="font-display text-xl text-ink mb-1">{entry.title}</h3>
      <p class="text-ink-light leading-relaxed">{entry.description}</p>
      {entry.government_response && (
        <div class="mt-3 bg-sage-light border-l-4 border-sage-dark px-4 py-3">
          <p class="text-xs font-semibold text-sage-dark mb-1">縣府回應</p>
          <p class="text-ink-light leading-relaxed">{entry.government_response}</p>
        </div>
      )}
      {(entry.pdf_url || entry.link_url) && (
        <div class="flex flex-wrap gap-3 mt-3">
          {entry.pdf_url && (
            <a
              href={entry.pdf_url}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="inline-flex items-center gap-1.5 px-3 py-1.5 border-2 border-ink text-sm font-semibold text-ink hover:bg-ink hover:text-cream transition-colors"
            >
              📄 提案文件 PDF
            </a>
          )}
          {entry.link_url && (
            <a
              href={entry.link_url}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="inline-flex items-center gap-1.5 px-3 py-1.5 border-2 border-ink text-sm font-semibold text-ink hover:bg-ink hover:text-cream transition-colors"
            >
              🔗 相關連結
            </a>
          )}
        </div>
      )}
    </li>
  ))}
</ol>
