---
---
<div
  id="cursor-glow"
  class="pointer-events-none fixed inset-0 z-0 hidden sm:block"
  aria-hidden="true"
>
  <div
    id="cursor-glow-blob"
    class="absolute w-72 h-72 rounded-full bg-sage-light/40 blur-3xl transition-transform duration-300 ease-out"
    style="left: -9999px; top: -9999px;"
  ></div>
</div>

<script>
  const blob = document.getElementById('cursor-glow-blob');
  if (blob && window.matchMedia('(hover: hover)').matches) {
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    window.addEventListener('mousemove', (e) => {
      targetX = e.clientX - 144;
      targetY = e.clientY - 144;
    });

    function animate() {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      if (blob) {
        blob.style.left = `${currentX}px`;
        blob.style.top = `${currentY}px`;
      }
      requestAnimationFrame(animate);
    }
    animate();
  }
</script>
