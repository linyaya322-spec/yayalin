---
import Icon from './Icon.astro';
---
<form id="contact-form" class="reveal card-pop grid gap-4 max-w-lg p-8 pt-10">
  <div class="flex items-center gap-3 text-ink" aria-hidden="true">
    <Icon name="mouth" size={44} />
    <Icon name="mic" size={44} />
    <Icon name="paper" size={44} />
  </div>
  <input
    type="text"
    id="contact-name"
    name="name"
    placeholder="你的名字"
    aria-label="你的名字"
    required
    maxlength="40"
    class="paper-field"
  />
  <input
    type="email"
    id="contact-email"
    name="email"
    placeholder="你的 Email，方便我回覆你"
    aria-label="你的 Email"
    required
    class="paper-field"
  />
  <textarea
    id="contact-message"
    name="message"
    placeholder="想跟我說的事..."
    aria-label="想跟我說的事"
    required
    maxlength="1000"
    rows="4"
    class="paper-lines"
  ></textarea>
  <button
    type="submit"
    data-magnetic
    class="btn-pop justify-self-start inline-flex items-center gap-2 px-6 py-2.5 text-sm disabled:opacity-50"
  >
    <Icon name="send" size={18} />
    送出訊息
  </button>
  <p id="contact-status" class="text-sm min-h-5"></p>
</form>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const formData = new FormData(form);
    const name = String(formData.get('name') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();
    const message = String(formData.get('message') ?? '').trim();
    if (!name || !email || !message) return;

    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = '送出中...';

    const { data: caseNumber, error } = await supabase.rpc('submit_contact', {
      p_name: name,
      p_email: email,
      p_message: message,
    });

    if (error) {
      if (status) status.textContent = '送出失敗，請稍後再試一次，或直接寄 Email 給我。';
    } else {
      if (status) status.textContent = `已收到你的訊息，我會盡快回覆！你的案件編號是 ${caseNumber}，也會寄一封確認信到你的信箱。`;
      form.reset();
    }
    if (submitBtn) submitBtn.disabled = false;
  });
</script>
