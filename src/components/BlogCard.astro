---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
}

const { post, index = 0 } = Astro.props;

const categoryColor: Record<string, string> = {
  生活隨筆: 'bg-sage',
  兒少議題: 'bg-clay',
  興趣分享: 'bg-butter',
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a
  href={`/blog/${post.id}`}
  data-tilt
  class="reveal group block bg-cream border-2 border-ink"
  style={`animation-delay: ${index * 0.08}s`}
  data-category={post.data.category}
>
  <div class={`h-2 ${categoryColor[post.data.category] ?? 'bg-ink'}`}></div>
  <div class="p-6">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wide text-ink-light">
        {post.data.category}
      </span>
      <time class="text-xs text-ink-light">{formatDate(post.data.date)}</time>
    </div>
    <h3 class="font-display text-xl text-ink mb-2 group-hover:text-clay transition-colors">
      {post.data.title}
    </h3>
    <p class="text-sm text-ink-light leading-relaxed line-clamp-3">{post.data.excerpt}</p>
  </div>
</a>
