---
interface Props {
  label: string;
  value: string;
  href: string;
  icon: 'mail' | 'instagram';
}

const { label, value, href, icon } = Astro.props;
---

<a
  href={href}
  target={icon === 'instagram' ? '_blank' : undefined}
  rel={icon === 'instagram' ? 'noopener noreferrer' : undefined}
  data-tilt
  class="reveal group flex items-center gap-4 bg-cream border-2 border-ink p-6 hover:bg-ink transition-colors"
>
  <span class="flex items-center justify-center w-12 h-12 bg-clay text-cream group-hover:bg-butter group-hover:text-ink transition-colors shrink-0">
    {icon === 'mail' ? (
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.414.336-.75.75-.75h18c.414 0 .75.336.75.75v10.5a.75.75 0 01-.75.75H3a.75.75 0 01-.75-.75V6.75z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.5l9.75 6.75L21.75 7.5" />
      </svg>
    ) : (
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
        <path d="M16 11.37a4 4 0 11-7.914 1.174A4 4 0 0116 11.37z" />
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
      </svg>
    )}
  </span>
  <div>
    <p class="text-sm text-ink-light group-hover:text-cream/70 transition-colors">{label}</p>
    <p class="text-ink font-medium group-hover:text-cream transition-colors">{value}</p>
  </div>
</a>
