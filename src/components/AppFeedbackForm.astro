---
import Icon from './Icon.astro';
---
<form id="app-feedback-form" class="af-form">
  <div class="af-icons" aria-hidden="true">
    <Icon name="bubble" size={30} />
    <Icon name="paper" size={30} />
  </div>

  <div class="af-kinds" role="radiogroup" aria-label="類型">
    <label class="af-kind">
      <input type="radio" name="kind" value="bug" checked />
      <span>問題回報</span>
    </label>
    <label class="af-kind">
      <input type="radio" name="kind" value="idea" />
      <span>功能建議</span>
    </label>
    <label class="af-kind">
      <input type="radio" name="kind" value="other" />
      <span>其他</span>
    </label>
  </div>

  <textarea
    id="app-feedback-message"
    name="message"
    placeholder="想告訴我們的事：發生了什麼、你預期會怎樣、時間地點或路線車次…"
    aria-label="意見內容"
    required
    maxlength="4000"
    rows="5"
    class="af-field af-textarea"
  ></textarea>

  <input
    type="email"
    id="app-feedback-email"
    name="email"
    placeholder="你的 Email，方便我們回覆你（需驗證）"
    aria-label="你的 Email，需要驗證"
    required
    class="af-field"
  />
  <div class="af-code-row">
    <button type="button" id="app-feedback-send-code" class="af-btn af-btn-outline">寄驗證碼</button>
    <input
      type="text"
      id="app-feedback-code"
      name="code"
      inputmode="numeric"
      autocomplete="one-time-code"
      maxlength="6"
      placeholder="輸入 6 位數驗證碼"
      aria-label="Email 驗證碼"
      required
      disabled
      class="af-field"
    />
  </div>
  <p id="app-feedback-code-status" class="af-hint"></p>

  <button type="submit" class="af-btn af-btn-primary">
    <Icon name="send" size={16} />
    送出
  </button>
  <p id="app-feedback-status" class="af-status"></p>
</form>

<style>
  .af-form {
    display: grid;
    gap: 0.9rem;
    max-width: 32rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.5rem 1.5rem 1.7rem;
    margin: 1rem 0 1.6rem;
  }
  .af-icons {
    display: flex;
    gap: 0.6rem;
    color: var(--accent);
  }
  .af-kinds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .af-kind {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .af-kind input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .af-kind:has(input:checked) {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .af-kind:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .af-field {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.65rem 0.8rem;
    color: var(--text);
    font: inherit;
  }
  .af-field:focus {
    outline: none;
    border-color: var(--accent);
  }
  .af-field::placeholder {
    color: var(--muted);
  }
  .af-field:disabled {
    opacity: 0.6;
  }
  .af-textarea {
    resize: vertical;
    min-height: 6.5rem;
  }
  .af-code-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: center;
  }
  .af-hint {
    font-size: 0.78rem;
    color: var(--muted);
    margin: -0.4rem 0 0;
    min-height: 1em;
  }
  .af-status {
    font-size: 0.88rem;
    color: var(--text);
    margin: 0;
    min-height: 1.3em;
  }
  .af-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border-radius: 10px;
    padding: 0.6rem 1.1rem;
    font-weight: 700;
    font-size: 0.9rem;
    border: 1px solid transparent;
    cursor: pointer;
    justify-self: start;
  }
  .af-btn:disabled {
    opacity: 0.55;
    cursor: default;
  }
  .af-btn-outline {
    background: var(--bg);
    border-color: var(--line);
    color: var(--text);
    white-space: nowrap;
  }
  .af-btn-outline:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .af-btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .af-btn-primary:hover:not(:disabled) {
    filter: brightness(1.06);
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { wireEmailCode } from '../lib/emailCode';

  const form = document.getElementById('app-feedback-form') as HTMLFormElement | null;
  const status = document.getElementById('app-feedback-status');

  const emailInput = document.getElementById('app-feedback-email') as HTMLInputElement | null;
  const codeInput = document.getElementById('app-feedback-code') as HTMLInputElement | null;
  const sendBtn = document.getElementById('app-feedback-send-code') as HTMLButtonElement | null;
  const codeStatus = document.getElementById('app-feedback-code-status');
  if (emailInput && codeInput && sendBtn && codeStatus) {
    wireEmailCode({ emailInput, sendBtn, codeInput, statusEl: codeStatus, purpose: 'app' });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const formData = new FormData(form);
    const kind = String(formData.get('kind') ?? 'other');
    const message = String(formData.get('message') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();
    const code = String(formData.get('code') ?? '').trim();
    if (!message || !email) return;
    if (!/^\d{6}$/.test(code)) {
      if (status) status.textContent = '請先按「寄驗證碼」，並輸入信箱收到的 6 位數驗證碼。';
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = '送出中...';

    const { data, error } = await supabase.rpc('submit_app_feedback', {
      p_kind: kind,
      p_message: message,
      p_email: email,
      p_code: code,
    });

    if (error) {
      if (status) status.textContent = '送出失敗，請稍後再試一次，或直接寄 Email 給我們。';
    } else if (!data || !data.case_number) {
      if (status) status.textContent = '驗證碼不正確或已過期，請重新按「寄驗證碼」。你打的內容還在，不用重打。';
    } else {
      if (status) {
        status.textContent = `已收到，我們會盡快回覆！案件編號 ${data.case_number}，回覆會寄到你的信箱（在 App 內開啟同一個 Email 也能繼續對話）。`;
      }
      form.reset();
      if (codeInput) codeInput.disabled = true;
    }
    if (submitBtn) submitBtn.disabled = false;
  });
</script>
