---
import AppLayout from '../layouts/AppLayout.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<AppLayout title={title} description={description}>
  <article class="app-doc">
    <slot />
  </article>
</AppLayout>

<style>
  .app-doc {
    background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 32px 32px 36px; margin-top: 16px;
    box-shadow: 0 1px 2px rgba(14, 32, 56, 0.04), 0 12px 32px -16px rgba(14, 32, 56, 0.12);
  }
  .app-doc :global(h1) { font-size: 2.1rem; line-height: 1.25; margin: 0 0 0.5rem; letter-spacing: -0.02em; font-weight: 800; }
  .app-doc :global(h2) { font-size: 1.25rem; margin: 2.2rem 0 0.5rem; font-weight: 700; }
  .app-doc :global(p) { color: var(--muted); margin: 0.5rem 0 1rem; }
  .app-doc :global(.meta) { font-size: 0.92rem; }
  .app-doc :global(ul) { color: var(--muted); padding-left: 1.4em; margin: 0.4rem 0 1rem; }
  .app-doc :global(li) { margin-bottom: 0.35rem; }
  .app-doc :global(strong) { color: var(--text); }
  .app-doc :global(.note) { background: var(--accent-soft); border-radius: 14px; padding: 0.9rem 1.1rem; margin: 1.4rem 0; color: var(--text); }
  .app-doc :global(.cta) {
    display: inline-block; background: var(--accent); color: #fff; text-decoration: none; padding: 0.75rem 1.5rem;
    border-radius: 999px; font-weight: 700; box-shadow: 0 8px 20px -8px var(--accent); transition: transform .15s, box-shadow .15s;
  }
  .app-doc :global(.cta:hover) { transform: translateY(-1px); box-shadow: 0 10px 24px -8px var(--accent); }
  .app-doc :global(table) { width: 100%; border-collapse: collapse; font-size: 0.92rem; margin: 1rem 0 1.4rem; }
  .app-doc :global(th), .app-doc :global(td) { border: 1px solid var(--line); padding: 0.55rem 0.7rem; text-align: left; vertical-align: top; color: var(--muted); }
  .app-doc :global(th) { background: var(--accent-soft); color: var(--text); white-space: nowrap; }
  .app-doc :global(details) { border-top: 1px solid var(--line); padding: 0.7rem 0; }
  .app-doc :global(details:last-of-type) { border-bottom: 1px solid var(--line); }
  .app-doc :global(summary) { cursor: pointer; font-weight: 700; color: var(--text); }
  @media (max-width: 640px) {
    .app-doc { padding: 20px 16px 24px; }
    .app-doc :global(h1) { font-size: 1.6rem; }
    .app-doc :global(table), .app-doc :global(tbody), .app-doc :global(tr), .app-doc :global(td) { display: block; width: 100%; }
    .app-doc :global(tr:first-child) { display: none; }
    .app-doc :global(tr) { border: 1px solid var(--line); border-radius: 12px; margin: 0.8rem 0; padding: 0.3rem 0.8rem 0.6rem; }
    .app-doc :global(td) { border: 0; padding: 0.4rem 0; }
    .app-doc :global(td::before) { content: attr(data-label); display: block; font-size: 0.75rem; font-weight: 700; color: var(--text); }
  }
</style>
