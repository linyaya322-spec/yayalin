---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  tag?: string;
}

const { title, description, tag = 'TransitGo App' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { href: '/app', label: 'App 首頁' },
  { href: '/app/support', label: '客服與意見回饋' },
  { href: '/app/privacy', label: '隱私權政策' },
  { href: '/app/terms', label: '服務條款' },
];
---

<BaseLayout title={`${title}｜交通即時查`} description={description}>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <p class="reveal inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-6">{tag}</p>
    <nav aria-label="App 頁面" class="reveal flex flex-wrap gap-2 mb-8 text-sm">
      {tabs.map((t) => (
        <a
          href={t.href}
          aria-current={path === t.href ? 'page' : undefined}
          class:list={[
            'inline-block px-4 py-1.5 rounded-full font-medium border-2 transition-colors',
            path === t.href ? 'bg-butter border-ink' : 'border-transparent text-ink hover:bg-clay-light',
          ]}
        >
          {t.label}
        </a>
      ))}
    </nav>
    <div class="reveal app-doc" style="animation-delay: 0.15s;">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .app-doc :global(h1) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: 2.25rem;
    line-height: 1.25;
    margin-bottom: 0.6rem;
  }
  .app-doc :global(h2) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: 1.35rem;
    margin-top: 1.9em;
    margin-bottom: 0.6em;
  }
  .app-doc :global(p) {
    color: var(--color-ink-light);
    line-height: 1.9;
    margin-bottom: 1.1em;
  }
  .app-doc :global(.meta) {
    font-size: 0.9rem;
    margin-bottom: 1.4em;
  }
  .app-doc :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
    color: var(--color-ink-light);
    margin-bottom: 1.1em;
  }
  .app-doc :global(li) {
    margin-bottom: 0.4em;
    line-height: 1.8;
  }
  .app-doc :global(strong) {
    color: var(--color-ink);
  }
  .app-doc :global(a:not(.cta)) {
    color: var(--color-clay);
    font-weight: 600;
    text-decoration: underline;
  }
  .app-doc :global(.note) {
    background: var(--color-sage-light);
    border: 2px solid var(--color-ink);
    padding: 0.9rem 1.1rem;
    margin: 1.4rem 0;
    color: var(--color-ink);
  }
  .app-doc :global(.cta) {
    display: inline-block;
    background: var(--color-butter);
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
    padding: 0.6rem 1.2rem;
    font-weight: 700;
    text-decoration: none;
  }
  .app-doc :global(.cta:hover) {
    background: white;
  }
  .app-doc :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 1rem 0 1.4rem;
  }
  .app-doc :global(th),
  .app-doc :global(td) {
    border: 1.5px solid var(--color-ink);
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
    color: var(--color-ink-light);
  }
  .app-doc :global(th) {
    background: var(--color-butter-light);
    color: var(--color-ink);
    white-space: nowrap;
  }
  .app-doc :global(details) {
    border-top: 1.5px solid var(--color-ink);
    padding: 0.7rem 0;
  }
  .app-doc :global(details:last-of-type) {
    border-bottom: 1.5px solid var(--color-ink);
  }
  .app-doc :global(summary) {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-ink);
  }
  .app-doc :global(details p) {
    margin-top: 0.6em;
  }
  @media (max-width: 640px) {
    .app-doc :global(h1) { font-size: 1.85rem; }
    .app-doc :global(table),
    .app-doc :global(tbody),
    .app-doc :global(tr),
    .app-doc :global(td) { display: block; width: 100%; }
    .app-doc :global(tr:first-child) { display: none; }
    .app-doc :global(tr) { border: 1.5px solid var(--color-ink); margin: 0.8rem 0; padding: 0.3rem 0.8rem 0.6rem; }
    .app-doc :global(td) { border: 0; padding: 0.4rem 0; }
    .app-doc :global(td::before) {
      content: attr(data-label);
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-ink);
    }
  }
</style>
