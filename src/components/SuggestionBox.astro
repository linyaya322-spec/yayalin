---
import { supabase } from '../lib/supabase';

const { data: setting } = await supabase
  .from('app_settings')
  .select('*')
  .eq('key', 'suggestion_box_collect_school')
  .maybeSingle();

const collectSchool = setting?.value === 'true';
---

<div class="reveal bg-clay-light border-2 border-ink p-8">
  <p class="inline-block bg-ink text-cream text-xs font-semibold px-2.5 py-1 mb-4">學生意見箱</p>
  <h2 class="font-display text-2xl text-ink mb-2">有校園權益的想法嗎？</h2>
  <p class="text-ink-light mb-6">
    不管是通學安全、獎懲制度，還是其他想讓學校變更好的建議，都可以留給我。這裡完全不公開，只有我看得到，會作為之後提案的參考。
  </p>

  <form id="suggestion-form" class="grid gap-3 max-w-lg">
    <textarea
      name="message"
      placeholder="想說的建議..."
      required
      maxlength="1000"
      rows="4"
      class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light resize-none"
    ></textarea>
    {collectSchool && (
      <div class="grid grid-cols-2 gap-3">
        <input
          type="text"
          name="school"
          placeholder="學校（選填）"
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
        <input
          type="text"
          name="grade"
          placeholder="年級（選填）"
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
      </div>
    )}
    <button
      type="submit"
      data-magnetic
      class="justify-self-start px-6 py-2.5 bg-ink text-cream text-sm font-semibold hover:bg-clay transition-colors disabled:opacity-50"
    >
      送出意見
    </button>
    <p id="suggestion-status" class="text-sm min-h-5"></p>
  </form>
</div>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('suggestion-form') as HTMLFormElement | null;
  const status = document.getElementById('suggestion-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const formData = new FormData(form);
    const message = String(formData.get('message') ?? '').trim();
    const school = String(formData.get('school') ?? '').trim();
    const grade = String(formData.get('grade') ?? '').trim();
    if (!message) return;

    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = '送出中...';

    const { error } = await supabase.from('student_suggestions').insert({
      message,
      school: school || null,
      grade: grade || null,
    });

    if (error) {
      if (status) status.textContent = '送出失敗，請稍後再試一次。';
    } else {
      if (status) status.textContent = '已送出，謝謝你的意見！';
      form.reset();
    }
    if (submitBtn) submitBtn.disabled = false;
  });
</script>
