---
import { supabase } from '../lib/supabase';

const { data: settings } = await supabase
  .from('app_settings')
  .select('*')
  .in('key', ['suggestion_box_collect_school', 'suggestion_box_collect_contact']);

const collectSchool = settings?.find((s) => s.key === 'suggestion_box_collect_school')?.value === 'true';
const collectContact = settings?.find((s) => s.key === 'suggestion_box_collect_contact')?.value === 'true';
---

<div class="reveal bg-clay-light border-2 border-ink p-8">
  <p class="inline-block bg-ink text-cream text-xs font-semibold px-2.5 py-1 mb-4">學生意見箱</p>
  <h2 class="font-display text-2xl text-ink mb-2">有校園權益的想法嗎？</h2>
  <p class="text-ink-light mb-6">
    不管是通學安全、獎懲制度，還是其他想讓學校變更好的建議，都可以留給我。這裡完全不公開，只有我看得到，會作為之後提案的參考。
  </p>

  <form id="suggestion-form" class="grid gap-3 max-w-lg">
    <textarea
      id="suggestion-message"
      name="message"
      placeholder="想說的建議..."
      aria-label="想說的建議"
      required
      maxlength="1000"
      rows="4"
      class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light resize-none"
    ></textarea>
    {collectSchool && (
      <div class="grid grid-cols-2 gap-3">
        <input
          type="text"
          id="suggestion-school"
          name="school"
          placeholder="學校（選填）"
          aria-label="學校"
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
        <input
          type="text"
          id="suggestion-grade"
          name="grade"
          placeholder="年級（選填）"
          aria-label="年級"
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
      </div>
    )}
    {collectContact && (
      <div class="grid grid-cols-2 gap-3">
        <input
          type="text"
          id="suggestion-contact-name"
          name="contact_name"
          placeholder="姓名（選填）"
          aria-label="姓名"
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
        <input
          type="email"
          id="suggestion-contact-email"
          name="contact_email"
          placeholder="Email（必填，方便我回覆你）"
          aria-label="Email，方便我回覆你"
          required
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
      </div>
    )}

    <div class="grid gap-2 bg-cream border-2 border-ink p-3">
      <label for="suggestion-files" class="text-xs font-semibold text-ink-light">附件（選填，照片、影片、錄音、PDF、Word、Excel 等，最多 5 個檔案，可以分次選取）</label>
      <div id="suggestion-staged-list" class="flex flex-wrap gap-2"></div>
      <input
        type="file"
        id="suggestion-files"
        name="files"
        multiple
        accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx"
        aria-label="上傳附件"
        class="text-sm max-w-full"
      />
      <p id="suggestion-file-status" class="text-xs text-ink-light min-h-4"></p>
    </div>

    <button
      type="submit"
      data-magnetic
      class="justify-self-start px-6 py-2.5 bg-ink text-cream text-sm font-semibold hover:bg-clay transition-colors disabled:opacity-50"
    >
      送出意見
    </button>
    <p id="suggestion-status" class="text-sm min-h-5"></p>
  </form>
</div>

<script>
  import { supabase } from '../lib/supabase';

  const MAX_FILES = 5;
  const MAX_FILE_BYTES = 25 * 1024 * 1024;

  // Supabase Storage object keys only accept ASCII, so the original filename
  // (which is often in Chinese) can't be part of the storage path — keep the
  // path to a UUID + a safe extension, and use the real filename separately
  // wherever it needs to be shown to a person.
  function safeExt(name: string): string {
    const match = name.match(/\.([a-zA-Z0-9]{1,10})$/);
    return match ? `.${match[1].toLowerCase()}` : '';
  }

  const form = document.getElementById('suggestion-form') as HTMLFormElement | null;
  const status = document.getElementById('suggestion-status');
  const filesInput = document.getElementById('suggestion-files') as HTMLInputElement | null;
  const fileStatus = document.getElementById('suggestion-file-status');
  const stagedList = document.getElementById('suggestion-staged-list');

  let stagedFiles: File[] = [];

  function renderStagedFiles() {
    if (!stagedList) return;
    stagedList.innerHTML = '';
    stagedFiles.forEach((file, i) => {
      const chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1.5 border-2 border-ink px-2 py-1 text-xs';
      const nameSpan = document.createElement('span');
      nameSpan.textContent = file.name;
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.textContent = '✕';
      removeBtn.className = 'text-clay font-bold hover:underline';
      removeBtn.addEventListener('click', () => {
        stagedFiles.splice(i, 1);
        renderStagedFiles();
      });
      chip.append(nameSpan, removeBtn);
      stagedList.appendChild(chip);
    });
  }

  filesInput?.addEventListener('change', () => {
    const newFiles = Array.from(filesInput.files ?? []);
    if (stagedFiles.length + newFiles.length > MAX_FILES) {
      if (fileStatus) fileStatus.textContent = `最多只能選 ${MAX_FILES} 個檔案。`;
    } else {
      stagedFiles.push(...newFiles);
      if (fileStatus) fileStatus.textContent = '';
    }
    filesInput.value = '';
    renderStagedFiles();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const formData = new FormData(form);
    const message = String(formData.get('message') ?? '').trim();
    const school = String(formData.get('school') ?? '').trim();
    const grade = String(formData.get('grade') ?? '').trim();
    const contactName = String(formData.get('contact_name') ?? '').trim();
    const contactEmail = String(formData.get('contact_email') ?? '').trim();
    if (!message) return;

    const files = stagedFiles;
    if (files.some((f) => f.size > MAX_FILE_BYTES)) {
      if (status) status.textContent = '有檔案超過 25MB，請壓縮後再上傳。';
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = '送出中...';

    if (fileStatus && files.length) fileStatus.textContent = `上傳中：${files.length} 個檔案...`;
    const uploadResults = await Promise.all(
      files.map((file) => {
        const path = `${crypto.randomUUID()}${safeExt(file.name)}`;
        return supabase.storage
          .from('suggestion-files')
          .upload(path, file)
          .then(({ error }) => ({ path, error }));
      })
    );
    const failed = uploadResults.find((r) => r.error);
    if (failed) {
      if (status) status.textContent = `檔案上傳失敗：${failed.error!.message}`;
      if (submitBtn) submitBtn.disabled = false;
      return;
    }
    const attachmentPaths = uploadResults.map((r) => r.path);
    if (fileStatus) fileStatus.textContent = '';

    const { data: caseNumber, error } = await supabase.rpc('submit_suggestion', {
      p_message: message,
      p_school: school || null,
      p_grade: grade || null,
      p_contact_name: contactName || null,
      p_contact_email: contactEmail || null,
      p_attachment_paths: attachmentPaths.length ? attachmentPaths : null,
    });

    if (error) {
      if (status) status.textContent = '送出失敗，請稍後再試一次。';
    } else {
      if (status) status.textContent = `已送出，謝謝你的意見！你的案件編號是 ${caseNumber}，請留存以便之後查詢${contactEmail ? '（也會寄一封確認信到你的信箱）' : ''}。`;
      form.reset();
      stagedFiles = [];
      renderStagedFiles();
    }
    if (submitBtn) submitBtn.disabled = false;
  });
</script>
