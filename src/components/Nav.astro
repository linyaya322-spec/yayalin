---
const links = [
  { href: '/', label: '首頁' },
  { href: '/about', label: '關於我' },
  { href: '/committee', label: '兒少委員專區' },
  { href: '/blog', label: '部落格' },
  { href: '/contact', label: '聯絡' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur bg-cream/80 border-b border-sage-light">
  <nav class="max-w-4xl mx-auto flex items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-xl text-ink tracking-wide">Yaya <span class="text-sage-dark">林</span></a>
    <button
      id="nav-toggle"
      class="sm:hidden text-ink"
      aria-label="開啟選單"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
    <ul id="nav-links" class="hidden sm:flex gap-6 text-sm text-ink-light">
      {links.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                'transition-colors hover:text-sage-dark',
                isActive ? 'text-sage-dark font-medium' : '',
              ]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
  <ul id="nav-links-mobile" class="sm:hidden hidden flex-col gap-1 px-6 pb-4 text-ink-light">
    {links.map((link) => (
      <li>
        <a href={link.href} class="block py-2 hover:text-sage-dark">{link.label}</a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('nav-links-mobile');
  toggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('flex');
    toggle.setAttribute('aria-expanded', String(isHidden));
  });
</script>
