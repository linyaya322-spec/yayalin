---
const links = [
  { href: '/', label: '首頁' },
  { href: '/about', label: '關於我' },
  { href: '/committee', label: '兒少委員專區' },
  { href: '/blog', label: '部落格' },
  { href: '/contact', label: '聯絡' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-[#fffdf5] border-b-2 border-ink">
  <nav class="max-w-5xl mx-auto flex items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2 group" data-magnetic>
      <span class="w-9 h-9 rounded-xl border-2 border-ink bg-clay flex items-center justify-center font-display font-semibold text-cream text-lg group-hover:bg-ink transition-colors">Y</span>
      <span class="font-display text-xl text-ink tracking-wide">yaya 林</span>
    </a>
    <button
      id="nav-toggle"
      class="nav-ribbon sm:hidden text-ink"
      aria-label="開啟選單"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 -mt-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
    <ul id="nav-links" class="hidden sm:flex gap-1 text-sm">
      {links.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              data-magnetic
              class:list={[
                'inline-block px-4 py-1.5 rounded-full font-medium transition-colors',
                isActive ? 'bg-butter border-2 border-ink' : 'border-2 border-transparent text-ink hover:bg-clay-light',
              ]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
  <ul id="nav-links-mobile" class="sm:hidden hidden flex-col gap-1 px-6 pb-4">
    {links.map((link) => (
      <li>
        <a href={link.href} class="block py-2 px-3 rounded-xl font-medium text-ink hover:bg-clay-light">{link.label}</a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('nav-links-mobile');
  toggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('flex');
    toggle.setAttribute('aria-expanded', String(isHidden));
  });
</script>

<style>
  .nav-ribbon {
    width: 2.6rem;
    height: 3.2rem;
    display: grid;
    place-items: center;
    background: var(--color-clay-light);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
    margin-top: -1rem;
    padding-top: 1rem;
    border-bottom: 0;
  }
</style>
