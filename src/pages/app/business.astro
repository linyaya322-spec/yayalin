---
import AppDoc from '../../components/AppDoc.astro';
---

<AppDoc title="商家後台" description="TransitGo 商家後台：登入一次，管理你認領的地標營業時間、電話與營業狀態，不用安裝 App。">
<h1>商家後台</h1>
<p class="meta">用信箱登入一次，就能認領你的店家、管理營業時間／電話／營業狀態——之後回來不用再重新驗證。</p>

<div id="login-view">
  <div class="card">
    <input type="email" id="login-email" placeholder="你的 Email" class="field" />
    <button id="login-send" class="btn primary">寄送驗證碼</button>
    <div id="login-code-row" class="hidden">
      <input type="text" id="login-code" placeholder="信箱收到的 6 位數驗證碼" class="field" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
      <button id="login-verify" class="btn primary">驗證並登入</button>
    </div>
    <p id="login-status" class="hint"></p>
  </div>
</div>

<div id="business-view" class="hidden">
  <div class="row-between">
    <p class="hint">已登入：<span id="whoami"></span></p>
    <button id="logout-btn" class="btn">登出</button>
  </div>

  <h2>我認領的店家</h2>
  <ul id="mine-list" class="list"></ul>
  <p id="mine-empty" class="hidden hint">還沒有認領任何地標。</p>

  <h2>認領一個地標</h2>
  <p>搜尋地標名稱（要先在 App 裡被使用者新增過、且已經通過後台審核，才搜尋得到）。</p>
  <div class="card">
    <input type="text" id="search-q" placeholder="地標名稱，至少 2 個字" class="field" />
    <button id="search-btn" class="btn">搜尋</button>
    <ul id="search-list" class="list"></ul>
    <p id="search-empty" class="hidden hint">查不到符合的地標，或都已經被認領了。</p>
  </div>
</div>

<template id="claim-template">
  <li class="item">
    <p class="item-name"></p>
    <p class="item-meta"></p>
    <div class="claim-form hidden">
      <input type="text" class="claim-hours field" placeholder="營業時間，例如：週一至週日 11:00–21:00" />
      <input type="text" class="claim-phone field" placeholder="電話" />
      <p class="claim-status hint"></p>
      <button class="claim-submit btn primary">認領這個地標</button>
    </div>
    <button class="claim-toggle btn">認領這裡</button>
  </li>
</template>

<template id="mine-template">
  <li class="item">
    <p class="item-name"></p>
    <p class="item-meta"></p>
    <p class="item-link hint"></p>
    <div class="edit-form hidden">
      <label class="hint">營業狀態</label>
      <select class="edit-status field">
        <option value="open">營業中</option>
        <option value="temporarily_closed">暫停營業</option>
        <option value="permanently_closed">已停業</option>
      </select>
      <input type="text" class="edit-hours field" placeholder="營業時間" />
      <input type="text" class="edit-phone field" placeholder="電話" />
      <p class="edit-status-msg hint"></p>
      <button class="edit-submit btn primary">儲存</button>
    </div>
    <button class="edit-toggle btn">編輯</button>
  </li>
</template>

<h2>需要幫忙</h2>
<p>信箱收不到登入連結、或這個地標還沒被任何人新增過，寄信到 <a href="mailto:app&#64;yayalin.com">app&#64;yayalin.com</a>。</p>
</AppDoc>

<style>
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 1.1rem 1.2rem; margin: 1rem 0; }
  .field {
    display: block; width: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.6rem 0.75rem; color: var(--text); font: inherit; margin: 0.5rem 0;
  }
  .field:focus { outline: none; border-color: var(--accent); }
  .row-between { display: flex; align-items: center; justify-content: space-between; margin: 1rem 0; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; border-radius: 10px;
    padding: 0.55rem 1rem; font-weight: 700; font-size: 0.88rem; border: 1px solid var(--line);
    background: var(--bg); color: var(--text); cursor: pointer;
  }
  .btn:disabled { opacity: 0.5; cursor: default; }
  .btn.primary { background: var(--accent); color: #fff; border-color: transparent; }
  .hint { font-size: 0.82rem; color: var(--muted); margin: 0.3rem 0; }
  .hidden { display: none; }
  .list { list-style: none; padding: 0; margin: 0.8rem 0; display: grid; gap: 0.7rem; }
  .item { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 0.9rem 1rem; }
  .item-name { font-weight: 700; color: var(--text); margin: 0; }
  .item-meta { font-size: 0.85rem; color: var(--muted); margin: 0.2rem 0 0.6rem; }
  .claim-form, .edit-form { display: grid; gap: 0.4rem; margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed var(--line); }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const API = '/app/api/business';
  // Every call site in this file passes a bare element id ("login-send"), meaning
  // "#login-send" — but querySelector treats an unprefixed string as a TAG name, so it was
  // silently matching nothing and returning null for every one of them. That made the very
  // first `$(...).addEventListener(...)` below throw (can't read addEventListener of null),
  // which killed the whole script before it ever reached renderForSession() or wired up a
  // single button — nothing on this page worked, not just "send verification email".
  // Prepending "#" only when the caller hasn't already supplied a real selector (the couple
  // of `$('#mine-template')`-style calls already work either way) fixes every call site at
  // once instead of touching them all individually.
  const $ = (sel: string, root: ParentNode = document) =>
    root.querySelector(/^[#.[]/.test(sel) ? sel : `#${sel}`) as HTMLElement;

  async function authedFetch(path: string, opts: RequestInit = {}) {
    const { data } = await supabase.auth.getSession();
    const token = data.session?.access_token;
    if (!token) return { ok: false, status: 401, data: null };
    const res = await fetch(API + path, { ...opts, headers: { ...(opts.headers || {}), authorization: `Bearer ${token}` } });
    return { ok: res.ok, status: res.status, data: await res.json().catch(() => null) };
  }

  /* ---------- 登入（Supabase Auth，六碼驗證碼；第一次使用會自動建立帳號）----------
     signInWithOtp 寄出的同一封信本來就含 6 位數 {{ .Token }}（跟點連結是同一支信、同一個
     Supabase Auth 寄信管道，只是不用等使用者去點連結、直接在這頁輸入碼）——用
     verifyOtp(email, token) 換成真正的 session，後面 authedFetch／封鎖商家帳號等既有機制
     完全不用改。 */
  const loginView = $('login-view');
  const businessView = $('business-view');
  const loginEmail = $('login-email') as HTMLInputElement;
  const loginStatus = $('login-status');
  const loginCodeRow = $('login-code-row');
  const loginCode = $('login-code') as HTMLInputElement;

  $('login-send').addEventListener('click', async () => {
    const email = loginEmail.value.trim();
    if (!email.includes('@')) { loginStatus.textContent = '請輸入正確的 Email。'; return; }
    (($('login-send') as HTMLButtonElement)).disabled = true;
    loginStatus.textContent = '寄送中…';
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { shouldCreateUser: true },
    });
    (($('login-send') as HTMLButtonElement)).disabled = false;
    if (error) {
      loginStatus.textContent = '寄送失敗，請確認 Email 是否正確。';
      return;
    }
    loginStatus.textContent = `驗證碼已寄到 ${email}，請輸入信裡的 6 位數字（10 分鐘內有效，可能在垃圾信件夾）。`;
    loginCodeRow.classList.remove('hidden');
    loginCode.value = '';
    loginCode.focus();
  });

  // 換信箱重寄一次就等於放棄剛剛那組碼——把輸入框跟碼列隱藏掉，逼使用者重新走一次寄送。
  loginEmail.addEventListener('input', () => {
    loginCodeRow.classList.add('hidden');
    loginCode.value = '';
  });

  $('login-verify').addEventListener('click', async () => {
    const email = loginEmail.value.trim();
    const token = loginCode.value.trim();
    if (token.length !== 6) { loginStatus.textContent = '請輸入 6 位數驗證碼。'; return; }
    (($('login-verify') as HTMLButtonElement)).disabled = true;
    loginStatus.textContent = '驗證中…';
    const { error } = await supabase.auth.verifyOtp({ email, token, type: 'email' });
    (($('login-verify') as HTMLButtonElement)).disabled = false;
    if (error) {
      loginStatus.textContent = '驗證碼不正確或已過期，請重新寄送。';
      return;
    }
    loginStatus.textContent = '';
    renderForSession();
  });
  $('logout-btn').addEventListener('click', async () => { await supabase.auth.signOut(); });

  async function renderForSession() {
    const { data } = await supabase.auth.getSession();
    if (data.session?.user.email) {
      loginView.classList.add('hidden');
      businessView.classList.remove('hidden');
      ($('whoami') as HTMLElement).textContent = data.session.user.email;
      loadMine();
    } else {
      loginView.classList.remove('hidden');
      businessView.classList.add('hidden');
      loginCodeRow.classList.add('hidden');
      loginCode.value = '';
    }
  }
  supabase.auth.onAuthStateChange(() => renderForSession());
  renderForSession();

  /* ---------- 我認領的店家 ---------- */
  const mineTemplate = $('#mine-template') as HTMLTemplateElement;
  const mineList = $('mine-list');
  const mineEmpty = $('mine-empty');

  interface MyLandmark {
    id: number; name: string; category: string; businessHours: string | null; phone: string | null;
    businessStatus: 'open' | 'temporarily_closed' | 'permanently_closed'; approved: boolean;
  }
  const STATUS_LABEL: Record<string, string> = { open: '營業中', temporarily_closed: '暫停營業', permanently_closed: '已停業' };

  function renderMine(landmarks: MyLandmark[]) {
    mineList.innerHTML = '';
    if (landmarks.length === 0) { mineEmpty.classList.remove('hidden'); return; }
    mineEmpty.classList.add('hidden');
    for (const l of landmarks) {
      const node = mineTemplate.content.cloneNode(true) as DocumentFragment;
      const li = node.querySelector('.item')!;
      (li.querySelector('.item-name') as HTMLElement).textContent = l.name;
      (li.querySelector('.item-meta') as HTMLElement).textContent =
        `${l.approved ? '已上架' : '待後台審核'} · ${STATUS_LABEL[l.businessStatus] ?? l.businessStatus}`;
      const linkEl = li.querySelector('.item-link') as HTMLElement;
      if (l.approved) {
        const url = `${location.origin}/shop/${l.id}`;
        linkEl.innerHTML = `商家頁面：<a href="${url}" target="_blank" rel="noopener">${url}</a>`;
      } else {
        linkEl.textContent = '商家頁面要等後台審核通過才會生效。';
      }
      const toggle = li.querySelector('.edit-toggle') as HTMLButtonElement;
      const form = li.querySelector('.edit-form') as HTMLElement;
      const statusSel = li.querySelector('.edit-status') as HTMLSelectElement;
      const hoursInput = li.querySelector('.edit-hours') as HTMLInputElement;
      const phoneInput = li.querySelector('.edit-phone') as HTMLInputElement;
      const statusMsg = li.querySelector('.edit-status-msg') as HTMLElement;
      const submitBtn = li.querySelector('.edit-submit') as HTMLButtonElement;
      statusSel.value = l.businessStatus;
      hoursInput.value = l.businessHours ?? '';
      phoneInput.value = l.phone ?? '';
      toggle.addEventListener('click', () => form.classList.toggle('hidden'));
      submitBtn.addEventListener('click', async () => {
        submitBtn.disabled = true;
        statusMsg.textContent = '儲存中…';
        const { ok, data } = await authedFetch(`/landmarks/${l.id}`, {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ businessHours: hoursInput.value, phone: phoneInput.value, businessStatus: statusSel.value }),
        });
        submitBtn.disabled = false;
        if (ok) {
          statusMsg.textContent = '已儲存。';
          (li.querySelector('.item-meta') as HTMLElement).textContent =
            `${l.approved ? '已上架' : '待後台審核'} · ${STATUS_LABEL[statusSel.value] ?? statusSel.value}`;
        } else {
          statusMsg.textContent = data?.error === 'unauthorized' ? '登入已過期，請重新整理頁面登入。' : '儲存失敗，請稍後再試。';
        }
      });
      mineList.appendChild(node);
    }
  }

  async function loadMine() {
    const { ok, data } = await authedFetch('/mine', { method: 'POST' });
    if (ok) renderMine(data?.landmarks ?? []);
  }

  /* ---------- 認領一個地標 ---------- */
  const searchInput = $('search-q') as HTMLInputElement;
  const searchBtn = $('search-btn') as HTMLButtonElement;
  const searchList = $('search-list');
  const searchEmpty = $('search-empty');
  const claimTemplate = $('claim-template') as HTMLTemplateElement;

  interface SearchResult { id: number; name: string; category: string; isBusinessClaim: boolean; businessVerified: boolean }

  searchBtn.addEventListener('click', async () => {
    const q = searchInput.value.trim();
    if (q.length < 2) return;
    searchBtn.disabled = true;
    const res = await fetch(`${API}/search?q=${encodeURIComponent(q)}`);
    searchBtn.disabled = false;
    const data = res.ok ? await res.json() : { landmarks: [] };
    const results: SearchResult[] = data.landmarks ?? [];
    searchList.innerHTML = '';
    if (results.length === 0) { searchEmpty.classList.remove('hidden'); return; }
    searchEmpty.classList.add('hidden');
    for (const r of results) {
      const node = claimTemplate.content.cloneNode(true) as DocumentFragment;
      const li = node.querySelector('.item')!;
      (li.querySelector('.item-name') as HTMLElement).textContent = r.name;
      (li.querySelector('.item-meta') as HTMLElement).textContent = r.businessVerified ? '已經有人認領了' : '還沒有店家認領';
      const toggle = li.querySelector('.claim-toggle') as HTMLButtonElement;
      const form = li.querySelector('.claim-form') as HTMLElement;
      if (r.businessVerified) {
        toggle.disabled = true;
        toggle.textContent = '已被認領';
      } else {
        toggle.addEventListener('click', () => form.classList.toggle('hidden'));
      }
      const hoursInput = li.querySelector('.claim-hours') as HTMLInputElement;
      const phoneInput = li.querySelector('.claim-phone') as HTMLInputElement;
      const statusMsg = li.querySelector('.claim-status') as HTMLElement;
      const submitBtn = li.querySelector('.claim-submit') as HTMLButtonElement;
      submitBtn.addEventListener('click', async () => {
        submitBtn.disabled = true;
        statusMsg.textContent = '送出中…';
        const { ok, data: claimData } = await authedFetch(`/landmarks/${r.id}/claim`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ businessHours: hoursInput.value, phone: phoneInput.value }),
        });
        if (ok) {
          statusMsg.textContent = '認領成功！在上面「我認領的店家」就能看到與管理。';
          toggle.disabled = true;
          toggle.textContent = '已認領';
          loadMine();
        } else {
          statusMsg.textContent = claimData?.error === 'unauthorized' ? '登入已過期，請重新整理頁面登入。' : '認領失敗（可能剛好被別人搶先認領），請重新整理再試。';
          submitBtn.disabled = false;
        }
      });
      searchList.appendChild(node);
    }
  });
</script>
