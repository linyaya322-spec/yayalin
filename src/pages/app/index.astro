---
import AppDoc from '../../components/AppDoc.astro';
import Icon from '../../components/Icon.astro';
import { APP_NAME, APP_STATUS_URL } from '../../lib/app';

const features: { icon: Parameters<typeof Icon>[0]['name']; title: string; body: string }[] = [
  { icon: 'pin', title: '附近', body: '公車站牌與到站時間、YouBike 可借還、測速與科技執法照相位置，一次顯示在地圖上。' },
  { icon: 'route', title: '路線規劃', body: '步行、公車、捷運、台鐵、高鐵、YouBike 自由組合，算出實際能搭到的路線。' },
  { icon: 'compass', title: '導航', body: '開車、騎機車（避開國道）、步行皆可；語音提示、測速與科技執法照相提醒。' },
  { icon: 'link', title: '行程分享', body: '產生一個連結，親友不用裝 App 就能看班次狀態與台鐵列車最後回報的位置（不含你的位置）。' },
  { icon: 'widget', title: '小工具與 Siri', body: '選一個台鐵車站，小工具同時看北上、南下所有列車與終點站；也能對 Siri 說「用交通即時查導航」。' },
  { icon: 'camera', title: '誠實的資料', body: '資料全部來自政府與營運單位的開放資料，查不到就直接說「查不到」，絕不編造。' },
];
---

<AppDoc title="TransitGo App" description="交通即時查 TransitGo：公車、台鐵、捷運、YouBike 即時資訊、導航與行程分享的 iPhone App。">
  <div class="hero">
    <h1>{APP_NAME}</h1>
    <p class="meta">公車・台鐵・捷運・YouBike 的即時資訊、導航與行程分享　·　iPhone / iPad　·　目前測試中</p>
    <p class="lead">
      把日常搭車會用到的事放在同一個 App：查附近站牌與到站時間、規劃多種運具的路線、開車或騎車導航、把行程分享給親友，
      以及用小工具和 Siri 快速看台鐵車站的班次。
    </p>
    <a class="cta" href="/app/support">客服與意見回饋</a>
  </div>

  <h2 class="section-title">App 裡有什麼</h2>
  <div class="feature-grid">
    {features.map((f) => (
      <div class="feature-card">
        <div class="feature-icon" aria-hidden="true"><Icon name={f.icon} size={36} /></div>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </div>
    ))}
  </div>
  <p class="note-inline">高鐵目前沒有公開的即時車次位置資料，所以只提供班次時間與營運公告。</p>

  <h2 class="section-title">伺服器狀態</h2>
  <div class="note status-card" id="status-card" aria-live="polite">
    <span class="status-dot" id="status-dot" aria-hidden="true"></span>
    <div>
      <p style="margin:0;color:inherit;"><strong id="status-text">檢查中…</strong></p>
      <p id="status-detail" style="margin:0.3em 0 0;font-size:0.9rem;color:inherit;"></p>
    </div>
  </div>
  <p class="fine-print">
    服務目前由個人電腦提供，偶爾會離線或重新啟動；離線時 App 的即時功能會暫時查不到資料。這個狀態每分鐘自動更新。
  </p>

  <h2 class="section-title">需要幫忙或想說些什麼</h2>
  <p>
    <a class="cta" href="/app/support">前往客服與線上意見回饋</a>
  </p>
  <ul class="link-list">
    <li><a href="/app/business">商家後台（認領你的店家）</a></li>
    <li><a href="/app/privacy">隱私權政策</a></li>
    <li><a href="/app/terms">服務條款</a></li>
    <li>信箱：<a href="mailto:app&#64;yayalin.com">app&#64;yayalin.com</a></li>
  </ul>
</AppDoc>

<style>
  .hero {
    padding-bottom: 0.4rem;
  }
  .hero .lead {
    max-width: 42em;
  }
  .section-title {
    display: inline-block;
    position: relative;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.1rem;
    margin: 1.3rem 0 1.4rem;
  }
  .feature-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.4rem 1.3rem 1.5rem;
    transition: transform .18s, box-shadow .18s, border-color .18s;
  }
  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 16px 32px -18px rgba(10, 108, 240, 0.35);
  }
  .feature-card:nth-child(even):hover {
    border-color: var(--accent2);
    box-shadow: 0 16px 32px -18px rgba(15, 184, 138, 0.35);
  }
  .feature-icon {
    color: var(--accent);
    background: linear-gradient(150deg, var(--accent-soft), transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    margin-bottom: 0.9rem;
  }
  /* Alternating blue/green, like the app icon's own gradient. */
  .feature-card:nth-child(even) .feature-icon {
    color: var(--accent2);
    background: linear-gradient(150deg, var(--accent2-soft), transparent);
  }
  .feature-card h3 {
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
  }
  .feature-card p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }
  .note-inline {
    font-size: 0.9rem;
  }
  .status-card {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }
  .status-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 0.35rem;
    background: var(--muted);
  }
  .status-dot.up { background: var(--accent2); }
  .status-dot.down { background: #d6483a; }
  .fine-print {
    font-size: 0.85rem;
  }
  .link-list {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 0.6rem;
  }
</style>

<script is:inline define:vars={{ statusUrl: APP_STATUS_URL }}>
  // Reads the backend's tiny public status (only "up / route planner ready / uptime"). A failure is shown as
  // "can't reach", never as a guess.
  const text = document.getElementById('status-text');
  const detail = document.getElementById('status-detail');
  const dot = document.getElementById('status-dot');

  function uptime(seconds) {
    if (seconds < 90) return '剛啟動';
    if (seconds < 5400) return `已連續運作約 ${Math.round(seconds / 60)} 分鐘`;
    if (seconds < 172800) return `已連續運作約 ${Math.round(seconds / 3600)} 小時`;
    return `已連續運作約 ${Math.round(seconds / 86400)} 天`;
  }

  async function check() {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 8000);
    const at = new Date().toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false });
    try {
      const res = await fetch(statusUrl, { cache: 'no-store', signal: controller.signal });
      const s = await res.json();
      if (!res.ok || s.ok !== true) throw new Error('bad status');
      text.textContent = s.routing === 'ready' ? '運作中' : '啟動中（路線規劃準備中）';
      detail.textContent = `${uptime(s.uptimeSeconds)} · 檢查時間 ${at}`;
      dot.className = 'status-dot up';
    } catch {
      text.textContent = '目前無法連線';
      detail.textContent = `伺服器可能正在重新啟動或暫時離線 · 檢查時間 ${at}`;
      dot.className = 'status-dot down';
    } finally {
      clearTimeout(timer);
    }
  }

  check();
  setInterval(check, 60000);
</script>
