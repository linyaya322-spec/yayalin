---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="聯絡" description="與 yaya 聯絡的方式：聯絡表單。">
  <section class="relative max-w-2xl mx-auto px-6 pt-16 pb-8">
    <div class="ct-deco ct-mouth" aria-hidden="true"><Icon name="mouth" size={88} /></div>
    <div class="ct-deco ct-bubble" aria-hidden="true"><Icon name="bubble" size={80} /></div>
    <p class="reveal inline-block bg-butter border-2 border-ink text-ink text-sm font-bold px-4 py-1 mb-6 -rotate-2 shadow-[2px_2px_0_var(--color-ink)]">聯絡我</p>
    <h1 class="font-display font-bold text-4xl sm:text-5xl text-ink mb-4">
      歡迎跟我<span class="marker px-1">說說話</span>
    </h1>
    <p class="reveal text-ink-light text-lg" style="animation-delay: 0.2s;">
      不管是想聊聊興趣、討論兒少議題，還是有任何想法想跟我分享，都歡迎透過下面的表單找我。
    </p>
  </section>

  <section class="max-w-2xl mx-auto px-6 pb-24">
    <p class="reveal inline-block bg-ink text-cream text-sm font-bold px-4 py-1 mb-8 rotate-1">或直接寫訊息給我</p>
    <ContactForm />
  </section>
</BaseLayout>

<style>
  .ct-deco {
    position: absolute;
    color: var(--color-ink);
    pointer-events: none;
    display: none;
  }
  .ct-deco :global(svg) {
    background: var(--color-butter-light);
    border-radius: 50%;
    padding: 0.7rem;
  }
  .ct-mouth { top: 2rem; right: 5rem; transform: rotate(8deg); }
  .ct-bubble { top: 6.5rem; right: 0.5rem; transform: rotate(-8deg); }
  @media (min-width: 640px) {
    .ct-deco { display: block; }
  }
</style>
