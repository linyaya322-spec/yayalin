---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import type { BlogPost } from '../../lib/supabase';
import { marked } from 'marked';

export async function getStaticPaths() {
  const { data: posts } = await supabase.from('blog_posts').select('*');
  return (posts ?? []).map((post) => ({
    params: { id: post.id },
    props: { post: post as BlogPost },
  }));
}

const { post } = Astro.props;

const categoryColor: Record<string, string> = {
  生活隨筆: 'bg-sage',
  兒少議題: 'bg-clay',
  興趣分享: 'bg-butter',
  茶葉蛋: 'bg-ink',
};

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });

const bodyHtml = await marked.parse(post.body);
---

<BaseLayout title={post.title} description={post.excerpt}>
  <article class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <a href="/blog" data-magnetic class="reveal inline-block text-sm font-semibold text-clay hover:text-ink transition-colors">← 回部落格列表</a>

    <div class="reveal flex items-center gap-3 mt-6 mb-4" style="animation-delay: 0.05s;">
      <span class={`text-xs font-semibold text-cream px-3 py-1 ${categoryColor[post.category] ?? 'bg-ink'}`}>
        {post.category}
      </span>
      <time class="text-sm text-ink-light">{formatDate(post.date)}</time>
    </div>

    <h1 class="font-display text-3xl sm:text-4xl text-ink mb-8">
      <span data-text-reveal>{post.title}</span>
    </h1>

    {post.cover_image && (
      <img src={post.cover_image} alt="" class="reveal w-full max-h-96 object-cover border-2 border-ink mb-8" style="animation-delay: 0.15s;" />
    )}

    <div class="reveal prose-blog" style="animation-delay: 0.2s;" set:html={bodyHtml} />

    {post.tags && post.tags.length > 0 && (
      <div class="reveal flex flex-wrap gap-2 mt-8">
        {post.tags.map((tag) => (
          <a
            href={`/blog?tag=${encodeURIComponent(tag)}`}
            data-magnetic
            class="text-sm text-ink-light border border-ink/30 px-3 py-1 hover:bg-ink hover:text-cream hover:border-ink transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .prose-blog :global(p) {
    color: var(--color-ink-light);
    line-height: 1.9;
    margin-bottom: 1.25em;
    font-size: 1.05rem;
  }
  .prose-blog :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
    color: var(--color-ink-light);
    margin-bottom: 1.25em;
  }
  .prose-blog :global(li) {
    margin-bottom: 0.5em;
  }
  .prose-blog :global(strong) {
    color: var(--color-ink);
  }
  .prose-blog :global(a) {
    color: var(--color-clay);
    font-weight: 600;
    text-decoration: underline;
  }
  .prose-blog :global(img) {
    max-width: 100%;
    height: auto;
    border: 2px solid var(--color-ink);
    margin: 1.5em 0;
  }
</style>
