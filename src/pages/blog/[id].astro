---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import type { BlogPost } from '../../lib/supabase';
import { marked } from 'marked';

export async function getStaticPaths() {
  const { data: posts } = await supabase.from('blog_posts').select('*');
  return (posts ?? []).map((post) => ({
    params: { id: post.id },
    props: { post: post as BlogPost },
  }));
}

const { post } = Astro.props;

const categoryColor: Record<string, string> = {
  生活隨筆: 'bg-sage',
  兒少議題: 'bg-clay',
  興趣分享: 'bg-butter',
  茶葉蛋: 'bg-ink',
};

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });

const bodyHtml = await marked.parse(post.body);
const description = post.seo_description?.trim() || post.excerpt?.trim() || `${post.title}｜yaya 林的${post.category}文章。`;
const articleKeywords = [...new Set([...(post.tags ?? []), ...(post.seo_keywords ?? [])])];
const articleUrl = new URL(`/blog/${post.id}`, Astro.site ?? 'https://yayalin.com').toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.title,
  description,
  datePublished: new Date(post.date).toISOString(),
  mainEntityOfPage: articleUrl,
  author: { '@id': 'https://yayalin.com/#person' },
  publisher: { '@id': 'https://yayalin.com/#person' },
  ...(post.cover_image ? { image: new URL(post.cover_image, Astro.site ?? 'https://yayalin.com').toString() } : {}),
  articleSection: post.category,
  ...(articleKeywords.length ? { keywords: articleKeywords } : {}),
};
---

<BaseLayout title={post.title} fullTitle={post.seo_title || undefined} description={description} keywords={articleKeywords} ogType="article" ogImage={post.cover_image ?? undefined} structuredData={articleJsonLd}>
  <article class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <a href="/blog" data-magnetic class="reveal inline-block text-sm font-semibold text-clay hover:text-ink transition-colors">← 回部落格列表</a>

    <div class="reveal flex items-center gap-3 mt-6 mb-4" style="animation-delay: 0.05s;">
      <span class={`text-xs font-semibold text-cream px-3 py-1 ${categoryColor[post.category] ?? 'bg-ink'}`}>
        {post.category}
      </span>
      <time class="text-sm text-ink-light" datetime={new Date(post.date).toISOString()}>{formatDate(post.date)}</time>
    </div>

    <h1 class="font-display text-3xl sm:text-4xl text-ink mb-8">
      <span data-text-reveal>{post.title}</span>
    </h1>

    <div class="share-actions reveal" aria-label="分享文章">
      <button type="button" class="share-button" data-share-article data-title={post.title} data-url={articleUrl}>
        分享文章
      </button>
      <button
        type="button"
        class="share-button share-button-secondary"
        data-share-story
        data-title={post.title}
        data-description={post.excerpt}
        data-category={post.category}
        data-url={articleUrl}
      >
        製作限動分享圖並分享
      </button>
      <p class="share-status" data-share-status role="status" aria-live="polite"></p>
      <p class="share-hint">會製作 9:16 限動圖片並開啟手機分享選單；若 Instagram 出現在選單，請選它並加入「連結」貼圖（文章網址會先複製）。若沒有 Instagram，圖片會下載到手機，再手動於限動上傳。</p>
    </div>

    {post.cover_image && (
      <img src={post.cover_image} alt={post.cover_image_alt || post.title} class="reveal w-full max-h-96 object-cover border-2 border-ink mb-8" style="animation-delay: 0.15s;" />
    )}

    <div class="reveal prose-blog" style="animation-delay: 0.2s;" set:html={bodyHtml} />

    {post.tags && post.tags.length > 0 && (
      <div class="reveal flex flex-wrap gap-2 mt-8">
        {post.tags.map((tag) => (
          <a
            href={`/blog?tag=${encodeURIComponent(tag)}`}
            data-magnetic
            class="text-sm text-ink-light border border-ink/30 px-3 py-1 hover:bg-ink hover:text-cream hover:border-ink transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </article>
</BaseLayout>

<script>
  const shareStatus = document.querySelector<HTMLElement>('[data-share-status]');

  // 等待 Noto Sans TC 字體就緒，確保 Canvas 能正確渲染中文字
  // （Noto Sans TC 依 Unicode range 分割成多個 woff2 區塊；用 document.fonts.load() 觸發載入）
  const fontsReady = Promise.all([
    document.fonts.load('400 28px "Noto Sans TC"', '生活兒少議題新竹在地文章yaya林'),
    document.fonts.load('500 28px "Noto Sans TC"', '生活兒少議題新竹在地文章yaya林'),
    document.fonts.load('700 28px "Noto Sans TC"', '生活兒少議題新竹在地文章yaya林'),
  ]).catch(() => null);

  function roundedRect(ctx: CanvasRenderingContext2D, x: number, y: number, width: number, height: number, radius: number) {
    ctx.beginPath();
    ctx.roundRect(x, y, width, height, radius);
  }

  function drawWrappedText(ctx: CanvasRenderingContext2D, text: string, x: number, y: number, maxWidth: number, lineHeight: number, maxLines: number) {
    const characters = [...text];
    let line = '';
    let lineCount = 0;
    for (const character of characters) {
      const candidate = line + character;
      if (ctx.measureText(candidate).width > maxWidth && line) {
        ctx.fillText(line, x, y + lineCount * lineHeight);
        line = character;
        lineCount += 1;
        if (lineCount >= maxLines) {
          let lastLine = line;
          while (ctx.measureText(`${lastLine}…`).width > maxWidth && lastLine.length > 1) lastLine = lastLine.slice(0, -1);
          ctx.fillText(`${lastLine}…`, x, y + (maxLines - 1) * lineHeight);
          return y + maxLines * lineHeight;
        }
      } else {
        line = candidate;
      }
    }
    if (line && lineCount < maxLines) {
      ctx.fillText(line, x, y + lineCount * lineHeight);
      lineCount += 1;
    }
    return y + lineCount * lineHeight;
  }

  async function createStoryImage(button: HTMLButtonElement): Promise<File> {
    // 等待字體就緒，確保 Canvas 能用 Noto Sans TC 渲染中文
    await fontsReady;

    const canvas = document.createElement('canvas');
    canvas.width = 1080;
    canvas.height = 1920;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('無法製作分享圖片');

    const background = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
    background.addColorStop(0, '#f7e9c9');
    background.addColorStop(1, '#e6f0e2');
    ctx.fillStyle = background;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // 裝飾圓
    ctx.fillStyle = 'rgba(255,255,255,0.38)';
    ctx.beginPath();
    ctx.arc(980, 180, 240, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#d9694b';
    ctx.beginPath();
    ctx.arc(80, 1560, 160, 0, Math.PI * 2);
    ctx.fill();

    // ── 頂部品牌列（小巧，不搶標題） ──
    ctx.fillStyle = '#18243a';
    ctx.font = '700 38px "Noto Sans TC", sans-serif';
    ctx.fillText('yaya 林', 92, 120);
    ctx.fillStyle = '#536075';
    ctx.font = '400 24px "Noto Sans TC", sans-serif';
    ctx.fillText('yayalin.com', 92, 160);

    // ── 主卡片 ──
    roundedRect(ctx, 72, 210, 936, 1480, 40);
    ctx.fillStyle = '#fffdf8';
    ctx.fill();
    ctx.strokeStyle = '#18243a';
    ctx.lineWidth = 5;
    ctx.stroke();

    // 分類標籤
    const category = button.dataset.category || '文章';
    roundedRect(ctx, 122, 268, 300, 64, 20);
    ctx.fillStyle = '#f3d16b';
    ctx.fill();
    ctx.fillStyle = '#18243a';
    ctx.font = '700 26px "Noto Sans TC", sans-serif';
    ctx.fillText(category, 148, 312, 250);

    // ── 標題（單一大標題）──
    ctx.fillStyle = '#18243a';
    ctx.font = '700 62px "Noto Sans TC", sans-serif';
    const titleBottom = drawWrappedText(ctx, button.dataset.title || document.title, 122, 490, 836, 96, 5);

    // 分隔線：讓下方區塊視覺上明確是「內容」而非第二個標題
    const dividerY = Math.min(titleBottom + 40, 1040);
    ctx.fillStyle = '#d9694b';
    ctx.fillRect(122, dividerY, 80, 6);

    // ── 內容（文章摘要）──
    const contentStartY = dividerY + 56;
    ctx.fillStyle = '#536075';
    ctx.font = '400 34px "Noto Sans TC", sans-serif';
    const excerpt = button.dataset.description?.trim() || '到 yaya 林的網站閱讀完整文章。';
    drawWrappedText(ctx, excerpt, 122, Math.min(contentStartY, 1120), 836, 58, 5);

    // ── 底部 CTA ──
    ctx.fillStyle = '#d9694b';
    ctx.font = '700 28px "Noto Sans TC", sans-serif';
    ctx.fillText('完整文章見限動「連結」貼圖', 122, 1580, 836);

    ctx.fillStyle = '#18243a';
    ctx.fillRect(122, 1620, 836, 4);
    ctx.font = '500 22px "Noto Sans TC", sans-serif';
    ctx.fillStyle = '#536075';
    ctx.fillText(new URL(button.dataset.url || window.location.href).pathname, 122, 1664, 836);

    const blob = await new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((result) => result ? resolve(result) : reject(new Error('圖片輸出失敗')), 'image/png');
    });
    return new File([blob], 'yaya-blog-story.png', { type: 'image/png' });
  }

  function downloadStoryImage(file: File) {
    const objectUrl = URL.createObjectURL(file);
    const link = document.createElement('a');
    link.href = objectUrl;
    link.download = file.name;
    document.body.append(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(objectUrl), 60_000);
  }

  const storyButton = document.querySelector<HTMLButtonElement>('[data-share-story]');
  let preparedStoryFile: File | null = null;
  const storyFileReady = storyButton
    ? createStoryImage(storyButton).then((file) => { preparedStoryFile = file; return file; }).catch(() => null)
    : Promise.resolve(null);

  async function copyShareUrl(url: string) {
    try {
      await navigator.clipboard.writeText(url);
      return true;
    } catch {
      const input = document.createElement('textarea');
      input.value = url;
      input.setAttribute('readonly', '');
      input.style.position = 'fixed';
      input.style.opacity = '0';
      document.body.append(input);
      input.select();
      const copied = document.execCommand('copy');
      input.remove();
      return copied;
    }
  }

  document.querySelector<HTMLButtonElement>('[data-share-article]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const url = button.dataset.url ?? window.location.href;
    const title = button.dataset.title ?? document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, text: title, url });
        if (shareStatus) shareStatus.textContent = '分享面板已開啟。';
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
      }
    }
    const copied = await copyShareUrl(url);
    if (shareStatus) shareStatus.textContent = copied ? '文章連結已複製，可以貼到社群或訊息。' : '無法自動複製，請手動複製網址列的連結。';
  });

  document.querySelector<HTMLButtonElement>('[data-share-story]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const url = button.dataset.url ?? window.location.href;
    const title = button.dataset.title ?? document.title;
    if (shareStatus) shareStatus.textContent = '正在製作限動圖片並準備分享…';
    const copiedPromise = copyShareUrl(url);
    const canShareStoryFile = (file: File | null): file is File =>
      !!file && !!navigator.share && !!navigator.canShare?.({ files: [file] });

    // Call Web Share directly in the click's user gesture; awaiting clipboard or image work first can make iOS reject it.
    if (canShareStoryFile(preparedStoryFile)) {
      try {
        const sharePromise = navigator.share({ files: [preparedStoryFile], title, text: `${title}\n${url}` });
        await sharePromise;
        const copied = await copiedPromise;
        if (shareStatus) shareStatus.textContent = copied
          ? '分享圖片已送到手機分享選單。選 Instagram／限時動態後，再加入「連結」貼圖；文章網址已複製。'
          : '分享圖片已送到手機分享選單。選 Instagram／限時動態後，再加入「連結」貼圖。';
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') {
          await copiedPromise;
          if (shareStatus) shareStatus.textContent = '分享已取消；可再次分享，或下載圖片後在 Instagram 限動上傳。';
          return;
        }
      }
    }

    if (!preparedStoryFile && navigator.share) {
      try {
        const sharePromise = navigator.share({ title, text: `${title}\n${url}`, url });
        await sharePromise;
        const copied = await copiedPromise;
        if (shareStatus) shareStatus.textContent = copied
          ? '分享選單已開啟，文章網址已複製。限動分享圖片仍在準備；若選 Instagram，請於限動加入「連結」貼圖。'
          : '分享選單已開啟。限動分享圖片仍在準備；請在 Instagram 限動加入「連結」貼圖。';
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') {
          await copiedPromise;
          return;
        }
      }
    }

    const file = preparedStoryFile ?? await storyFileReady;
    const copied = await copiedPromise;
    if (!file) {
      if (shareStatus) shareStatus.textContent = `限動圖片製作失敗。${copied ? '文章連結已複製，可在 Instagram 限動加入「連結」貼圖。' : '請手動複製文章網址。'}`;
      return;
    }
    downloadStoryImage(file);
    if (shareStatus) shareStatus.textContent = copied
      ? '此瀏覽器未能直接分享圖片，限動圖片已下載、文章網址已複製。請在 Instagram 限動上傳圖片並加入「連結」貼圖。'
      : '限動圖片已下載。請在 Instagram 限動上傳圖片並加入「連結」貼圖。';
  });
</script>

<style>
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin: -1rem 0 2rem;
  }
  .share-button {
    border: 2px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-cream);
    padding: 0.55rem 1rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, transform 0.15s;
  }
  .share-button:hover { background: var(--color-clay); border-color: var(--color-clay); transform: translateY(-2px); }
  .share-button-secondary { background: transparent; color: var(--color-ink); }
  .share-status, .share-hint { flex-basis: 100%; margin: 0; color: var(--color-ink-light); font-size: 0.85rem; }
  .share-hint { font-size: 0.78rem; }

  .prose-blog :global(p) {
    color: var(--color-ink-light);
    line-height: 1.9;
    margin-bottom: 1.25em;
    font-size: 1.05rem;
  }
  .prose-blog :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
    color: var(--color-ink-light);
    margin-bottom: 1.25em;
  }
  .prose-blog :global(li) {
    margin-bottom: 0.5em;
  }
  .prose-blog :global(strong) {
    color: var(--color-ink);
  }
  .prose-blog :global(a) {
    color: var(--color-clay);
    font-weight: 600;
    text-decoration: underline;
  }
  .prose-blog :global(img) {
    max-width: 100%;
    height: auto;
    border: 2px solid var(--color-ink);
    margin: 1.5em 0;
  }
</style>
