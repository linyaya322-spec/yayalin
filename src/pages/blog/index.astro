---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogFilters from '../../components/BlogFilters.astro';
import { supabase } from '../../lib/supabase';

const { data: posts } = await supabase
  .from('blog_posts')
  .select('*')
  .order('date', { ascending: false });
---

<BaseLayout title="部落格" description="生活隨筆、兒少議題與興趣分享。">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-8">
    <p class="reveal inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-6">部落格</p>
    <h1 class="font-display text-4xl sm:text-5xl text-ink mb-4"><span data-text-reveal>寫下來的一些事</span></h1>
    <p class="reveal text-ink-light text-lg" style="animation-delay: 0.2s;">生活隨筆、兒少議題、興趣分享，慢慢累積。</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-24">
    <BlogFilters posts={posts ?? []} />
    {!posts || posts.length === 0 ? (
      <p class="text-ink-light">還沒有文章，敬請期待。</p>
    ) : (
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
        {posts.map((post, i) => (
          <BlogCard post={post} index={i} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
