---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="部落格" description="生活隨筆、兒少議題與興趣分享。">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-8">
    <p class="reveal text-sage-dark font-medium mb-3">部落格</p>
    <h1 class="reveal font-display text-4xl text-ink mb-4" style="animation-delay: 0.1s;">寫下來的一些事</h1>
    <p class="reveal text-ink-light text-lg" style="animation-delay: 0.2s;">生活隨筆、兒少議題、興趣分享，慢慢累積。</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-24">
    <CategoryFilter />
    {posts.length === 0 ? (
      <p class="text-ink-light">還沒有文章，敬請期待。</p>
    ) : (
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
        {posts.map((post, i) => (
          <BlogCard post={post} index={i} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
