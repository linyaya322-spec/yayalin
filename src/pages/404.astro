---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面" description="找不到這個頁面。" noindex>
  <section class="max-w-3xl mx-auto px-6 pt-14 pb-10 text-center">
    <p class="reveal inline-flex items-center gap-2 bg-white/70 border border-ink/10 text-ink text-xs sm:text-sm font-medium px-4 py-1.5 rounded-full mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-clay" aria-hidden="true"></span>
      錯誤 404
    </p>
    <h1 class="font-display text-4xl sm:text-6xl text-ink tracking-tight mb-4">找不到這個頁面</h1>
    <p class="text-ink-light max-w-md mx-auto leading-relaxed">
      網址可能打錯了，或是這個頁面已經不在了。先玩一局貪吃蛇，再回首頁吧。
    </p>
  </section>

  <section class="px-6 pb-12">
    <div class="arcade mx-auto" id="arcade">
      <div class="bezel">
        <div class="screen">
          <canvas id="game" width="320" height="256" aria-label="貪吃蛇遊戲畫面"></canvas>
          <div id="overlay" class="overlay">
            <p class="big" id="overlay-title">404</p>
            <p class="small" id="overlay-text">按紅色按鈕開始玩貪吃蛇</p>
          </div>
        </div>
      </div>

      <div class="controls">
        <div class="dpad" role="group" aria-label="方向鍵">
          <button type="button" class="key up" data-dir="up" aria-label="上">W</button>
          <button type="button" class="key left" data-dir="left" aria-label="左">A</button>
          <button type="button" class="key right" data-dir="right" aria-label="右">D</button>
          <button type="button" class="key down" data-dir="down" aria-label="下">S</button>
        </div>
        <button type="button" id="action" class="action" aria-label="開始或重新開始"></button>
      </div>
      <p class="hint">電腦可用方向鍵或 WASD，空白鍵開始</p>
    </div>

    <div class="text-center mt-10">
      <a
        href="/"
        data-magnetic
        class="inline-block px-7 py-3 rounded-full bg-ink text-cream text-sm font-semibold hover:bg-clay transition-colors"
      >
        回到首頁
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .arcade {
    width: min(22rem, 100%);
    padding: 1.4rem 1.4rem 1.6rem;
    border-radius: 2.2rem;
    background: linear-gradient(160deg, #3a3b3f, #232427);
    box-shadow: 0 40px 70px -35px rgba(23, 23, 22, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  .bezel {
    background: #17181a;
    border-radius: 1.2rem 1.2rem 2.4rem 1.2rem;
    padding: 0.9rem;
  }
  .screen {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: 0.6rem;
    overflow: hidden;
    background: #0d1712;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.4rem;
    text-align: center;
    background: rgba(13, 23, 18, 0.88);
    color: #b6f2c6;
  }
  .overlay.hidden {
    display: none;
  }
  .overlay .big {
    font-family: var(--font-display);
    font-size: 3.6rem;
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .overlay .small {
    font-size: 0.8rem;
    color: #6fae85;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.6rem;
    padding: 0 0.4rem;
  }
  .dpad {
    display: grid;
    grid-template-columns: repeat(3, 2.9rem);
    grid-template-rows: repeat(3, 2.9rem);
    gap: 0.2rem;
  }
  .key {
    border: 0;
    border-radius: 0.7rem;
    background: linear-gradient(#3b3c40, #2b2c30);
    color: #9a9ca3;
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: 0 3px 0 #131416;
    cursor: pointer;
  }
  .key:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #131416;
  }
  .up { grid-column: 2; grid-row: 1; }
  .left { grid-column: 1; grid-row: 2; }
  .right { grid-column: 3; grid-row: 2; }
  .down { grid-column: 2; grid-row: 3; }
  .action {
    width: 4.2rem;
    height: 3.1rem;
    border: 0;
    border-radius: 1rem;
    background: linear-gradient(#f0604f, #d63f30);
    box-shadow: 0 5px 0 #8f2a20;
    cursor: pointer;
  }
  .action:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #8f2a20;
  }
  .hint {
    margin-top: 1.2rem;
    text-align: center;
    font-size: 0.7rem;
    color: #777a82;
  }
</style>

<script>
  const canvas = document.getElementById('game') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const overlay = document.getElementById('overlay')!;
  const overlayTitle = document.getElementById('overlay-title')!;
  const overlayText = document.getElementById('overlay-text')!;
  const actionBtn = document.getElementById('action')!;

  const COLS = 20;
  const ROWS = 16;
  const CELL = canvas.width / COLS;

  type Dir = 'up' | 'down' | 'left' | 'right';
  const vectors: Record<Dir, [number, number]> = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };
  const opposite: Record<Dir, Dir> = { up: 'down', down: 'up', left: 'right', right: 'left' };

  let snake: [number, number][] = [];
  let dir: Dir = 'right';
  let queued: Dir = 'right';
  let food: [number, number] = [0, 0];
  let score = 0;
  let timer: number | undefined;
  let playing = false;

  function placeFood() {
    do {
      food = [Math.floor(Math.random() * COLS), Math.floor(Math.random() * ROWS)];
    } while (snake.some(([x, y]) => x === food[0] && y === food[1]));
  }

  function draw() {
    ctx.fillStyle = '#0d1712';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#f0604f';
    ctx.fillRect(food[0] * CELL + 3, food[1] * CELL + 3, CELL - 6, CELL - 6);
    snake.forEach(([x, y], i) => {
      ctx.fillStyle = i === 0 ? '#e5ffe9' : '#8ee6a4';
      ctx.fillRect(x * CELL + 1, y * CELL + 1, CELL - 2, CELL - 2);
    });
    ctx.fillStyle = '#6fae85';
    ctx.font = '12px monospace';
    ctx.fillText(String(score), 6, 14);
  }

  function endGame() {
    playing = false;
    window.clearInterval(timer);
    overlayTitle.textContent = String(score);
    overlayText.textContent = '遊戲結束，按紅色按鈕再玩一次';
    overlay.classList.remove('hidden');
  }

  function step() {
    dir = queued;
    const [dx, dy] = vectors[dir];
    const head: [number, number] = [snake[0][0] + dx, snake[0][1] + dy];
    const hitWall = head[0] < 0 || head[0] >= COLS || head[1] < 0 || head[1] >= ROWS;
    if (hitWall || snake.some(([x, y]) => x === head[0] && y === head[1])) {
      endGame();
      return;
    }
    snake.unshift(head);
    if (head[0] === food[0] && head[1] === food[1]) {
      score++;
      placeFood();
    } else {
      snake.pop();
    }
    draw();
  }

  function start() {
    window.clearInterval(timer);
    snake = [[5, 8], [4, 8], [3, 8]];
    dir = 'right';
    queued = 'right';
    score = 0;
    placeFood();
    playing = true;
    overlay.classList.add('hidden');
    draw();
    timer = window.setInterval(step, 120);
  }

  function turn(next: Dir) {
    if (!playing) return;
    if (next !== opposite[dir]) queued = next;
  }

  actionBtn.addEventListener('click', start);
  document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) => {
    btn.addEventListener('click', () => turn(btn.dataset.dir as Dir));
  });

  const keyMap: Record<string, Dir> = {
    ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
    w: 'up', s: 'down', a: 'left', d: 'right',
  };
  window.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return;
    const mapped = keyMap[e.key] ?? keyMap[e.key.toLowerCase()];
    if (mapped) {
      if (playing) e.preventDefault();
      turn(mapped);
    } else if (e.key === ' ' && !playing) {
      e.preventDefault();
      start();
    }
  });

  ctx.fillStyle = '#0d1712';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
</script>
