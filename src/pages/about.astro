---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { marked } from 'marked';

const { data: page } = await supabase.from('site_pages').select('*').eq('slug', 'about').maybeSingle();

const title = page?.title ?? '嗨，我是 Yaya 林';
const bodyHtml = page ? await marked.parse(page.content) : '';
---

<BaseLayout title="關於我" description="關於 Yaya，學生、新竹縣兒少委員的自我介紹。">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <p class="reveal inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-6">關於我</p>
    <h1 class="font-display text-4xl sm:text-5xl text-ink mb-8">
      <span data-text-reveal>{title}</span>
    </h1>

    <div class="reveal prose-about" style="animation-delay: 0.2s;" set:html={bodyHtml} />

    <div class="reveal grid sm:grid-cols-3 gap-4 mt-12" style="animation-delay: 0.3s;">
      <div data-tilt class="bg-sage-light border-2 border-ink p-6 text-center">
        <p class="font-display text-2xl text-ink mb-1">學生</p>
        <p class="text-sm text-ink-light">目前身份</p>
      </div>
      <div data-tilt class="bg-clay-light border-2 border-ink p-6 text-center">
        <p class="font-display text-2xl text-ink mb-1">兒少委員</p>
        <p class="text-sm text-ink-light">新竹縣</p>
      </div>
      <div data-tilt class="bg-butter-light border-2 border-ink p-6 text-center">
        <p class="font-display text-2xl text-ink mb-1">寫作 / 攝影</p>
        <p class="text-sm text-ink-light">興趣所在</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-about :global(p) {
    color: var(--color-ink-light);
    line-height: 1.9;
    margin-bottom: 1.25em;
    font-size: 1.125rem;
  }
  .prose-about :global(a) {
    color: var(--color-clay);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
