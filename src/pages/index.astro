---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteWidget from '../components/QuoteWidget.astro';
import BlogCard from '../components/BlogCard.astro';
import { supabase } from '../lib/supabase';

const { data: posts } = await supabase
  .from('blog_posts')
  .select('*')
  .order('date', { ascending: false })
  .limit(3);

const { data: aboutPage } = await supabase.from('site_pages').select('*').eq('slug', 'about').maybeSingle();
const aboutTeaser = aboutPage?.content.split('\n\n')[0] ?? null;

const { data: timelineEntries } = await supabase
  .from('timeline_entries')
  .select('*')
  .order('date', { ascending: false })
  .limit(4);

const { data: allActiveSurveys } = await supabase
  .from('surveys')
  .select('*')
  .eq('is_active', true)
  .order('created_at', { ascending: false });

const now = Date.now();
const activeSurveys = (allActiveSurveys ?? [])
  .filter((s) => {
    if (s.opens_at && new Date(s.opens_at).getTime() > now) return false;
    if (s.closes_at && new Date(s.closes_at).getTime() < now) return false;
    return true;
  })
  .slice(0, 3);

const firstSurvey = activeSurveys[0];
const quickLinks = [
  { href: '/blog', icon: '📝', label: '部落格', bg: 'bg-butter-light' },
  { href: '/committee', icon: '🏛️', label: '兒少委員專區', bg: 'bg-clay-light' },
  ...(firstSurvey ? [{ href: `/survey/${firstSurvey.id}`, icon: '📋', label: '填寫問卷', bg: 'bg-white' }] : []),
  { href: '/contact', icon: '💌', label: '聯絡我', bg: 'bg-sage-light' },
];

const statementChars = aboutTeaser ? [...aboutTeaser] : [];

// 每張卡片一開始散開的位置與角度，捲動時聚攏
const convergeOffsets = [
  { dx: '-70px', dy: '90px', r: '-7deg' },
  { dx: '80px', dy: '120px', r: '6deg' },
  { dx: '-50px', dy: '150px', r: '5deg' },
  { dx: '60px', dy: '80px', r: '-6deg' },
];

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="首頁"
  fullTitle="yaya 林（lin yaya）｜新竹縣兒少代表・兒少委員"
  description="yaya 林（lin yaya、yaya lin）是新竹縣兒少代表，2024 年起擔任新竹縣兒童及少年福利與權益促進委員會青少年代表委員，提案關注學生獎懲辦法、兒少就學交通安全，並記錄兒少參與與生活。"
>
  <Hero />

  <section class="max-w-4xl mx-auto px-6 pb-16">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {quickLinks.map((q, i) => (
        <a
          href={q.href}
          data-magnetic
          class={`tile reveal border-2 border-ink flex flex-col items-center justify-center gap-2 px-3 py-7 text-ink font-semibold text-center ${q.bg}`}
          style={`animation-delay: ${i * 0.06}s`}
        >
          <span class="text-3xl" aria-hidden="true">{q.icon}</span>
          <span class="text-sm">{q.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="px-4 sm:px-6 pb-24">
    <div class="showcase reveal max-w-5xl mx-auto rounded-[2rem] px-5 py-14 sm:px-14 sm:py-20">
      <QuoteWidget />
    </div>
  </section>

  {aboutTeaser && (
    <section class="relative h-[240vh] bg-clay-light border-y-2 border-ink" data-statement>
      <div class="sticky top-16 h-[calc(100vh-4rem)] flex flex-col items-center justify-center px-6 text-center">
        <p class="inline-block bg-white border-2 border-ink rounded-full text-xs font-semibold tracking-widest px-4 py-1 mb-8">關於我</p>
        <p class="statement font-display text-3xl sm:text-5xl leading-[1.55] max-w-3xl" aria-label={aboutTeaser}>
          {statementChars.map((c) => <span class="scrub-char" aria-hidden="true">{c}</span>)}
        </p>
        <a
          href="/about"
          data-magnetic
          class="btn-pop mt-12 px-7 py-3 text-sm"
        >
          認識更多 &rarr;
        </a>
      </div>
    </section>
  )}

  {timelineEntries && timelineEntries.length > 0 && (
    <section class="bg-wine text-cream py-24 sm:py-32 overflow-hidden" data-converge>
      <div class="max-w-5xl mx-auto px-6">
        <div class="reveal flex items-end justify-between gap-4 mb-14">
          <h2 class="font-display text-4xl sm:text-6xl tracking-tight">兒少委員專區</h2>
          <a href="/committee" data-magnetic class="shrink-0 text-sm font-semibold text-cream/80 hover:text-butter transition-colors">看完整時間軸 &rarr;</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          {timelineEntries.map((entry, i) => {
            const o = convergeOffsets[i % convergeOffsets.length];
            return (
              <article
                class="converge-card card-pop p-7 text-ink"
                style={`--dx:${o.dx};--dy:${o.dy};--r:${o.r}`}
              >
                <div class="flex flex-wrap items-center gap-2 mb-4">
                  <p class="bg-butter-light border-2 border-ink text-ink text-xs font-semibold px-3 py-1 rounded-full">{formatDate(entry.date)}</p>
                  {entry.status && <p class="bg-clay text-cream border-2 border-ink text-xs font-semibold px-3 py-1 rounded-full">{entry.status}</p>}
                </div>
                <h3 class="font-display text-xl sm:text-2xl mb-2 leading-snug">{entry.title}</h3>
                <p class="text-sm text-ink-light leading-relaxed line-clamp-3">{entry.description}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {activeSurveys.length > 0 && (
    <section class="max-w-4xl mx-auto px-6 pb-24 grid gap-5">
      {activeSurveys.map((survey, i) => (
        <div data-tilt class="reveal card-pop bg-butter-light p-8 sm:p-10" style={`animation-delay: ${i * 0.08}s`}>
          <p class="inline-block bg-ink text-cream text-xs font-semibold px-2.5 py-1 mb-4">📋 問卷</p>
          <h2 class="font-display text-2xl text-ink mb-2">{survey.title}</h2>
          {survey.description && <p class="text-ink-light leading-relaxed mb-5">{survey.description}</p>}
          <div class="flex flex-wrap gap-3">
            <a
              href={`/survey/${survey.id}`}
              data-magnetic
              class="btn-pop px-6 py-2.5 text-sm"
            >
              填寫問卷 →
            </a>
            {survey.link_url && (
              <a
                href={survey.link_url}
                target="_blank"
                rel="noopener noreferrer"
                data-magnetic
                class="px-6 py-2.5 border-2 border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors"
              >
                🔗 相關連結
              </a>
            )}
            {survey.pdf_url && (
              <a
                href={survey.pdf_url}
                target="_blank"
                rel="noopener noreferrer"
                data-magnetic
                class="px-6 py-2.5 border-2 border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors"
              >
                📄 相關文件
              </a>
            )}
          </div>
        </div>
      ))}
    </section>
  )}

  <section class="max-w-4xl mx-auto px-6 pb-24">
    <div class="reveal flex items-end justify-between mb-6">
      <h2 class="font-display text-2xl sm:text-3xl text-ink">最新文章</h2>
      <a href="/blog" data-magnetic class="text-sm font-semibold text-clay hover:text-ink transition-colors">看全部 →</a>
    </div>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
      {(posts ?? []).map((post, i) => (
        <BlogCard post={post} index={i} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .showcase {
    background: linear-gradient(135deg, var(--color-clay-light) 0%, var(--color-butter-light) 52%, var(--color-sage-light) 100%);
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-ink);
  }

  :global(html.js-scrub) .scrub-char {
    color: rgba(53, 49, 46, 0.22);
    transition: color 0.3s ease;
  }
  :global(html.js-scrub) .scrub-char.lit {
    color: var(--color-ink);
  }

  .converge-card {
    transform: translate3d(calc((1 - var(--p, 1)) * var(--dx)), calc((1 - var(--p, 1)) * var(--dy)), 0)
      rotate(calc((1 - var(--p, 1)) * var(--r)));
    opacity: calc(0.15 + 0.85 * var(--p, 1));
    will-change: transform, opacity;
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    document.documentElement.classList.add('js-scrub');

    const statement = document.querySelector<HTMLElement>('[data-statement]');
    const chars = statement ? Array.from(statement.querySelectorAll<HTMLElement>('.scrub-char')) : [];
    const converge = document.querySelector<HTMLElement>('[data-converge]');
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;

      if (statement && chars.length) {
        const r = statement.getBoundingClientRect();
        const progress = clamp(-r.top / Math.max(1, r.height - vh));
        const litCount = Math.ceil(clamp(progress / 0.85) * chars.length);
        chars.forEach((c, i) => c.classList.toggle('lit', i < litCount));
      }

      if (converge) {
        const r = converge.getBoundingClientRect();
        converge.style.setProperty('--p', String(clamp((vh * 0.95 - r.top) / (vh * 0.75))));
      }
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
