---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteWidget from '../components/QuoteWidget.astro';
import BlogCard from '../components/BlogCard.astro';
import { supabase } from '../lib/supabase';

const { data: posts } = await supabase
  .from('blog_posts')
  .select('*')
  .order('date', { ascending: false })
  .limit(3);

const { data: aboutPage } = await supabase.from('site_pages').select('*').eq('slug', 'about').maybeSingle();
const aboutTeaser = aboutPage?.content.split('\n\n')[0] ?? null;

const { data: timelineEntries } = await supabase
  .from('timeline_entries')
  .select('*')
  .order('date', { ascending: false })
  .limit(2);

const { data: activeSurveys } = await supabase
  .from('surveys')
  .select('*')
  .eq('is_active', true)
  .order('created_at', { ascending: false })
  .limit(1);
const activeSurvey = activeSurveys?.[0] ?? null;

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="首頁">
  <Hero />

  <section class="max-w-4xl mx-auto px-6 pb-20">
    <QuoteWidget />
  </section>

  {aboutTeaser && (
    <section class="max-w-4xl mx-auto px-6 pb-24">
      <div class="reveal bg-sage-light border-2 border-ink p-8 sm:p-10 grid sm:grid-cols-[1fr_auto] gap-6 items-center">
        <div>
          <p class="inline-block bg-ink text-cream text-xs font-semibold px-2.5 py-1 mb-4">關於我</p>
          <p class="text-ink leading-relaxed text-lg">{aboutTeaser}</p>
        </div>
        <a
          href="/about"
          data-magnetic
          class="justify-self-start sm:justify-self-end shrink-0 px-6 py-2.5 border-2 border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors whitespace-nowrap"
        >
          認識更多 →
        </a>
      </div>
    </section>
  )}

  {timelineEntries && timelineEntries.length > 0 && (
    <section class="max-w-4xl mx-auto px-6 pb-24">
      <div class="reveal flex items-end justify-between mb-6">
        <h2 class="font-display text-2xl sm:text-3xl text-ink">兒少委員專區</h2>
        <a href="/committee" data-magnetic class="text-sm font-semibold text-clay hover:text-ink transition-colors">看完整時間軸 →</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        {timelineEntries.map((entry, i) => (
          <div data-tilt class="reveal bg-cream border-2 border-ink p-6" style={`animation-delay: ${i * 0.08}s`}>
            <p class="inline-block bg-clay text-cream text-xs font-semibold px-2.5 py-1 mb-3">{formatDate(entry.date)}</p>
            <h3 class="font-display text-lg text-ink mb-1">{entry.title}</h3>
            <p class="text-sm text-ink-light leading-relaxed line-clamp-2">{entry.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {activeSurvey && (
    <section class="max-w-4xl mx-auto px-6 pb-24">
      <div class="reveal bg-butter-light border-2 border-ink p-8 sm:p-10">
        <p class="inline-block bg-ink text-cream text-xs font-semibold px-2.5 py-1 mb-4">📋 問卷</p>
        <h2 class="font-display text-2xl text-ink mb-2">{activeSurvey.title}</h2>
        {activeSurvey.description && <p class="text-ink-light leading-relaxed mb-5">{activeSurvey.description}</p>}
        <div class="flex flex-wrap gap-3">
          <a
            href={`/survey/${activeSurvey.id}`}
            data-magnetic
            class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors"
          >
            填寫問卷 →
          </a>
          {activeSurvey.link_url && (
            <a
              href={activeSurvey.link_url}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="px-6 py-2.5 border-2 border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors"
            >
              🔗 相關連結
            </a>
          )}
          {activeSurvey.pdf_url && (
            <a
              href={activeSurvey.pdf_url}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="px-6 py-2.5 border-2 border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors"
            >
              📄 相關文件
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="max-w-4xl mx-auto px-6 pb-24">
    <div class="reveal flex items-end justify-between mb-6">
      <h2 class="font-display text-2xl sm:text-3xl text-ink">最新文章</h2>
      <a href="/blog" data-magnetic class="text-sm font-semibold text-clay hover:text-ink transition-colors">看全部 →</a>
    </div>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
      {(posts ?? []).map((post, i) => (
        <BlogCard post={post} index={i} />
      ))}
    </div>
  </section>
</BaseLayout>
