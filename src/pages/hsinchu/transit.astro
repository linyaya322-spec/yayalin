---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="新竹縣交通地圖"
  fullTitle="新竹縣交通地圖｜公車、公路客運、YouBike 一次看｜yaya 林"
  description="新竹縣公車、公路客運路線、單一站點班次密集度、尖峰時段班距、YouBike 即時站點與尖峰離峰使用記錄地圖——給議員與關心地方交通的人查詢的公開資料頁面。"
>

  <section class="max-w-3xl mx-auto px-6 pt-16 pb-8">
    <p class="reveal inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-6">新竹縣交通地圖</p>
    <h1 class="font-display text-4xl sm:text-5xl text-ink mb-6">
      <span data-text-reveal>新竹縣的公車、公路客運跟 YouBike，都在這裡</span>
    </h1>
    <p class="reveal text-ink-light leading-relaxed text-lg max-w-2xl" style="animation-delay: 0.2s;">
      資料直接來自交通部 TDX 運輸資料流通服務平台，每天自動更新一次。每條路線、每個站點平日尖峰時段
      （早上 7-9 點、下午 4-6 點）的實際班次跟班距都算給你看——不是我主觀判斷「夠不夠密」，數字都可以
      自己查證，也歡迎議員辦公室直接引用。
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-8">
    <div id="summary-cards" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="card-pop bg-sage-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-county">—</p>
        <p class="text-xs text-ink-light mt-1">縣市公車路線</p>
      </div>
      <div class="card-pop bg-butter-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-intercity">—</p>
        <p class="text-xs text-ink-light mt-1">停靠新竹縣的公路客運</p>
      </div>
      <div class="card-pop bg-clay-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-bike">—</p>
        <p class="text-xs text-ink-light mt-1">YouBike 站點</p>
      </div>
      <div class="card-pop bg-sage-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-sparse">—</p>
        <p class="text-xs text-ink-light mt-1">尖峰時段班次 ≤ 2 班的方向數</p>
      </div>
      <div class="card-pop bg-butter-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-stops">—</p>
        <p class="text-xs text-ink-light mt-1">公車站牌數（不重複計算）</p>
      </div>
      <div class="card-pop bg-clay-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-hub-stops">—</p>
        <p class="text-xs text-ink-light mt-1">3 條以上路線經過的轉乘站</p>
      </div>
      <div class="card-pop bg-sage-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-no-schedule-stops">—</p>
        <p class="text-xs text-ink-light mt-1">經過的路線都沒有時刻表資料的站牌</p>
      </div>
      <div class="card-pop bg-butter-light p-4 text-center">
        <p class="font-display text-3xl text-ink" id="stat-bike-samples">—</p>
        <p class="text-xs text-ink-light mt-1">YouBike 累積快照筆數</p>
      </div>
    </div>
    <p id="cache-note" class="text-xs text-ink-light mb-2"></p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-10">
    <div id="map" class="card-pop" style="height: 560px; width: 100%; background: var(--color-cream-dark);"></div>
    <div class="flex flex-wrap gap-4 mt-3 text-xs text-ink-light">
      <span><span class="inline-block w-3 h-3 rounded-full mr-1" style="background:#2f5bd0;"></span>縣市公車路線</span>
      <span><span class="inline-block w-3 h-3 rounded-full mr-1" style="background:#d63a3a;"></span>公路客運路線</span>
      <span><span class="inline-block w-3 h-3 rounded-full mr-1" style="background:#0fb88a;"></span>YouBike 正常</span>
      <span><span class="inline-block w-3 h-3 rounded-full mr-1" style="background:#d63a3a;"></span>YouBike 常態缺車</span>
      <span><span class="inline-block w-3 h-3 rounded-full mr-1" style="background:#2f5bd0;"></span>YouBike 常態爆滿</span>
      <span><span class="inline-block w-3 h-3 rounded-full mr-1" style="background:#9fb0c6;"></span>YouBike 資料不足</span>
      <span><span class="inline-block w-3 h-3 rounded-full mr-1" style="background:#f5a623;"></span>公車站牌（點大小依經過路線數）</span>
    </div>
    <p id="map-status" class="text-sm text-ink-light mt-2"></p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-10">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <h2 class="font-display text-2xl text-ink">路線尖峰班距一覽</h2>
      <button type="button" id="download-routes-btn" class="filter-btn">⬇ 下載 CSV</button>
    </div>
    <p class="text-ink-light text-sm mb-4">
      預設排序：尖峰時段班次最少的方向排在最前面。「班距」是那個時段內班次之間的平均間隔分鐘數；
      班次只有 0～1 班時算不出間隔，會直接寫「只有 N 班」。只計算平日（週一到週五）都有的班次，
      不含只有假日才跑的加班車。
    </p>
    <div class="flex flex-wrap gap-2 mb-4" id="filter-row">
      <button type="button" class="filter-btn active" data-filter="all">全部</button>
      <button type="button" class="filter-btn" data-filter="county">縣市公車</button>
      <button type="button" class="filter-btn" data-filter="intercity">公路客運</button>
      <button type="button" class="filter-btn" data-filter="sparse">尖峰 ≤ 2 班</button>
    </div>
    <div class="overflow-x-auto card-pop">
      <table class="w-full text-sm" id="route-table">
        <thead>
          <tr class="border-b-2 border-ink text-left">
            <th class="p-2">路線</th>
            <th class="p-2">方向</th>
            <th class="p-2">類型</th>
            <th class="p-2">早上尖峰</th>
            <th class="p-2">下午尖峰</th>
          </tr>
        </thead>
        <tbody id="route-table-body">
          <tr><td class="p-3 text-ink-light" colspan="5">載入中…</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-10">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <h2 class="font-display text-2xl text-ink">單一站點的班次密集度</h2>
      <button type="button" id="download-stops-btn" class="filter-btn">⬇ 下載 CSV</button>
    </div>
    <p class="text-ink-light text-sm mb-4">
      同一個站牌常常有好幾條路線經過——這裡把經過同一站的所有路線合併計算，回答「這一站尖峰時段
      到底有多少班車經過」，不是只看單一路線自己的班距。「經過的路線都沒有時刻表資料」的站牌
      （通常是只有公路客運經過），沒辦法算出真正的密集度，會另外標示，不會顯示成「無班次」。
    </p>
    <div class="flex flex-wrap gap-2 mb-4" id="stop-filter-row">
      <button type="button" class="filter-btn active" data-stopfilter="sparsest">最少班次優先</button>
      <button type="button" class="filter-btn" data-stopfilter="busiest">最多班次優先</button>
      <button type="button" class="filter-btn" data-stopfilter="hub">轉乘站（≥3 條路線）</button>
    </div>
    <div class="overflow-x-auto card-pop">
      <table class="w-full text-sm" id="stop-table">
        <thead>
          <tr class="border-b-2 border-ink text-left">
            <th class="p-2">站牌</th>
            <th class="p-2">經過路線數</th>
            <th class="p-2">早上尖峰（合計）</th>
            <th class="p-2">下午尖峰（合計）</th>
          </tr>
        </thead>
        <tbody id="stop-table-body">
          <tr><td class="p-3 text-ink-light" colspan="4">載入中…</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    <h2 class="font-display text-2xl text-ink mb-3">YouBike 使用記錄</h2>
    <div class="card-pop bg-sage-light p-6 mb-4">
      <p class="text-ink leading-relaxed" id="bike-history-note">載入中…</p>
    </div>
    <div class="card-pop p-6" id="bike-peak-card">
      <h3 class="font-display text-lg text-ink mb-2">尖峰／離峰的騎乘型態</h3>
      <p class="text-ink-light text-sm mb-4">
        用累積到的每小時站點快照，比較「平均可借車輛數」在早上尖峰、下午尖峰、離峰時段的差異——
        可借車輛數愈低，代表那個時段被借走的人愈多（需求愈高），可以用來判斷各時段是否需要調整
        調度（例如尖峰前多補車、離峰時段適度移車）。
      </p>
      <div id="bike-peak-summary" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <p class="text-ink-light text-sm col-span-3">載入中…</p>
      </div>
    </div>

    <div class="card-pop p-6 mt-4">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <h3 class="font-display text-lg text-ink">單站熱點：常態缺車／常態爆滿</h3>
        <button type="button" id="download-bike-btn" class="filter-btn">⬇ 下載 CSV</button>
      </div>
      <p class="text-ink-light text-sm mb-4">
        用每一站累積到的快照，算出平均可借／可還車輛數佔總車位的比例——長期偏低的可借比例代表
        「常常被借光」（該站需求高，建議增加調度或擴充站位），長期偏低的可還比例代表「常常沒地方
        還車」（該站車位不足）。快照數太少（少於 12 筆）的站先標「資料不足」，不做判定。
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="bike-hotspot-table">
          <thead>
            <tr class="border-b-2 border-ink text-left">
              <th class="p-2">站點</th>
              <th class="p-2">平均可借</th>
              <th class="p-2">平均可還</th>
              <th class="p-2">總車位</th>
              <th class="p-2">快照數</th>
              <th class="p-2">判定</th>
            </tr>
          </thead>
          <tbody id="bike-hotspot-table-body">
            <tr><td class="p-3 text-ink-light" colspan="6">載入中…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div class="card-pop bg-butter-light p-6 text-sm text-ink-light leading-relaxed">
      <p class="font-semibold text-ink mb-2">資料來源與方法說明</p>
      <p>公車、公路客運路線與班表：交通部 TDX 運輸資料流通服務平台（縣市公車用「HsinchuCounty」縣市代碼、公路客運用停靠站牌的縣市代碼篩出有經過新竹縣的路線），每天自動重新抓取一次。單一站點的密集度是把經過同一個實體站牌的所有路線、各自在「那一站」（不是起站）的到站時刻合併計算出來的。YouBike 即時站點同樣來自 TDX；長期使用記錄則是這個網站從 2026 年 9 月底開始，每小時自動記錄一次站點空滿狀態累積出來的——查過政府資料開放平臺跟新竹縣政府開放資料專區，都沒有新竹縣（不同於新竹市）YouBike 的長期使用量統計，所以沒辦法呈現更早的資料，尖峰/離峰的騎乘型態分析也會隨資料累積愈來愈準確。</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* 這頁要看地圖、操作表格，全站共用的自訂滑鼠光標（跟隨滑鼠的點狀特效）在這裡反而干擾操作。
     Interactions.astro 的 script 是 Astro 預設打包成的 module，比這頁自己任何 script 執行得晚
     （module script 一律延後到 HTML 解析完才跑）——用 JS 在載入時去移除 has-custom-cursor
     class 會在它被加上去「之前」就先跑掉，等於沒用。改用純 CSS：不管那個 class 什麼時候被
     加上，這條規則的優先權都蓋得過去，只影響這一頁（:global 是因為 <html>／#cursor-dot／
     #cursor-ring 都在這個元件自己的模板之外）。 */
  :global(html.has-custom-cursor) {
    cursor: auto !important;
  }
  :global(html.has-custom-cursor a),
  :global(html.has-custom-cursor button) {
    cursor: pointer !important;
  }
  :global(#cursor-dot),
  :global(#cursor-ring) {
    display: none !important;
  }

  .filter-btn {
    border: 2px solid var(--color-ink);
    background: var(--color-cream);
    color: var(--color-ink);
    padding: 0.3rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: 999px;
    cursor: pointer;
  }
  .filter-btn.active {
    background: var(--color-ink);
    color: var(--color-cream);
  }
  #route-table th, #route-table td, #stop-table th, #stop-table td {
    white-space: nowrap;
  }
  #route-table tbody tr:nth-child(even), #stop-table tbody tr:nth-child(even) {
    background: var(--color-cream-dark);
  }
  .headway-tight { color: var(--color-sage-dark); font-weight: 700; }
  .headway-loose { color: var(--color-clay-dark); font-weight: 700; }
  .bike-peak-stat { background: var(--color-cream-dark); border-radius: 12px; padding: 0.9rem 1rem; text-align: center; }
  .bike-peak-stat .num { font-family: var(--font-display); font-size: 1.6rem; color: var(--color-ink); }
  .bike-peak-stat .lbl { font-size: 0.78rem; color: var(--color-ink-light); margin-top: 2px; }
  #bike-hotspot-table th, #bike-hotspot-table td { white-space: nowrap; }
  #bike-hotspot-table tbody tr:nth-child(even) { background: var(--color-cream-dark); }
  .hotspot-empty { color: var(--color-clay-dark); font-weight: 700; }
  .hotspot-full { color: var(--color-sage-dark); font-weight: 700; }
</style>

<script>
  interface Peak { tripCount: number; avgHeadwayMin: number | null }
  interface SubRoute { subRouteUID: string; direction: number; headsign: string; stops: { uid: string; name: string; lat: number | null; lon: number | null }[]; path: [number, number][]; peak: { morning: Peak; evening: Peak } | null }
  interface RouteEntry { routeUID: string; name: string; operator: string | null; kind: 'county' | 'intercity'; subRoutes: SubRoute[] }
  interface BikeStation { uid: string; name: string; lat: number; lon: number; capacity: number | null; rent: number; ret: number; status: number }
  interface StopEntry {
    uid: string; name: string; lat: number | null; lon: number | null;
    routeCount: number; routes: { routeName: string; subRouteUID: string; headsign: string; kind: string }[];
    hasScheduleData: boolean; peak: { morning: Peak; evening: Peak } | null;
  }
  interface BikeHistoryRow { stationUID: string; name: string; rent: number; ret: number; recordedAt: string }
  interface Overview {
    countyBuses: RouteEntry[]; intercityBuses: RouteEntry[]; stops: StopEntry[];
    busDataCachedAt: string | null; busDataErrors: string[];
    bikeStations: BikeStation[]; bikeStationsUpdatedAt: string | null;
    bikeHistory: BikeHistoryRow[];
  }

  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  // ---- CSV 匯出：純前端產生，不用另外打後端 ----
  function toCsv(headers: string[], rows: (string | number)[][]): string {
    const esc = (v: string | number) => {
      const s = String(v ?? '');
      return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    };
    return [headers, ...rows].map((r) => r.map(esc).join(',')).join('\n');
  }
  function downloadCsv(filename: string, csv: string) {
    // 開頭加 BOM，不然 Excel 開繁體中文 CSV 常常會亂碼。
    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function headwayText(peak: Peak | null): string {
    if (!peak) return '無資料';
    if (peak.tripCount === 0) return '無班次';
    if (peak.avgHeadwayMin == null) return `只有 ${peak.tripCount} 班`;
    return `${peak.tripCount} 班・約 ${peak.avgHeadwayMin} 分一班`;
  }
  function headwayClass(peak: Peak | null): string {
    if (!peak || peak.avgHeadwayMin == null) return '';
    return peak.avgHeadwayMin <= 20 ? 'headway-tight' : peak.avgHeadwayMin >= 45 ? 'headway-loose' : '';
  }
  // 排序用的「這個方向尖峰有多稀疏」分數：班距愈大（或班次愈少）分數愈高，讓最少班次的排最前面。
  function subSparsityScore(sub: SubRoute): number {
    if (!sub.peak) return 9999;
    const scores = [sub.peak.morning, sub.peak.evening].map((p) => {
      if (p.tripCount === 0) return 9999;
      if (p.avgHeadwayMin == null) return 500 - p.tripCount * 10;   // 1 班的分數比 0 班低、比 2 班以上高
      return p.avgHeadwayMin;
    });
    return Math.max(...scores);
  }
  function isSparse(sub: SubRoute): boolean {
    return (sub.peak?.morning.tripCount ?? 0) <= 2 || (sub.peak?.evening.tripCount ?? 0) <= 2;
  }
  function stopSparsityScore(stop: StopEntry): number {
    if (!stop.peak) return 9999;
    const scores = [stop.peak.morning, stop.peak.evening].map((p) => {
      if (p.tripCount === 0) return 9999;
      if (p.avgHeadwayMin == null) return 500 - p.tripCount * 10;
      return p.avgHeadwayMin;
    });
    return Math.max(...scores);
  }
  function stopCombinedTripCount(stop: StopEntry): number {
    if (!stop.peak) return -1;
    return stop.peak.morning.tripCount + stop.peak.evening.tripCount;
  }

  interface StationStat {
    uid: string; name: string; capacity: number | null;
    avgRent: number; avgRet: number; sampleCount: number;
    status: 'empty' | 'full' | 'normal' | 'insufficient';
  }
  const MIN_HOTSPOT_SAMPLES = 12;
  // 平均可借／可還車輛數佔總車位的比例，長期低於這個門檻才判定成熱點——單一次快照空了很正常
  // （剛好有人借走），要看的是「長期平均」是不是持續偏低。
  const HOTSPOT_RATIO_THRESHOLD = 0.15;
  function computeBikeHotspots(bikeHistory: BikeHistoryRow[], bikeStations: BikeStation[]): StationStat[] {
    const capacityByUid = new Map(bikeStations.map((s) => [s.uid, s.capacity]));
    const nameByUid = new Map(bikeStations.map((s) => [s.uid, s.name]));
    const byStation = new Map<string, BikeHistoryRow[]>();
    for (const r of bikeHistory) {
      if (!byStation.has(r.stationUID)) byStation.set(r.stationUID, []);
      byStation.get(r.stationUID)!.push(r);
    }
    const out: StationStat[] = [];
    for (const [uid, rows] of byStation) {
      const avgRent = rows.reduce((s, r) => s + r.rent, 0) / rows.length;
      const avgRet = rows.reduce((s, r) => s + r.ret, 0) / rows.length;
      const capacity = capacityByUid.get(uid) ?? null;
      let status: StationStat['status'] = 'normal';
      if (rows.length < MIN_HOTSPOT_SAMPLES) {
        status = 'insufficient';
      } else if (capacity && capacity > 0) {
        if (avgRent / capacity < HOTSPOT_RATIO_THRESHOLD) status = 'empty';
        else if (avgRet / capacity < HOTSPOT_RATIO_THRESHOLD) status = 'full';
      }
      out.push({ uid, name: nameByUid.get(uid) ?? rows[0].name, capacity, avgRent, avgRet, sampleCount: rows.length, status });
    }
    return out;
  }
  function hotspotLabel(status: StationStat['status']): string {
    if (status === 'empty') return '常態缺車';
    if (status === 'full') return '常態爆滿';
    if (status === 'insufficient') return '資料不足';
    return '正常';
  }
  function hotspotClass(status: StationStat['status']): string {
    return status === 'empty' ? 'hotspot-empty' : status === 'full' ? 'hotspot-full' : '';
  }
  // 排序：異常站優先（缺車／爆滿），資料不足跟正常的排後面。
  function hotspotSortRank(status: StationStat['status']): number {
    return status === 'empty' || status === 'full' ? 0 : status === 'normal' ? 1 : 2;
  }

  async function main() {
    let data: Overview;
    try {
      const res = await fetch('/app/api/hsinchu-transit-overview');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      data = await res.json();
    } catch {
      $('map-status').textContent = '資料讀取失敗，請稍後重新整理頁面再試一次。';
      $('route-table-body').innerHTML = '<tr><td class="p-3 text-ink-light" colspan="5">資料讀取失敗。</td></tr>';
      $('stop-table-body').innerHTML = '<tr><td class="p-3 text-ink-light" colspan="4">資料讀取失敗。</td></tr>';
      $('bike-history-note').textContent = '資料讀取失敗。';
      $('bike-peak-summary').innerHTML = '<p class="text-ink-light text-sm col-span-3">資料讀取失敗。</p>';
      return;
    }
    const stops = data.stops ?? [];
    const bikeStats = computeBikeHotspots(data.bikeHistory, data.bikeStations);
    const bikeStatByUid = new Map(bikeStats.map((s) => [s.uid, s]));
    const HOTSPOT_COLOR: Record<StationStat['status'], string> = { empty: '#d63a3a', full: '#2f5bd0', normal: '#0fb88a', insufficient: '#9fb0c6' };

    // ---- 統計卡片 ----
    const allRoutes = [...data.countyBuses, ...data.intercityBuses];
    const allSubRoutes = allRoutes.flatMap((r) => r.subRoutes.map((s) => ({ route: r, sub: s })));
    $('stat-county').textContent = String(data.countyBuses.length);
    $('stat-intercity').textContent = String(data.intercityBuses.length);
    $('stat-bike').textContent = String(data.bikeStations.length);
    $('stat-sparse').textContent = String(allSubRoutes.filter((x) => isSparse(x.sub)).length);
    $('stat-stops').textContent = String(stops.length);
    $('stat-hub-stops').textContent = String(stops.filter((s) => s.routeCount >= 3).length);
    $('stat-no-schedule-stops').textContent = String(stops.filter((s) => !s.hasScheduleData).length);
    $('stat-bike-samples').textContent = String(data.bikeHistory.length);
    $('cache-note').textContent = data.busDataCachedAt
      ? `公車資料更新時間：${new Date(data.busDataCachedAt).toLocaleString('zh-TW', { hour12: false })}`
      : '公車資料尚未產生（後端排程還沒跑過第一次）。';

    // ---- 地圖 ----
    if (allRoutes.length === 0 && data.bikeStations.length === 0 && stops.length === 0) {
      $('map-status').textContent = '目前沒有資料可以顯示地圖。';
    } else {
      const L = (window as any).L;
      const map = L.map('map').setView([24.79, 121.14], 11);   // 新竹縣大致中心
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 18,
      }).addTo(map);

      for (const { route, sub } of allSubRoutes) {
        if (sub.path.length < 2) continue;
        L.polyline(sub.path, { color: route.kind === 'county' ? '#2f5bd0' : '#d63a3a', weight: 3, opacity: 0.65 })
          .bindPopup(`<b>${route.name}</b><br>${sub.headsign}<br>早上尖峰：${headwayText(sub.peak?.morning ?? null)}<br>下午尖峰：${headwayText(sub.peak?.evening ?? null)}`)
          .addTo(map);
      }
      for (const s of data.bikeStations) {
        if (s.lat == null || s.lon == null) continue;
        const stat = bikeStatByUid.get(s.uid);
        const color = stat ? HOTSPOT_COLOR[stat.status] : HOTSPOT_COLOR.insufficient;
        L.circleMarker([s.lat, s.lon], { radius: 5, color, fillColor: color, fillOpacity: 0.8, weight: 1 })
          .bindPopup(`<b>${s.name}</b><br>可借：${s.rent}・可還：${s.ret}${s.capacity != null ? `（總車位 ${s.capacity}）` : ''}${stat ? `<br>累積判定：${hotspotLabel(stat.status)}（${stat.sampleCount} 筆快照）` : ''}`)
          .addTo(map);
      }
      for (const s of stops) {
        if (s.lat == null || s.lon == null) continue;
        const radius = Math.min(10, 3 + s.routeCount);
        L.circleMarker([s.lat, s.lon], { radius, color: '#f5a623', fillColor: '#f5a623', fillOpacity: 0.55, weight: 1 })
          .bindPopup(`<b>${s.name}</b><br>經過路線：${s.routes.map((r) => r.routeName).join('、')}${s.hasScheduleData
            ? `<br>早上尖峰：${headwayText(s.peak?.morning ?? null)}<br>下午尖峰：${headwayText(s.peak?.evening ?? null)}`
            : '<br>經過的路線目前沒有時刻表資料可查'}`)
          .addTo(map);
      }
      $('map-status').textContent = `地圖上顯示 ${allSubRoutes.filter((x) => x.sub.path.length >= 2).length} 條路線線型、${stops.length} 個公車站牌、${data.bikeStations.length} 個 YouBike 站點（點圖上的線/點看詳細資訊）。`;
    }

    // ---- 路線表格 ----
    const routeTbody = $('route-table-body');
    let currentFilter = 'all';
    function renderRouteTable() {
      let rows = allSubRoutes;
      if (currentFilter === 'county') rows = rows.filter((x) => x.route.kind === 'county');
      else if (currentFilter === 'intercity') rows = rows.filter((x) => x.route.kind === 'intercity');
      else if (currentFilter === 'sparse') rows = rows.filter((x) => isSparse(x.sub));
      rows = [...rows].sort((a, b) => subSparsityScore(b.sub) - subSparsityScore(a.sub));
      if (rows.length === 0) {
        routeTbody.innerHTML = '<tr><td class="p-3 text-ink-light" colspan="5">沒有符合的路線。</td></tr>';
        return;
      }
      routeTbody.innerHTML = rows.map(({ route, sub }) => `
        <tr class="border-b border-ink/10">
          <td class="p-2 font-semibold">${route.name}</td>
          <td class="p-2 text-ink-light">${sub.headsign}</td>
          <td class="p-2">${route.kind === 'county' ? '縣市公車' : '公路客運'}</td>
          <td class="p-2 ${headwayClass(sub.peak?.morning ?? null)}">${headwayText(sub.peak?.morning ?? null)}</td>
          <td class="p-2 ${headwayClass(sub.peak?.evening ?? null)}">${headwayText(sub.peak?.evening ?? null)}</td>
        </tr>
      `).join('');
    }
    renderRouteTable();
    for (const btn of Array.from(document.querySelectorAll('.filter-btn[data-filter]'))) {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn[data-filter]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = (btn as HTMLElement).dataset.filter ?? 'all';
        renderRouteTable();
      });
    }

    // ---- 站點密集度表格 ----
    const stopTbody = $('stop-table-body');
    let currentStopFilter = 'sparsest';
    function renderStopTable() {
      let rows = stops;
      if (currentStopFilter === 'hub') rows = rows.filter((s) => s.routeCount >= 3);
      if (currentStopFilter === 'busiest') {
        rows = [...rows].sort((a, b) => stopCombinedTripCount(b) - stopCombinedTripCount(a));
      } else {
        rows = [...rows].sort((a, b) => stopSparsityScore(b) - stopSparsityScore(a));
      }
      rows = rows.slice(0, 100);   // 全縣站牌可能上千個，表格只列前 100 筆，避免整頁塞不下
      if (rows.length === 0) {
        stopTbody.innerHTML = '<tr><td class="p-3 text-ink-light" colspan="4">沒有符合的站牌。</td></tr>';
        return;
      }
      stopTbody.innerHTML = rows.map((s) => `
        <tr class="border-b border-ink/10">
          <td class="p-2 font-semibold">${s.name || '（未命名站牌）'}</td>
          <td class="p-2">${s.routeCount}</td>
          <td class="p-2 ${headwayClass(s.peak?.morning ?? null)}">${s.hasScheduleData ? headwayText(s.peak?.morning ?? null) : '無時刻表資料'}</td>
          <td class="p-2 ${headwayClass(s.peak?.evening ?? null)}">${s.hasScheduleData ? headwayText(s.peak?.evening ?? null) : '無時刻表資料'}</td>
        </tr>
      `).join('');
    }
    renderStopTable();
    for (const btn of Array.from(document.querySelectorAll('.filter-btn[data-stopfilter]'))) {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn[data-stopfilter]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentStopFilter = (btn as HTMLElement).dataset.stopfilter ?? 'sparsest';
        renderStopTable();
      });
    }

    // ---- YouBike 歷史記錄說明 ----
    const historyNote = $('bike-history-note');
    if (data.bikeHistory.length === 0) {
      historyNote.textContent = '目前還沒有累積到使用記錄——這個網站從 2026 年 9 月底開始每小時記錄一次新竹縣 YouBike 站點的空滿狀態，資料量會隨時間慢慢累積，之後這裡會更新成實際的使用趨勢圖。';
    } else {
      const earliest = data.bikeHistory.reduce((min, r) => (r.recordedAt < min ? r.recordedAt : min), data.bikeHistory[0].recordedAt);
      const days = Math.max(1, Math.round((Date.now() - new Date(earliest).getTime()) / 86400000));
      historyNote.textContent = `已經累積 ${days} 天、共 ${data.bikeHistory.length} 筆站點快照記錄（從 ${new Date(earliest).toLocaleDateString('zh-TW')} 開始，每小時記錄一次）。`;
    }

    // ---- YouBike 尖峰／離峰騎乘型態（用累積的快照，依台北時區的小時分桶）----
    const peakSummary = $('bike-peak-summary');
    if (data.bikeHistory.length === 0) {
      peakSummary.innerHTML = '<p class="text-ink-light text-sm col-span-3">目前還沒有累積到快照，暫時無法比較尖峰／離峰的差異。</p>';
    } else {
      const hourFmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Taipei', hour: '2-digit', hour12: false });
      const buckets: Record<'morning' | 'evening' | 'offpeak', BikeHistoryRow[]> = { morning: [], evening: [], offpeak: [] };
      for (const r of data.bikeHistory) {
        const hour = Number(hourFmt.format(new Date(r.recordedAt)));
        if (hour >= 7 && hour < 9) buckets.morning.push(r);
        else if (hour >= 16 && hour < 18) buckets.evening.push(r);
        else buckets.offpeak.push(r);
      }
      const avgRent = (rows: BikeHistoryRow[]) => (rows.length === 0 ? null : rows.reduce((s, r) => s + r.rent, 0) / rows.length);
      const stat = (label: string, rows: BikeHistoryRow[]) => {
        const avg = avgRent(rows);
        return `<div class="bike-peak-stat"><p class="num">${avg == null ? '—' : avg.toFixed(1)}</p><p class="lbl">${label}平均可借車輛數（${rows.length} 筆快照）</p></div>`;
      };
      peakSummary.innerHTML =
        stat('早上尖峰', buckets.morning) + stat('下午尖峰', buckets.evening) + stat('離峰', buckets.offpeak);
      const minSamples = Math.min(buckets.morning.length, buckets.evening.length, buckets.offpeak.length);
      if (minSamples < 24) {
        peakSummary.insertAdjacentHTML('beforeend', '<p class="text-ink-light text-xs col-span-3 mt-1">資料量還少（部分時段快照數 &lt; 24 筆），比較僅供初步參考，會隨時間累積愈來愈準確。</p>');
      }
    }

    // ---- YouBike 單站熱點表格 ----
    const hotspotRows = [...bikeStats].sort((a, b) => {
      const rankDiff = hotspotSortRank(a.status) - hotspotSortRank(b.status);
      if (rankDiff !== 0) return rankDiff;
      return a.avgRent - b.avgRent;   // 同一組裡，可借車輛數愈少的愈前面
    });
    const hotspotBody = $('bike-hotspot-table-body');
    if (hotspotRows.length === 0) {
      hotspotBody.innerHTML = '<tr><td class="p-3 text-ink-light" colspan="6">目前還沒有累積到足夠的快照。</td></tr>';
    } else {
      hotspotBody.innerHTML = hotspotRows.map((s) => `
        <tr class="border-b border-ink/10">
          <td class="p-2 font-semibold">${s.name}</td>
          <td class="p-2">${s.avgRent.toFixed(1)}</td>
          <td class="p-2">${s.avgRet.toFixed(1)}</td>
          <td class="p-2">${s.capacity ?? '—'}</td>
          <td class="p-2">${s.sampleCount}</td>
          <td class="p-2 ${hotspotClass(s.status)}">${hotspotLabel(s.status)}</td>
        </tr>
      `).join('');
    }

    // ---- CSV 下載 ----
    $('download-routes-btn').addEventListener('click', () => {
      const rows = allSubRoutes.map(({ route, sub }) => [
        route.name, sub.headsign, route.kind === 'county' ? '縣市公車' : '公路客運',
        sub.peak?.morning.tripCount ?? '', sub.peak?.morning.avgHeadwayMin ?? '',
        sub.peak?.evening.tripCount ?? '', sub.peak?.evening.avgHeadwayMin ?? '',
      ]);
      downloadCsv('新竹縣交通地圖_路線班距.csv', toCsv(
        ['路線', '方向', '類型', '早上尖峰班次數', '早上尖峰平均班距(分)', '下午尖峰班次數', '下午尖峰平均班距(分)'], rows,
      ));
    });
    $('download-stops-btn').addEventListener('click', () => {
      const rows = stops.map((s) => [
        s.name, s.routeCount, s.routes.map((r) => r.routeName).join('/'),
        s.hasScheduleData ? (s.peak?.morning.tripCount ?? '') : '無時刻表資料',
        s.hasScheduleData ? (s.peak?.morning.avgHeadwayMin ?? '') : '',
        s.hasScheduleData ? (s.peak?.evening.tripCount ?? '') : '無時刻表資料',
        s.hasScheduleData ? (s.peak?.evening.avgHeadwayMin ?? '') : '',
      ]);
      downloadCsv('新竹縣交通地圖_站點密集度.csv', toCsv(
        ['站牌', '經過路線數', '經過路線', '早上尖峰班次數', '早上尖峰平均班距(分)', '下午尖峰班次數', '下午尖峰平均班距(分)'], rows,
      ));
    });
    $('download-bike-btn').addEventListener('click', () => {
      const rows = hotspotRows.map((s) => [s.name, s.avgRent.toFixed(1), s.avgRet.toFixed(1), s.capacity ?? '', s.sampleCount, hotspotLabel(s.status)]);
      downloadCsv('新竹縣交通地圖_YouBike熱點.csv', toCsv(
        ['站點', '平均可借', '平均可還', '總車位', '快照數', '判定'], rows,
      ));
    });
  }

  main();
</script>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
