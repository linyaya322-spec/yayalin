  const timelineList = document.getElementById('timeline-list')!;

  function setTimelinePdf(url: string) {
    timelinePdf.value = url;
    timelinePdfPreview.href = url;
    timelinePdfPreview.classList.remove('hidden');
    timelinePdfRemove.classList.remove('hidden');
  }

  function clearTimelinePdf() {
    timelinePdf.value = '';
    timelinePdfPreview.href = '';
    timelinePdfPreview.classList.add('hidden');
    timelinePdfRemove.classList.add('hidden');
    timelinePdfInput.value = '';
  }

  timelinePdfInput.addEventListener('change', async () => {
    const file = timelinePdfInput.files?.[0];
    if (!file) return;
    timelinePdfStatus.textContent = '上傳中...';
    if (file.size > MAX_IMAGE_BYTES * 2) {
      alert('檔案太大了，請上傳 10MB 以下的 PDF。');
      timelinePdfStatus.textContent = '';
      return;
    }
    const path = `${crypto.randomUUID()}.pdf`;
    const { error } = await supabase.storage.from('timeline-files').upload(path, file);
    if (error) {
      alert(`PDF 上傳失敗：${error.message}`);
      timelinePdfStatus.textContent = '';
      return;
    }
    const { data } = supabase.storage.from('timeline-files').getPublicUrl(path);
    timelinePdfStatus.textContent = '上傳完成！';
    setTimelinePdf(data.publicUrl);
  });

  timelinePdfRemove.addEventListener('click', clearTimelinePdf);

  function resetTimelineForm() {
    timelineForm.reset();
    timelineId.value = '';
    timelineCancel.classList.add('hidden');
    clearTimelinePdf();
