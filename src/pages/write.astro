  // ---------- 學生意見箱 ----------
  const suggestionList = document.getElementById('suggestion-list')!;
  const suggestionCollectSchool = document.getElementById('suggestion-collect-school') as HTMLInputElement;
  const suggestionCollectContact = document.getElementById('suggestion-collect-contact') as HTMLInputElement;

  suggestionCollectSchool.addEventListener('change', async () => {
    await supabase
      .from('app_settings')
      .upsert({ key: 'suggestion_box_collect_school', value: String(suggestionCollectSchool.checked) });
  });

  suggestionCollectContact.addEventListener('change', async () => {
    await supabase
      .from('app_settings')
      .upsert({ key: 'suggestion_box_collect_contact', value: String(suggestionCollectContact.checked) });
  });

  async function loadSuggestions() {
    const { data: settingsData } = await supabase
      .from('app_settings')
      .select('*')
      .in('key', ['suggestion_box_collect_school', 'suggestion_box_collect_contact']);
    suggestionCollectSchool.checked = settingsData?.find((s) => s.key === 'suggestion_box_collect_school')?.value === 'true';
    suggestionCollectContact.checked = settingsData?.find((s) => s.key === 'suggestion_box_collect_contact')?.value === 'true';

    const { data } = await supabase
      .from('student_suggestions')
      .select('*')
      .order('created_at', { ascending: false });
    const { data: messagesData } = await supabase
      .from('suggestion_messages')
      .select('*')
      .order('created_at', { ascending: true });
    const messagesBySuggestion = new Map<string, any[]>();
    (messagesData ?? []).forEach((m) => {
      const arr = messagesBySuggestion.get(m.suggestion_id) ?? [];
      arr.push(m);
      messagesBySuggestion.set(m.suggestion_id, arr);
    });
    suggestionList.innerHTML = '';
    (data ?? []).forEach((s) => {
      const li = document.createElement('li');
      li.className = 'border-2 border-ink bg-cream p-4 grid gap-3';
      const meta = [s.case_number, fmtDate(s.created_at), s.school, s.grade, s.contact_name].filter(Boolean).map(esc).join(' · ');
      const attachmentChip = (path: string, label: string, deleteAttr?: string) => `
        <span class="inline-flex border-2 border-ink">
          <button type="button" data-view-attachment="${esc(path)}" class="px-2.5 py-1 text-xs font-semibold hover:bg-ink hover:text-cream transition-colors">📎 ${label}</button>
          ${deleteAttr ? `<button type="button" ${deleteAttr}="${esc(path)}" title="刪除這個附件" class="px-2 py-1 text-xs font-semibold border-l-2 border-ink text-clay hover:bg-clay hover:text-cream transition-colors">✕</button>` : ''}
        </span>
      `;
      const attachmentsHtml = (s.attachment_paths ?? [])
        .map((path: string, i: number) => attachmentChip(path, `附件 ${i + 1}`, 'data-delete-attachment'))
        .join('');

      const thread = messagesBySuggestion.get(s.id) ?? [];
      const legacyReplyHtml =
        s.admin_reply && thread.length === 0
          ? `
        <div class="border-2 border-ink bg-sage-light p-3 text-sm">
          <p class="text-xs text-ink-light mb-1">你（舊版回覆紀錄）${s.reply_status === 'sent' ? `· ${fmtDate(s.reply_sent_at)}` : ''}</p>
          <p class="text-ink break-words">${s.admin_reply.replace(/\n/g, '<br>')}</p>
        </div>
      `
          : '';
      const threadHtml = thread
        .map((m) => {
          const isOut = m.direction === 'outbound';
          const msgAttachments = (m.attachment_paths ?? [])
            .map((path: string, i: number) => attachmentChip(path, `附件 ${i + 1}`))
            .join('');
          return `
          <div class="border-2 border-ink p-3 text-sm ${isOut ? 'bg-sage-light' : 'bg-butter-light'}">
            <p class="text-xs text-ink-light mb-1">${isOut ? '你' : '對方回覆'} · ${fmtDate(m.created_at)}${m.status === 'pending' ? '（寄送中...）' : ''}</p>
            <p class="text-ink break-words">${m.direction === 'outbound' ? m.body.replace(/\n/g, '<br>') : esc(m.body).replace(/\n/g, '<br>')}</p>
            ${msgAttachments ? `<div class="flex flex-wrap gap-2 mt-2">${msgAttachments}</div>` : ''}
          </div>
        `;
        })
        .join('');

      const replyHtml = s.contact_email
        ? `
          <div class="border-t-2 border-ink/10 pt-3 grid gap-2">
            <p class="text-xs text-ink-light">與 ${esc(s.contact_email)} 的對話</p>
            ${legacyReplyHtml}
            ${threadHtml}
            <textarea data-reply-text placeholder="輸入回覆內容（純文字）..." rows="3" class="border-2 border-ink bg-cream px-3 py-2 text-sm focus:outline-none resize-none"></textarea>
            <div class="grid gap-1.5">
              <label class="text-xs text-ink-light">附件（選填，會附上下載連結，最多 5 個檔案、總大小 3MB，可以分次選取）</label>
              <div data-reply-staged-list class="flex flex-wrap gap-2"></div>
              <input type="file" data-reply-files multiple accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx" class="text-xs" />
              <p data-reply-file-status class="text-xs text-ink-light min-h-4"></p>
            </div>
            <button type="button" data-send-reply class="justify-self-start px-4 py-1.5 text-xs font-semibold border-2 border-sage-dark text-sage-dark hover:bg-sage-dark hover:text-cream transition-colors">✉️ 寄出</button>
          </div>
        `
        : '';
      li.innerHTML = `
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
          <div class="min-w-0">
            <p class="text-xs text-ink-light mb-1">${meta}</p>
            <p class="text-ink whitespace-pre-wrap break-words">${esc(s.message)}</p>
          </div>
          <div class="flex flex-wrap gap-2 shrink-0">
            ${closeToggleHtml(s.case_closed_at)}
            <button data-delete class="px-3 py-1 text-xs font-semibold border-2 border-clay text-clay hover:bg-clay hover:text-cream transition-colors">刪除</button>
          </div>
        </div>
        ${closedBadgeHtml(s.case_closed_at)}
        ${attachmentsHtml ? `<div class="flex flex-wrap gap-2">${attachmentsHtml}</div>` : ''}
        ${replyHtml}
      `;
      li.querySelector('[data-toggle-closed]')?.addEventListener('click', async () => {
        const nextValue = s.case_closed_at ? null : new Date().toISOString();
        await supabase.from('student_suggestions').update({ case_closed_at: nextValue }).eq('id', s.id);
        loadSuggestions();
      });
      li.querySelectorAll<HTMLButtonElement>('[data-view-attachment]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const path = btn.dataset.viewAttachment!;
          const { data: signed, error } = await supabase.storage
            .from('suggestion-files')
            .createSignedUrl(path, 300);
          if (error || !signed) {
            alert(`無法取得附件連結：${error?.message ?? '未知錯誤'}`);
            return;
          }
          window.open(signed.signedUrl, '_blank');
        });
      });
      li.querySelectorAll<HTMLButtonElement>('[data-delete-attachment]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!confirm('確定要刪除這個附件嗎？無法復原。')) return;
          const path = btn.dataset.deleteAttachment!;
          const { error: removeError } = await supabase.storage.from('suggestion-files').remove([path]);
          if (removeError) {
            alert(`刪除失敗：${removeError.message}`);
            return;
          }
          const remainingPaths = (s.attachment_paths ?? []).filter((p: string) => p !== path);
          const { error: updateError } = await supabase
            .from('student_suggestions')
            .update({ attachment_paths: remainingPaths.length ? remainingPaths : null })
            .eq('id', s.id);
          if (updateError) {
            alert(`更新失敗：${updateError.message}`);
            return;
          }
          loadSuggestions();
        });
      });
      let stagedReplyFiles: File[] = [];
      const replyFileInput = li.querySelector<HTMLInputElement>('[data-reply-files]');
      const replyStagedList = li.querySelector('[data-reply-staged-list]');

      function renderStagedReplyFiles() {
        if (!replyStagedList) return;
        replyStagedList.innerHTML = stagedReplyFiles
          .map(
            (f, i) => `
            <span class="inline-flex items-center gap-1.5 border-2 border-ink px-2 py-1 text-xs">
              ${esc(f.name)}
              <button type="button" data-remove-staged-file="${i}" class="text-clay font-bold hover:underline">✕</button>
            </span>
          `
          )
          .join('');
        replyStagedList.querySelectorAll<HTMLButtonElement>('[data-remove-staged-file]').forEach((btn) => {
          btn.addEventListener('click', () => {
            stagedReplyFiles.splice(Number(btn.dataset.removeStagedFile), 1);
            renderStagedReplyFiles();
          });
        });
      }

      replyFileInput?.addEventListener('change', () => {
        const newFiles = Array.from(replyFileInput.files ?? []);
        if (stagedReplyFiles.length + newFiles.length > 5) {
          alert('附件最多只能選 5 個檔案。');
        } else {
          stagedReplyFiles.push(...newFiles);
        }
        replyFileInput.value = '';
        renderStagedReplyFiles();
      });

      li.querySelector('[data-send-reply]')?.addEventListener('click', async () => {
        const textarea = li.querySelector<HTMLTextAreaElement>('[data-reply-text]')!;
        const fileStatusEl = li.querySelector('[data-reply-file-status]');
        let replyText = textarea.value.trim();
        if (!replyText) {
          alert('請先輸入回覆內容。');
          return;
        }
        const files = stagedReplyFiles;
        const totalBytes = files.reduce((sum, f) => sum + f.size, 0);
        if (totalBytes > 3 * 1024 * 1024) {
          alert('附件總大小最多 3MB，請減少或壓縮檔案。');
          return;
        }
        if (!confirm(`確定要把這則回覆寄給 ${s.contact_email} 嗎？`)) return;

        if (fileStatusEl && files.length) fileStatusEl.textContent = `上傳中：${files.length} 個檔案...`;
        const uploadResults = await Promise.all(
          files.map((file) => {
            const path = `reply-${crypto.randomUUID()}${safeExt(file.name)}`;
            return supabase.storage
              .from('suggestion-files')
              .upload(path, file)
              .then(({ error }) => ({ path, name: file.name, error }));
          })
        );
        const failedUpload = uploadResults.find((r) => r.error);
        if (failedUpload) {
          alert(`附件上傳失敗：${failedUpload.error!.message}`);
          return;
        }
        const attachmentPaths = uploadResults.map((r) => r.path);
        if (fileStatusEl) fileStatusEl.textContent = '';

        if (uploadResults.length) {
          const links = await Promise.all(
            uploadResults.map(async ({ path, name }) => {
              const { data: signed } = await supabase.storage.from('suggestion-files').createSignedUrl(path, 60 * 60 * 24 * 7);
              return `<a href="${signed?.signedUrl ?? '#'}">${esc(name)}</a>`;
            })
          );
          replyText += '\n\n附件（連結 7 天內有效）：\n' + links.join('\n');
        }

        const { error } = await supabase.from('suggestion_messages').insert({
          suggestion_id: s.id,
          direction: 'outbound',
          body: replyText,
          attachment_paths: attachmentPaths.length ? attachmentPaths : null,
          status: 'pending',
        });
        if (error) {
          alert(`寄送失敗：${error.message}`);
        } else {
          alert('已開始寄送，稍後重新整理這頁查看寄送結果。');
        }
        loadSuggestions();
      });
      li.querySelector('[data-delete]')?.addEventListener('click', async () => {
        if (!confirm('確定要刪除這則意見嗎？')) return;
        const allPaths = [...(s.attachment_paths ?? []), ...thread.flatMap((m: any) => m.attachment_paths ?? [])];
        if (allPaths.length) {
          await supabase.storage.from('suggestion-files').remove(allPaths);
        }
        await supabase.from('student_suggestions').delete().eq('id', s.id);
        loadSuggestions();
      });
      suggestionList.appendChild(li);
    });
  }

  // ---------- 電子報 ----------
  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement;
  const newsletterId = document.getElementById('newsletter-id') as HTMLInputElement;
  const newsletterSubject = document.getElementById('newsletter-subject') as HTMLInputElement;
  const newsletterContent = document.getElementById('newsletter-content') as HTMLTextAreaElement;
  const newsletterTargets = document.getElementById('newsletter-targets') as HTMLTextAreaElement;
  const newsletterCancel = document.getElementById('newsletter-cancel')!;
  const newsletterStatus = document.getElementById('newsletter-status')!;
  const newsletterList = document.getElementById('newsletter-list')!;
  const subscriberCount = document.getElementById('subscriber-count')!;
  const subscriberList = document.getElementById('subscriber-list')!;

  let activeSubscriberCount = 0;

  function resetNewsletterForm() {
    newsletterForm.reset();
    newsletterId.value = '';
    newsletterCancel.classList.add('hidden');
  }

  newsletterCancel.addEventListener('click', resetNewsletterForm);

  function parseTargetEmails(): string[] | null {
    const lines = newsletterTargets.value
      .split(/[\n,]/)
      .map((v) => v.trim())
      .filter(Boolean);
    return lines.length ? lines : null;
  }

  newsletterForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      subject: newsletterSubject.value.trim(),
      content: newsletterContent.value.trim(),
      target_emails: parseTargetEmails(),
    };
    newsletterStatus.textContent = '儲存中...';
    const { error } = newsletterId.value
      ? await supabase.from('newsletters').update(payload).eq('id', newsletterId.value)
      : await supabase.from('newsletters').insert(payload);
    newsletterStatus.textContent = error ? `儲存失敗：${error.message}` : '已儲存草稿！';
    if (!error) {
      resetNewsletterForm();
      loadNewsletters();
    }
  });

  const newsletterStatusLabel: Record<string, string> = {
    draft: '草稿',
    sending: '寄送中...',
    sent: '已寄出',
  };

  async function loadNewsletters() {
    const { data } = await supabase.from('newsletters').select('*').order('created_at', { ascending: false });
    newsletterList.innerHTML = '';
    (data ?? []).forEach((n) => {
      const li = document.createElement('li');
      li.className = 'border-2 border-ink bg-cream p-4 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3';
      const canAct = n.status !== 'sending';
      const meta = n.status === 'sent'
        ? `上次於 ${fmtDate(n.sent_at)} 寄給 ${n.recipient_count ?? 0} 位收件人`
        : `${fmtDate(n.created_at)} · ${newsletterStatusLabel[n.status] ?? n.status}${n.target_emails?.length ? ` · 指定 ${n.target_emails.length} 位收件人` : ''}`;
      li.innerHTML = `
        <div class="min-w-0">
          <p class="text-xs text-ink-light mb-1">${esc(meta)}</p>
          <p class="font-semibold text-ink">${esc(n.subject)}</p>
        </div>
        <div class="flex gap-2 shrink-0">
          ${canAct ? '<button data-edit class="px-3 py-1 text-xs font-semibold border-2 border-ink hover:bg-ink hover:text-cream transition-colors">編輯</button>' : ''}
          ${canAct ? `<button data-send class="px-3 py-1 text-xs font-semibold border-2 border-sage-dark text-sage-dark hover:bg-sage-dark hover:text-cream transition-colors">${n.status === 'sent' ? '再次寄出' : '寄出'}</button>` : ''}
          <button data-delete class="px-3 py-1 text-xs font-semibold border-2 border-clay text-clay hover:bg-clay hover:text-cream transition-colors">刪除</button>
        </div>
      `;
      li.querySelector('[data-edit]')?.addEventListener('click', () => {
        newsletterId.value = n.id;
        newsletterSubject.value = n.subject;
        newsletterContent.value = n.content;
        newsletterTargets.value = (n.target_emails ?? []).join('\n');
        newsletterCancel.classList.remove('hidden');
        newsletterForm.scrollIntoView({ behavior: 'smooth' });
      });
      li.querySelector('[data-send]')?.addEventListener('click', async () => {
        const recipientDesc = n.target_emails?.length
          ? `指定的 ${n.target_emails.length} 位收件人`
          : `目前 ${activeSubscriberCount} 位訂閱者`;
        const resendNote = n.status === 'sent' ? '（這封之前已經寄過一次，這是再寄一次）' : '';
        if (!confirm(`確定要把「${n.subject}」寄給${recipientDesc}嗎？${resendNote}寄出後無法收回。`)) return;
        const { error } = await supabase.from('newsletters').update({ status: 'sending' }).eq('id', n.id);
        if (error) {
          alert(`寄送失敗：${error.message}`);
        } else {
          alert('已開始寄送，稍後重新整理這頁查看寄送結果。');
        }
        loadNewsletters();
      });
      li.querySelector('[data-delete]')?.addEventListener('click', async () => {
        if (!confirm(`確定要刪除「${n.subject}」嗎？`)) return;
        await supabase.from('newsletters').delete().eq('id', n.id);
        loadNewsletters();
      });
      newsletterList.appendChild(li);
    });
  }

  async function loadSubscribers() {
    const { data } = await supabase
      .from('newsletter_subscribers')
      .select('*')
      .order('subscribed_at', { ascending: false });
    const subscribers = data ?? [];
    activeSubscriberCount = subscribers.filter((s) => !s.unsubscribed_at).length;
    subscriberCount.textContent = `共 ${subscribers.length} 筆，其中 ${activeSubscriberCount} 位仍訂閱中`;
    subscriberList.innerHTML = '';
    subscribers.forEach((s) => {
      const li = document.createElement('li');
      li.className = 'border-2 border-ink bg-cream p-3 flex items-center justify-between gap-3';
      li.innerHTML = `
        <p class="text-sm text-ink min-w-0 truncate">${esc(s.email)} <span class="text-ink-light">· ${fmtDate(s.subscribed_at)}${s.unsubscribed_at ? '（已取消訂閱）' : ''}</span></p>
        <button data-delete class="px-3 py-1 text-xs font-semibold border-2 border-clay text-clay hover:bg-clay hover:text-cream transition-colors shrink-0">刪除</button>
      `;
      li.querySelector('[data-delete]')?.addEventListener('click', async () => {
        if (!confirm(`確定要刪除 ${s.email} 嗎？`)) return;
        await supabase.from('newsletter_subscribers').delete().eq('id', s.id);
        loadSubscribers();
      });
      subscriberList.appendChild(li);
    });
  }
</script>
