---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="寫文章" description="站長專用管理頁" noindex>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <div id="login-view">
      <p class="inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-6">寫文章</p>
      <h1 class="font-display text-3xl text-ink mb-6">登入管理後台</h1>
      <form id="login-form" class="grid gap-3 max-w-sm">
        <input
          type="email"
          id="login-email"
          required
          placeholder="yayalin322@gmail.com"
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
        <button type="submit" class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">
          寄送登入連結
        </button>
        <p id="login-status" class="text-sm min-h-5 text-ink-light"></p>
      </form>
    </div>

    <div id="admin-view" class="hidden">
      <div class="flex items-center justify-between mb-8">
        <h1 class="font-display text-3xl text-ink">管理後台</h1>
        <button id="logout-btn" class="px-4 py-1.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
          登出
        </button>
      </div>

      <div class="flex flex-wrap gap-2 mb-8">
        <button data-tab="posts" class="tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-ink text-cream">文章</button>
        <button data-tab="timeline" class="tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">時間軸</button>
        <button data-tab="quotes" class="tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">今日小語</button>
        <button data-tab="suggestions" class="tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">學生意見箱</button>
        <button data-tab="contact" class="tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">聯絡訊息</button>
        <button data-tab="pages" class="tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">頁面內容</button>
        <button data-tab="newsletter" class="tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">電子報</button>
        <a href="/write/surveys" data-magnetic class="px-4 py-1.5 text-sm font-semibold border-2 border-clay text-clay hover:bg-clay hover:text-cream transition-colors">問卷管理 →</a>
        <a href="/write/inbox" data-magnetic class="px-4 py-1.5 text-sm font-semibold border-2 border-clay text-clay hover:bg-clay hover:text-cream transition-colors">收件匣 →</a>
      </div>

      <!-- 文章 -->
      <section data-panel="posts">
        <form id="post-form" class="grid gap-3 mb-10 bg-sage-light border-2 border-ink p-6">
          <input type="hidden" id="post-id" />
          <input type="text" id="post-title" required placeholder="標題" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <input type="date" id="post-date" required class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none w-full" />
            <select id="post-category" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none w-full">
              <option>生活隨筆</option>
              <option>兒少議題</option>
              <option>興趣分享</option>
              <option>茶葉蛋</option>
            </select>
          </div>
          <textarea id="post-excerpt" required placeholder="摘要" rows="2" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none resize-none"></textarea>

          <input type="text" id="post-tags" placeholder="標籤，用逗號分隔（例如：兒少權益,新竹在地生活）" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />

          <div class="grid gap-2 bg-cream border-2 border-ink p-3">
            <label class="text-xs font-semibold text-ink-light">封面圖片（顯示在文章卡片與內頁最上方，選填）</label>
            <input type="hidden" id="post-cover-image" />
            <img id="post-cover-preview" class="hidden max-h-32 object-cover border-2 border-ink" alt="封面預覽" />
            <div class="flex flex-wrap items-center gap-3">
              <input type="file" id="post-cover-input" accept="image/png,image/jpeg,image/webp,image/gif" class="text-sm max-w-full" />
              <button type="button" id="post-cover-remove" class="hidden text-xs font-semibold text-clay underline">移除封面</button>
            </div>
            <p id="post-cover-status" class="text-xs text-ink-light min-h-4"></p>
          </div>

          <div class="grid gap-2 bg-cream border-2 border-ink p-3">
            <label class="text-xs font-semibold text-ink-light">插入圖片到內容（上傳後會把圖片網址加到下面內容欄位游標位置）</label>
            <input type="file" id="post-inline-image-input" accept="image/png,image/jpeg,image/webp,image/gif" class="text-sm max-w-full" />
            <p id="post-inline-image-status" class="text-xs text-ink-light min-h-4"></p>
          </div>

          <textarea id="post-body" required placeholder="內容（可以用 Markdown，例如 **粗體**、- 條列）" rows="10" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none"></textarea>
          <div class="flex gap-3">
            <button type="submit" class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">儲存文章</button>
            <button type="button" id="post-cancel" class="hidden px-6 py-2.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">取消編輯</button>
          </div>
          <p id="post-status" class="text-sm min-h-5"></p>
        </form>
        <ul id="post-list" class="grid gap-3"></ul>
      </section>

      <!-- 時間軸 -->
      <section data-panel="timeline" class="hidden">
        <form id="timeline-form" class="grid gap-3 mb-10 bg-clay-light border-2 border-ink p-6">
          <input type="hidden" id="timeline-id" />
          <input type="date" id="timeline-date" required class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />
          <input type="text" id="timeline-title" required placeholder="標題" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />
          <textarea id="timeline-description" required placeholder="說明" rows="3" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none resize-none"></textarea>

          <select id="timeline-proposal-status" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none">
            <option value="">不顯示狀態</option>
            <option value="提案中">提案中</option>
            <option value="已回應">已回應</option>
            <option value="已採納">已採納</option>
          </select>

          <textarea id="timeline-government-response" placeholder="縣府回應內容（選填，有回應再填）" rows="3" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none resize-none"></textarea>

          <input type="text" id="timeline-link" placeholder="相關連結網址（選填，例如新聞或會議紀錄連結）" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />

          <div class="grid gap-2 bg-cream border-2 border-ink p-3">
            <label class="text-xs font-semibold text-ink-light">提案文件 PDF（選填）</label>
            <input type="hidden" id="timeline-pdf" />
            <a id="timeline-pdf-preview" class="hidden text-sm font-semibold text-clay underline" target="_blank" rel="noopener noreferrer">目前的 PDF</a>
            <div class="flex flex-wrap items-center gap-3">
              <input type="file" id="timeline-pdf-input" accept="application/pdf" class="text-sm max-w-full" />
              <button type="button" id="timeline-pdf-remove" class="hidden text-xs font-semibold text-clay underline">移除 PDF</button>
            </div>
            <p id="timeline-pdf-status" class="text-xs text-ink-light min-h-4"></p>
          </div>

          <div class="flex gap-3">
            <button type="submit" class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">儲存項目</button>
            <button type="button" id="timeline-cancel" class="hidden px-6 py-2.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">取消編輯</button>
          </div>
          <p id="timeline-status" class="text-sm min-h-5"></p>
        </form>
        <ul id="timeline-list" class="grid gap-3"></ul>
      </section>

      <!-- 今日小語 -->
      <section data-panel="quotes" class="hidden">
        <form id="quote-form" class="grid gap-3 mb-10 bg-butter-light border-2 border-ink p-6">
          <input type="hidden" id="quote-id" />
          <input type="text" id="quote-text" required placeholder="一句話" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />
          <div class="flex gap-3">
            <button type="submit" class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">儲存小語</button>
            <button type="button" id="quote-cancel" class="hidden px-6 py-2.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">取消編輯</button>
          </div>
          <p id="quote-status" class="text-sm min-h-5"></p>
        </form>
        <ul id="quote-list" class="grid gap-3"></ul>
      </section>

      <!-- 學生意見箱 -->
      <section data-panel="suggestions" class="hidden">
        <div class="grid gap-2 mb-6 max-w-md">
          <label class="flex items-center gap-2 bg-cream border-2 border-ink p-4">
            <input type="checkbox" id="suggestion-collect-school" class="w-4 h-4" />
            <span class="text-sm text-ink">意見箱表單顯示「學校/年級」欄位（選填）</span>
          </label>
          <label class="flex items-center gap-2 bg-cream border-2 border-ink p-4">
            <input type="checkbox" id="suggestion-collect-contact" class="w-4 h-4" />
            <span class="text-sm text-ink">意見箱表單顯示「姓名（選填）/Email（必填）」欄位，方便你直接在後台回覆</span>
          </label>
        </div>
        <ul id="suggestion-list" class="grid gap-3"></ul>
      </section>

      <!-- 聯絡訊息 -->
      <section data-panel="contact" class="hidden">
        <ul id="contact-list" class="grid gap-3"></ul>
      </section>

      <!-- 頁面內容 -->
      <section data-panel="pages" class="hidden">
        <div class="flex flex-wrap gap-2 mb-6">
          <button data-page-slug="about" class="page-tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-ink text-cream">關於我</button>
          <button data-page-slug="privacy" class="page-tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">隱私權政策</button>
          <button data-page-slug="terms" class="page-tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">服務條款</button>
          <button data-page-slug="committee-intro" class="page-tab-btn px-4 py-1.5 text-sm font-semibold border-2 border-ink bg-cream text-ink">兒少代表說明</button>
        </div>
        <form id="page-form" class="grid gap-3 bg-butter-light border-2 border-ink p-6">
          <input type="text" id="page-title" required placeholder="頁面標題" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />
          <textarea id="page-content" required placeholder="內容（可以用 Markdown）" rows="14" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none"></textarea>
          <button type="submit" class="justify-self-start px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">儲存頁面</button>
          <p id="page-status" class="text-sm min-h-5"></p>
        </form>
      </section>

      <!-- 電子報 -->
      <section data-panel="newsletter" class="hidden">
        <form id="newsletter-form" class="grid gap-3 mb-10 bg-sage-light border-2 border-ink p-6">
          <input type="hidden" id="newsletter-id" />
          <input type="text" id="newsletter-subject" required placeholder="主旨" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />
          <textarea id="newsletter-content" required placeholder="內容（可以直接貼完整 HTML，或打一般文字也可以）" rows="12" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none font-mono text-sm"></textarea>
          <div class="grid gap-1 bg-cream border-2 border-ink p-3">
            <label class="text-xs font-semibold text-ink-light">指定收件人（選填，一行一個 Email；留空 = 寄給所有訂閱者）</label>
            <textarea id="newsletter-targets" placeholder="例如：teacher@example.com&#10;parent@example.com" rows="3" class="border-2 border-ink bg-cream px-3 py-2 focus:outline-none font-mono text-sm"></textarea>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">儲存草稿</button>
            <button type="button" id="newsletter-cancel" class="hidden px-6 py-2.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">取消編輯</button>
          </div>
          <p id="newsletter-status" class="text-sm min-h-5"></p>
        </form>
        <ul id="newsletter-list" class="grid gap-3 mb-12"></ul>

        <div class="border-t-2 border-ink pt-8">
          <h2 class="font-display text-xl text-ink mb-1">訂閱名單</h2>
          <p id="subscriber-count" class="text-sm text-ink-light mb-4"></p>
          <ul id="subscriber-list" class="grid gap-2"></ul>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const ADMIN_EMAIL = 'yayalin322@gmail.com';

  const loginView = document.getElementById('login-view')!;
  const adminView = document.getElementById('admin-view')!;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginEmail = document.getElementById('login-email') as HTMLInputElement;
  const loginStatus = document.getElementById('login-status')!;
  const logoutBtn = document.getElementById('logout-btn')!;

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginStatus.textContent = '寄送中...';
    const { error } = await supabase.auth.signInWithOtp({
      email: loginEmail.value.trim(),
      options: { shouldCreateUser: false, emailRedirectTo: window.location.origin + '/write' },
    });
    loginStatus.textContent = error
      ? '寄送失敗，請確認 Email 是否正確。'
      : '登入連結已寄出，請到信箱點連結（可能在垃圾信件夾）。';
  });

  logoutBtn.addEventListener('click', async () => {
    await supabase.auth.signOut();
  });

  async function renderForSession() {
    const { data } = await supabase.auth.getSession();
    const email = data.session?.user.email;
    if (email === ADMIN_EMAIL) {
      loginView.classList.add('hidden');
      adminView.classList.remove('hidden');
      loadAll();
    } else {
      loginView.classList.remove('hidden');
      adminView.classList.add('hidden');
    }
  }

  supabase.auth.onAuthStateChange(() => renderForSession());
  renderForSession();

  // ---------- tabs ----------
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabButtons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-ink', active);
        b.classList.toggle('text-cream', active);
        b.classList.toggle('bg-cream', !active);
        b.classList.toggle('text-ink', !active);
      });
      panels.forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== btn.dataset.tab));
    });
  });

  function loadAll() {
    loadPosts();
    loadTimeline();
    loadQuotes();
    loadContact();
    loadPages();
    loadSuggestions();
    loadNewsletters();
    loadSubscribers();
  }

  const fmtDate = (d: string) => new Date(d).toLocaleDateString('zh-Hant-TW');

  function esc(value: string) {
    const div = document.createElement('div');
    div.textContent = value ?? '';
    return div.innerHTML;
  }

  // 結案 30 天後會被自動清除（含附件），撤銷結案就會繼續保留。
  function closeToggleHtml(caseClosedAt: string | null) {
    return caseClosedAt
      ? `<button type="button" data-toggle-closed class="px-3 py-1 text-xs font-semibold border-2 border-sage-dark text-sage-dark hover:bg-sage-dark hover:text-cream transition-colors">撤銷結案</button>`
      : `<button type="button" data-toggle-closed class="px-3 py-1 text-xs font-semibold border-2 border-ink-light text-ink-light hover:bg-ink-light hover:text-cream transition-colors">結案</button>`;
  }

  function closedBadgeHtml(caseClosedAt: string | null) {
    if (!caseClosedAt) return '';
    const deleteDate = new Date(new Date(caseClosedAt).getTime() + 30 * 24 * 60 * 60 * 1000);
    return `<p class="text-xs text-clay">已結案，將於 ${fmtDate(deleteDate.toISOString())} 自動刪除（含附件），如需保留請按「撤銷結案」</p>`;
  }

  // Supabase Storage object keys only accept ASCII, so the original filename
  // (often in Chinese) can't be part of the storage path — keep the path to
  // a UUID + a safe extension, and use the real filename separately wherever
  // it needs to be shown to a person.
  function safeExt(name: string): string {
    const match = name.match(/\.([a-zA-Z0-9]{1,10})$/);
    return match ? `.${match[1].toLowerCase()}` : '';
  }

  // ---------- 圖片上傳 ----------
  const MAX_IMAGE_BYTES = 5 * 1024 * 1024;

  async function uploadImage(file: File): Promise<string | null> {
    if (file.size > MAX_IMAGE_BYTES) {
      alert('圖片太大了，請上傳 5MB 以下的圖片。');
      return null;
    }
    const ext = file.name.split('.').pop() ?? 'jpg';
    const path = `${crypto.randomUUID()}.${ext}`;
    const { error } = await supabase.storage.from('post-images').upload(path, file);
    if (error) {
      alert(`圖片上傳失敗：${error.message}`);
      return null;
    }
    const { data } = supabase.storage.from('post-images').getPublicUrl(path);
    return data.publicUrl;
  }

  // ---------- 文章 ----------
  const postForm = document.getElementById('post-form') as HTMLFormElement;
  const postId = document.getElementById('post-id') as HTMLInputElement;
  const postTitle = document.getElementById('post-title') as HTMLInputElement;
  const postDate = document.getElementById('post-date') as HTMLInputElement;
  const postCategory = document.getElementById('post-category') as HTMLSelectElement;
  const postExcerpt = document.getElementById('post-excerpt') as HTMLTextAreaElement;
  const postTags = document.getElementById('post-tags') as HTMLInputElement;
  const postBody = document.getElementById('post-body') as HTMLTextAreaElement;
  const postCoverImage = document.getElementById('post-cover-image') as HTMLInputElement;
  const postCoverPreview = document.getElementById('post-cover-preview') as HTMLImageElement;
  const postCoverInput = document.getElementById('post-cover-input') as HTMLInputElement;
  const postCoverRemove = document.getElementById('post-cover-remove')!;
  const postCoverStatus = document.getElementById('post-cover-status')!;
  const postInlineImageInput = document.getElementById('post-inline-image-input') as HTMLInputElement;
  const postInlineImageStatus = document.getElementById('post-inline-image-status')!;
  const postCancel = document.getElementById('post-cancel')!;
  const postStatus = document.getElementById('post-status')!;
  const postList = document.getElementById('post-list')!;

  function setCoverImage(url: string) {
    postCoverImage.value = url;
    postCoverPreview.src = url;
    postCoverPreview.classList.remove('hidden');
    postCoverRemove.classList.remove('hidden');
  }

  function clearCoverImage() {
    postCoverImage.value = '';
    postCoverPreview.src = '';
    postCoverPreview.classList.add('hidden');
    postCoverRemove.classList.add('hidden');
    postCoverInput.value = '';
  }

  postCoverInput.addEventListener('change', async () => {
    const file = postCoverInput.files?.[0];
    if (!file) return;
    postCoverStatus.textContent = '上傳中...';
    const url = await uploadImage(file);
    postCoverStatus.textContent = url ? '上傳完成！' : '';
    if (url) setCoverImage(url);
  });

  postCoverRemove.addEventListener('click', clearCoverImage);

  postInlineImageInput.addEventListener('change', async () => {
    const file = postInlineImageInput.files?.[0];
    if (!file) return;
    postInlineImageStatus.textContent = '上傳中...';
    const url = await uploadImage(file);
    postInlineImageStatus.textContent = url ? '已插入到內容裡！' : '';
    if (url) {
      const markdown = `![](${url})`;
      const start = postBody.selectionStart ?? postBody.value.length;
      const end = postBody.selectionEnd ?? postBody.value.length;
      postBody.value = postBody.value.slice(0, start) + markdown + postBody.value.slice(end);
      postBody.focus();
      postInlineImageInput.value = '';
    }
  });

  function resetPostForm() {
    postForm.reset();
    postId.value = '';
    postCancel.classList.add('hidden');
    clearCoverImage();
  }

  postCancel.addEventListener('click', resetPostForm);

  postForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      title: postTitle.value.trim(),
      date: postDate.value,
      category: postCategory.value,
      excerpt: postExcerpt.value.trim(),
      body: postBody.value.trim(),
      cover_image: postCoverImage.value || null,
      tags: postTags.value
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean),
    };
    postStatus.textContent = '儲存中...';
    const { error } = postId.value
      ? await supabase.from('blog_posts').update(payload).eq('id', postId.value)
      : await supabase.from('blog_posts').insert(payload);
    postStatus.textContent = error ? `儲存失敗：${error.message}` : '已儲存！';
    if (!error) {
      resetPostForm();
      loadPosts();
    }
  });

  async function loadPosts() {
    const { data } = await supabase.from('blog_posts').select('*').order('date', { ascending: false });
    postList.innerHTML = '';
    (data ?? []).forEach((post) => {
      const li = document.createElement('li');
      li.className = 'border-2 border-ink bg-cream p-4 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3';
      li.innerHTML = `
        <div class="min-w-0">
