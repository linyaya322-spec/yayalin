  const timelinePdf = document.getElementById('timeline-pdf') as HTMLInputElement;
  const timelinePdfPreview = document.getElementById('timeline-pdf-preview') as HTMLAnchorElement;
  const timelinePdfInput = document.getElementById('timeline-pdf-input') as HTMLInputElement;
  const timelinePdfRemove = document.getElementById('timeline-pdf-remove')!;
  const timelinePdfStatus = document.getElementById('timeline-pdf-status')!;
