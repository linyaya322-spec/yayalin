  // ---------- 頁面內容 ----------
  const pageForm = document.getElementById('page-form') as HTMLFormElement;
  const pageTitle = document.getElementById('page-title') as HTMLInputElement;
  const pageContent = document.getElementById('page-content') as HTMLTextAreaElement;
  const pageStatus = document.getElementById('page-status')!;
  const pageTabButtons = document.querySelectorAll<HTMLButtonElement>('.page-tab-btn');
  let pagesData: Record<string, { title: string; content: string }> = {};
  let currentPageSlug = 'about';

  function selectPageSlug(slug: string) {
    currentPageSlug = slug;
    pageTabButtons.forEach((b) => {
      const active = b.dataset.pageSlug === slug;
      b.classList.toggle('bg-ink', active);
      b.classList.toggle('text-cream', active);
      b.classList.toggle('bg-cream', !active);
      b.classList.toggle('text-ink', !active);
    });
    const page = pagesData[slug];
    pageTitle.value = page?.title ?? '';
    pageContent.value = page?.content ?? '';
  }

  pageTabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.dataset.pageSlug) selectPageSlug(btn.dataset.pageSlug);
    });
  });

  pageForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    pageStatus.textContent = '儲存中...';
    const { error } = await supabase.from('site_pages').upsert({
      slug: currentPageSlug,
      title: pageTitle.value.trim(),
      content: pageContent.value.trim(),
      updated_at: new Date().toISOString(),
    });
