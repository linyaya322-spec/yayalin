      date: timelineDate.value,
      title: timelineTitle.value.trim(),
      description: timelineDescription.value.trim(),
      status: timelineProposalStatus.value || null,
      government_response: timelineGovResponse.value.trim() || null,
      link_url: timelineLink.value.trim() || null,
      pdf_url: timelinePdf.value || null,
    };
    timelineStatus.textContent = '儲存中...';
    const { error } = timelineId.value
      ? await supabase.from('timeline_entries').update(payload).eq('id', timelineId.value)
      : await supabase.from('timeline_entries').insert(payload);
    timelineStatus.textContent = error ? `儲存失敗：${error.message}` : '已儲存！';
    if (!error) {
      resetTimelineForm();
      loadTimeline();
    }
  });

