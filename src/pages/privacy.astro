---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { marked } from 'marked';

const { data: page } = await supabase.from('site_pages').select('*').eq('slug', 'privacy').maybeSingle();

const title = page?.title ?? '隱私權政策';
const bodyHtml = page ? await marked.parse(page.content) : '<p>內容準備中。</p>';
---

<BaseLayout title="隱私權政策" description="yaya 林個人網站的隱私權政策。">
  <section class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <p class="reveal inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-6">政策</p>
    <h1 class="font-display text-4xl text-ink mb-8"><span data-text-reveal>{title}</span></h1>
    <div class="reveal prose-policy" style="animation-delay: 0.2s;" set:html={bodyHtml} />
  </section>
</BaseLayout>

<style>
  .prose-policy :global(h2) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: 1.35rem;
    margin-top: 1.75em;
    margin-bottom: 0.6em;
  }
  .prose-policy :global(p) {
    color: var(--color-ink-light);
    line-height: 1.9;
    margin-bottom: 1.1em;
  }
  .prose-policy :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
    color: var(--color-ink-light);
    margin-bottom: 1.1em;
  }
  .prose-policy :global(li) {
    margin-bottom: 0.4em;
  }
  .prose-policy :global(a) {
    color: var(--color-clay);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
