---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="問卷管理" description="站長專用問卷管理頁" noindex>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <div id="login-view">
      <p class="inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-6">問卷管理</p>
      <h1 class="font-display text-3xl text-ink mb-6">登入管理後台</h1>
      <form id="login-form" class="grid gap-3 max-w-sm">
        <input
          type="email"
          id="login-email"
          required
          placeholder="yayalin322@gmail.com"
          class="border-2 border-ink bg-cream px-4 py-2.5 text-ink placeholder:text-ink-light/70 focus:outline-none focus:bg-sage-light"
        />
        <button type="submit" class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">
          寄送登入連結
        </button>
        <p id="login-status" class="text-sm min-h-5 text-ink-light"></p>
      </form>
    </div>

    <div id="admin-view" class="hidden">
      <div class="flex items-center justify-between mb-8 no-print">
        <div>
          <a href="/write" data-magnetic class="text-sm font-semibold text-clay hover:text-ink transition-colors">← 回主控台</a>
          <h1 class="font-display text-3xl text-ink mt-2">問卷管理</h1>
        </div>
        <button id="logout-btn" class="px-4 py-1.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
          登出
        </button>
      </div>

      <!-- 問卷列表 -->
      <div id="survey-list-view">
        <button id="new-survey-btn" data-magnetic class="mb-6 px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">
          + 新增問卷
        </button>
        <ul id="survey-list" class="grid gap-3"></ul>
      </div>

      <!-- 編輯問卷 -->
      <div id="survey-edit-view" class="hidden">
        <button id="edit-back-btn" data-magnetic class="mb-6 text-sm font-semibold text-clay hover:text-ink transition-colors">← 回問卷列表</button>

        <form id="survey-form" class="grid gap-3 mb-8 bg-sage-light border-2 border-ink p-6">
          <input type="hidden" id="survey-id" />
          <input type="text" id="survey-title" required placeholder="問卷標題" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />
          <textarea id="survey-description" placeholder="問卷說明（選填）" rows="2" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none resize-none"></textarea>
          <label class="flex items-center gap-2">
            <input type="checkbox" id="survey-active" checked class="w-4 h-4" />
            <span class="text-sm text-ink">啟用（顯示在首頁與可公開填寫）</span>
          </label>

          <label class="grid gap-1 text-xs text-ink-light max-w-xs">
            填寫頁風格（影響按鈕、進度條顏色）
            <select id="survey-theme" class="border-2 border-ink bg-cream px-4 py-2 text-sm focus:outline-none">
              <option value="clay">磚紅（預設）</option>
              <option value="sage">草綠</option>
              <option value="butter">奶油黃</option>
              <option value="ink">沉穩黑</option>
            </select>
          </label>

          <div class="grid sm:grid-cols-2 gap-3">
            <label class="grid gap-1 text-xs text-ink-light">
              開放時間（選填，未到時間前訪客會看到「尚未開放」）
              <input type="datetime-local" id="survey-opens-at" class="border-2 border-ink bg-cream px-4 py-2 text-sm focus:outline-none" />
            </label>
            <label class="grid gap-1 text-xs text-ink-light">
              截止時間（選填，過了時間訪客會看到「已截止」，後台仍看得到）
              <input type="datetime-local" id="survey-closes-at" class="border-2 border-ink bg-cream px-4 py-2 text-sm focus:outline-none" />
            </label>
          </div>

          <input type="text" id="survey-link" placeholder="相關連結網址（選填）" class="border-2 border-ink bg-cream px-4 py-2 focus:outline-none" />

          <div class="grid gap-2 bg-cream border-2 border-ink p-3">
            <label class="text-xs font-semibold text-ink-light">相關 PDF 檔案（選填）</label>
            <input type="hidden" id="survey-pdf" />
            <a id="survey-pdf-preview" class="hidden text-sm font-semibold text-clay underline" target="_blank" rel="noopener noreferrer">目前的 PDF</a>
            <div class="flex flex-wrap items-center gap-3">
              <input type="file" id="survey-pdf-input" accept="application/pdf" class="text-sm max-w-full" />
              <button type="button" id="survey-pdf-remove" class="hidden text-xs font-semibold text-clay underline">移除 PDF</button>
            </div>
            <p id="survey-pdf-status" class="text-xs text-ink-light min-h-4"></p>
          </div>

          <div class="grid gap-3 bg-cream border-2 border-ink p-3">
            <label class="text-xs font-semibold text-ink-light">
              存取權限（⚠️ 這些都是「擋一般人」的防呆機制，不是真正的身分驗證，懂技術的人理論上能繞過，僅適合內部小範圍使用）
            </label>
            <select id="survey-access-mode" class="border-2 border-ink bg-cream px-3 py-2 text-sm focus:outline-none">
              <option value="public">公開（任何人都能填）</option>
              <option value="gmail_whitelist">Gmail 白名單</option>
              <option value="qr_code">限時 QR Code</option>
              <option value="password">限時密碼</option>
            </select>

            <!-- Gmail 白名單管理 -->
            <div id="access-gmail-panel" class="hidden grid gap-2">
              <p id="access-gmail-hint" class="text-xs text-clay"></p>
              <div id="access-gmail-list" class="grid gap-2"></div>
              <div class="flex flex-wrap gap-2">
                <input type="email" id="access-gmail-input" placeholder="新增 Gmail" class="flex-1 min-w-[10rem] border-2 border-ink bg-cream px-3 py-1.5 text-sm focus:outline-none" />
                <input type="number" id="access-gmail-max" value="1" min="1" class="w-20 border-2 border-ink bg-cream px-3 py-1.5 text-sm focus:outline-none" title="最多可填幾次" />
                <button type="button" id="access-gmail-add" class="px-3 py-1.5 text-xs font-semibold border-2 border-ink hover:bg-ink hover:text-cream transition-colors">+ 新增</button>
              </div>
            </div>

            <!-- QR Code -->
            <div id="access-qr-panel" class="hidden grid gap-2">
              <p id="access-qr-hint" class="text-xs text-clay"></p>
              <div class="flex flex-wrap items-center gap-2">
                <label class="text-xs text-ink-light">有效分鐘數：</label>
                <input type="number" id="access-qr-minutes" value="30" min="1" class="w-20 border-2 border-ink bg-cream px-3 py-1.5 text-sm focus:outline-none" />
                <button type="button" id="access-qr-generate" class="px-3 py-1.5 text-xs font-semibold border-2 border-ink hover:bg-ink hover:text-cream transition-colors">產生新的 QR Code</button>
              </div>
              <div id="access-qr-display" class="hidden grid gap-2">
                <img id="access-qr-image" class="w-40 h-40 border-2 border-ink" alt="QR Code" />
                <p id="access-qr-expiry" class="text-xs text-ink-light"></p>
              </div>
            </div>

            <!-- 限時密碼 -->
            <div id="access-password-panel" class="hidden grid gap-2">
              <p id="access-password-hint" class="text-xs text-clay"></p>
              <div class="flex flex-wrap items-center gap-2">
                <input type="text" id="access-password-input" placeholder="設定密碼" class="border-2 border-ink bg-cream px-3 py-1.5 text-sm focus:outline-none" />
                <label class="text-xs text-ink-light">有效分鐘數：</label>
                <input type="number" id="access-password-minutes" value="30" min="1" class="w-20 border-2 border-ink bg-cream px-3 py-1.5 text-sm focus:outline-none" />
                <button type="button" id="access-password-activate" class="px-3 py-1.5 text-xs font-semibold border-2 border-ink hover:bg-ink hover:text-cream transition-colors">啟用密碼</button>
              </div>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-3">
              <p class="font-semibold text-ink">題目</p>
              <button type="button" id="add-question-btn" class="px-4 py-1.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">+ 新增題目</button>
            </div>
            <div id="question-list" class="grid gap-4"></div>
          </div>

          <div class="flex flex-wrap gap-3">
            <button type="submit" class="px-6 py-2.5 bg-clay text-cream text-sm font-semibold hover:bg-ink transition-colors">儲存問卷</button>
            <button type="button" id="survey-preview-btn" class="px-6 py-2.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">👀 預覽</button>
            <button type="button" id="survey-print-btn" class="px-6 py-2.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">🖨️ 紙本問卷</button>
          </div>
          <p id="survey-form-status" class="text-sm min-h-5"></p>
        </form>
      </div>

      <!-- 預覽視窗 -->
      <div id="survey-preview-modal" class="hidden fixed inset-0 z-50 bg-ink/70 p-4 sm:p-8 overflow-y-auto">
        <div class="max-w-2xl mx-auto bg-cream border-2 border-ink">
          <div class="flex items-center justify-between p-4 border-b-2 border-ink bg-ink">
            <p class="text-cream font-semibold text-sm">預覽模式（不會被記錄，僅供檢查內容）</p>
            <button type="button" id="survey-preview-close" class="text-cream text-sm font-semibold hover:underline">✕ 關閉</button>
          </div>
          <div id="survey-preview-body" class="p-6 sm:p-8"></div>
        </div>
      </div>

      <!-- 回覆統計 -->
      <div id="survey-stats-view" class="hidden">
        <button id="stats-back-btn" data-magnetic class="mb-6 text-sm font-semibold text-clay hover:text-ink transition-colors no-print">← 回問卷列表</button>

        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 no-print">
          <h2 id="stats-title" class="font-display text-2xl text-ink"></h2>
          <div class="flex flex-wrap gap-2">
            <button id="copy-link-btn" class="px-4 py-1.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">複製問卷連結</button>
            <button id="export-csv-btn" class="px-4 py-1.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">匯出 CSV</button>
            <button id="print-btn" class="px-4 py-1.5 border-2 border-ink text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">列印 / 存成 PDF</button>
            <button id="compare-btn" class="px-4 py-1.5 border-2 border-clay text-clay text-sm font-semibold hover:bg-clay hover:text-cream transition-colors">跟另一份問卷比較</button>
          </div>
        </div>
        <p id="copy-link-status" class="text-sm text-ink-light mb-4 no-print"></p>

        <div id="stats-report">
          <h2 id="stats-report-title" class="font-display text-2xl text-ink mb-1 print-only"></h2>
          <p id="stats-count" class="text-ink-light mb-6"></p>

          <!-- 完成率 -->
          <div id="completion-summary" class="grid sm:grid-cols-3 gap-3 mb-6"></div>

          <!-- 回覆趨勢 -->
          <div id="trend-chart" class="mb-8"></div>

          <!-- 交叉分析篩選 -->
          <div id="crosstab-controls" class="hidden flex flex-wrap items-center gap-2 mb-6 no-print bg-butter-light border-2 border-ink p-4">
            <label class="text-sm font-semibold text-ink">交叉分析：</label>
            <select id="crosstab-question" class="border-2 border-ink bg-cream px-3 py-1.5 text-sm focus:outline-none">
              <option value="">不篩選</option>
            </select>
            <select id="crosstab-option" class="hidden border-2 border-ink bg-cream px-3 py-1.5 text-sm focus:outline-none">
              <option value="">全部</option>
            </select>
            <span id="crosstab-summary" class="text-sm text-ink-light"></span>
          </div>

          <div id="stats-content" class="grid gap-5"></div>
        </div>
      </div>

      <!-- 問卷比較 -->
      <div id="survey-compare-view" class="hidden">
        <button id="compare-back-btn" data-magnetic class="mb-6 text-sm font-semibold text-clay hover:text-ink transition-colors">← 回問卷列表</button>
        <div class="flex flex-wrap gap-3 mb-6 bg-cream border-2 border-ink p-4">
          <label class="flex items-center gap-2 text-sm">
            A：
            <select id="compare-survey-a" class="border-2 border-ink bg-cream px-3 py-1.5 focus:outline-none"></select>
          </label>
          <label class="flex items-center gap-2 text-sm">
            B：
            <select id="compare-survey-b" class="border-2 border-ink bg-cream px-3 py-1.5 focus:outline-none"></select>
          </label>
        </div>
        <p class="text-xs text-ink-light mb-4">比較是依「題目順序」對齊，適合用在結構相同的兩份問卷（例如學生版跟家長版）。</p>
        <div id="compare-content" class="grid gap-6"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .print-only {
    display: none;
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .print-only {
      display: block !important;
    }
    #survey-list-view,
    #survey-edit-view,
    #login-view {
      display: none !important;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import type { Survey, SurveyQuestion, SurveyOption } from '../../lib/supabase';

  const ADMIN_EMAIL = 'yayalin322@gmail.com';

  const loginView = document.getElementById('login-view')!;
  const adminView = document.getElementById('admin-view')!;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginEmail = document.getElementById('login-email') as HTMLInputElement;
  const loginStatus = document.getElementById('login-status')!;
  const logoutBtn = document.getElementById('logout-btn')!;

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginStatus.textContent = '寄送中...';
    const { error } = await supabase.auth.signInWithOtp({
      email: loginEmail.value.trim(),
      options: { shouldCreateUser: false, emailRedirectTo: window.location.origin + '/write/surveys' },
    });
    loginStatus.textContent = error
      ? '寄送失敗，請確認 Email 是否正確。'
      : '登入連結已寄出，請到信箱點連結（可能在垃圾信件夾）。';
  });

  logoutBtn.addEventListener('click', async () => {
    await supabase.auth.signOut();
  });

  async function renderForSession() {
    const { data } = await supabase.auth.getSession();
    const email = data.session?.user.email;
    if (email === ADMIN_EMAIL) {
      loginView.classList.add('hidden');
      adminView.classList.remove('hidden');
      loadSurveyList();
    } else {
      loginView.classList.remove('hidden');
      adminView.classList.add('hidden');
    }
  }

  supabase.auth.onAuthStateChange(() => renderForSession());
  renderForSession();

  function esc(value: string) {
    const div = document.createElement('div');
    div.textContent = value ?? '';
    return div.innerHTML;
  }

  const fmtDate = (d: string) => new Date(d).toLocaleDateString('zh-Hant-TW');

  // 結案 30 天後，這份問卷的所有回覆會被自動清空（問卷本身跟題目會保留），撤銷結案就會繼續保留。
  function closeToggleHtml(caseClosedAt: string | null) {
    return caseClosedAt
      ? `<button type="button" data-toggle-closed class="px-3 py-1 text-xs font-semibold border-2 border-sage-dark text-sage-dark hover:bg-sage-dark hover:text-cream transition-colors">撤銷結案</button>`
      : `<button type="button" data-toggle-closed class="px-3 py-1 text-xs font-semibold border-2 border-ink-light text-ink-light hover:bg-ink-light hover:text-cream transition-colors">結案</button>`;
  }

  function closedBadgeHtml(caseClosedAt: string | null) {
    if (!caseClosedAt) return '';
    const deleteDate = new Date(new Date(caseClosedAt).getTime() + 30 * 24 * 60 * 60 * 1000);
    return `<p class="text-xs text-clay mt-1">已結案，將於 ${fmtDate(deleteDate.toISOString())} 自動清空所有回覆，如需保留請按「撤銷結案」</p>`;
  }

  function toLocalInputValue(iso: string | null) {
    if (!iso) return '';
    const d = new Date(iso);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  // ---------- 視圖切換 ----------
  const listView = document.getElementById('survey-list-view')!;
  const editView = document.getElementById('survey-edit-view')!;
  const statsView = document.getElementById('survey-stats-view')!;
  const compareView = document.getElementById('survey-compare-view')!;

  function showView(view: 'list' | 'edit' | 'stats' | 'compare') {
    listView.classList.toggle('hidden', view !== 'list');
    editView.classList.toggle('hidden', view !== 'edit');
    statsView.classList.toggle('hidden', view !== 'stats');
    compareView.classList.toggle('hidden', view !== 'compare');
  }

  document.getElementById('edit-back-btn')?.addEventListener('click', () => showView('list'));
  document.getElementById('stats-back-btn')?.addEventListener('click', () => showView('list'));
  document.getElementById('compare-back-btn')?.addEventListener('click', () => showView('list'));

  // ---------- 問卷列表 ----------
  const surveyList = document.getElementById('survey-list')!;

  async function loadSurveyList() {
    const { data: surveys } = await supabase.from('surveys').select('*').order('created_at', { ascending: false });
    surveyList.innerHTML = '';
    (surveys ?? []).forEach((survey) => {
      const now = Date.now();
      let scheduleLabel = survey.is_active ? '已啟用' : '已停用';
      if (survey.closes_at && new Date(survey.closes_at).getTime() < now) scheduleLabel = '已截止';
      else if (survey.opens_at && new Date(survey.opens_at).getTime() > now) scheduleLabel = '尚未開放';

      const li = document.createElement('li');
      li.className = 'border-2 border-ink bg-cream p-4 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3';
      li.innerHTML = `
        <div class="min-w-0">
          <p class="text-xs text-ink-light mb-1">${fmtDate(survey.created_at)} · ${scheduleLabel}</p>
          <p class="font-semibold text-ink">${esc(survey.title)}</p>
          ${closedBadgeHtml(survey.case_closed_at)}
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <button data-stats class="px-3 py-1 text-xs font-semibold border-2 border-sage-dark text-sage-dark hover:bg-sage-dark hover:text-cream transition-colors">回覆統計</button>
          <button data-edit class="px-3 py-1 text-xs font-semibold border-2 border-ink hover:bg-ink hover:text-cream transition-colors">編輯</button>
          ${closeToggleHtml(survey.case_closed_at)}
          <button data-clear class="px-3 py-1 text-xs font-semibold border-2 border-butter text-clay hover:bg-butter hover:text-ink transition-colors">清空回覆</button>
          <button data-delete class="px-3 py-1 text-xs font-semibold border-2 border-clay text-clay hover:bg-clay hover:text-cream transition-colors">刪除問卷</button>
        </div>
      `;
      li.querySelector('[data-edit]')?.addEventListener('click', () => openEditView(survey));
      li.querySelector('[data-stats]')?.addEventListener('click', () => openStatsView(survey));
      li.querySelector('[data-toggle-closed]')?.addEventListener('click', async () => {
        const nextValue = survey.case_closed_at ? null : new Date().toISOString();
        await supabase.from('surveys').update({ case_closed_at: nextValue }).eq('id', survey.id);
        loadSurveyList();
      });
      li.querySelector('[data-clear]')?.addEventListener('click', async () => {
        if (!confirm(`確定要清空「${survey.title}」的所有填答資料嗎？問卷本身跟題目會保留，只刪除回覆紀錄，無法復原。`)) return;
        await supabase.from('survey_responses').delete().eq('survey_id', survey.id);
        await supabase.from('survey_progress').delete().eq('survey_id', survey.id);
        alert('已清空這份問卷的所有填答資料。');
      });
      li.querySelector('[data-delete]')?.addEventListener('click', async () => {
        if (!confirm(`確定要刪除「${survey.title}」嗎？連同所有回覆一起刪除，無法復原。`)) return;
        await supabase.from('surveys').delete().eq('id', survey.id);
        loadSurveyList();
      });
      surveyList.appendChild(li);
    });
  }

  // ---------- 編輯問卷（含建題） ----------
  const surveyForm = document.getElementById('survey-form') as HTMLFormElement;
  const surveyIdInput = document.getElementById('survey-id') as HTMLInputElement;
  const surveyTitleInput = document.getElementById('survey-title') as HTMLInputElement;
  const surveyDescriptionInput = document.getElementById('survey-description') as HTMLTextAreaElement;
  const surveyActiveInput = document.getElementById('survey-active') as HTMLInputElement;
  const surveyThemeSelect = document.getElementById('survey-theme') as HTMLSelectElement;
  const surveyOpensAtInput = document.getElementById('survey-opens-at') as HTMLInputElement;
  const surveyClosesAtInput = document.getElementById('survey-closes-at') as HTMLInputElement;
  const surveyLinkInput = document.getElementById('survey-link') as HTMLInputElement;
  const surveyPdfInput = document.getElementById('survey-pdf') as HTMLInputElement;
  const surveyPdfPreview = document.getElementById('survey-pdf-preview') as HTMLAnchorElement;
  const surveyPdfFileInput = document.getElementById('survey-pdf-input') as HTMLInputElement;
  const surveyPdfRemoveBtn = document.getElementById('survey-pdf-remove')!;
  const surveyPdfStatus = document.getElementById('survey-pdf-status')!;
  const questionList = document.getElementById('question-list')!;
  const surveyFormStatus = document.getElementById('survey-form-status')!;

  const surveyAccessModeSelect = document.getElementById('survey-access-mode') as HTMLSelectElement;
  const accessGmailPanel = document.getElementById('access-gmail-panel')!;
  const accessGmailHint = document.getElementById('access-gmail-hint')!;
  const accessGmailList = document.getElementById('access-gmail-list')!;
  const accessGmailInput = document.getElementById('access-gmail-input') as HTMLInputElement;
  const accessGmailMaxInput = document.getElementById('access-gmail-max') as HTMLInputElement;
  const accessGmailAddBtn = document.getElementById('access-gmail-add')!;
  const accessQrPanel = document.getElementById('access-qr-panel')!;
  const accessQrHint = document.getElementById('access-qr-hint')!;
  const accessQrMinutesInput = document.getElementById('access-qr-minutes') as HTMLInputElement;
  const accessQrGenerateBtn = document.getElementById('access-qr-generate')!;
  const accessQrDisplay = document.getElementById('access-qr-display')!;
  const accessQrImage = document.getElementById('access-qr-image') as HTMLImageElement;
  const accessQrExpiry = document.getElementById('access-qr-expiry')!;
  const accessPasswordPanel = document.getElementById('access-password-panel')!;
  const accessPasswordHint = document.getElementById('access-password-hint')!;
  const accessPasswordInput = document.getElementById('access-password-input') as HTMLInputElement;
  const accessPasswordMinutesInput = document.getElementById('access-password-minutes') as HTMLInputElement;
  const accessPasswordActivateBtn = document.getElementById('access-password-activate')!;

  function syncAccessPanels() {
    const mode = surveyAccessModeSelect.value;
    accessGmailPanel.classList.toggle('hidden', mode !== 'gmail_whitelist');
    accessQrPanel.classList.toggle('hidden', mode !== 'qr_code');
    accessPasswordPanel.classList.toggle('hidden', mode !== 'password');
    const needsSaveFirst = !surveyIdInput.value;
    const hint = needsSaveFirst ? '請先儲存問卷一次，才能設定這個功能。' : '';
    accessGmailHint.textContent = hint;
    accessQrHint.textContent = hint;
    accessPasswordHint.textContent = hint;
  }
  surveyAccessModeSelect.addEventListener('change', syncAccessPanels);

  async function loadAllowedEmails() {
    const surveyId = surveyIdInput.value;
    if (!surveyId) return;
    const { data } = await supabase
      .from('survey_allowed_emails')
      .select('*')
      .eq('survey_id', surveyId)
      .order('created_at', { ascending: true });
    accessGmailList.innerHTML = '';
    (data ?? []).forEach((row) => {
      const li = document.createElement('div');
      li.className = 'flex items-center justify-between gap-2 bg-sage-light border-2 border-ink px-3 py-2 text-sm';
      li.innerHTML = `
        <span class="text-ink">${esc(row.email)}　<span class="text-ink-light">已填 ${row.used_count} / ${row.max_submissions} 次</span></span>
        <div class="flex gap-2 shrink-0">
          <button data-bump class="text-xs font-semibold text-clay underline">+1 次數</button>
          <button data-remove-email class="text-xs font-semibold text-clay underline">移除</button>
        </div>
      `;
      li.querySelector('[data-bump]')?.addEventListener('click', async () => {
        await supabase
          .from('survey_allowed_emails')
          .update({ max_submissions: row.max_submissions + 1 })
          .eq('id', row.id);
        loadAllowedEmails();
      });
      li.querySelector('[data-remove-email]')?.addEventListener('click', async () => {
        if (!confirm(`移除 ${row.email} 嗎？`)) return;
        await supabase.from('survey_allowed_emails').delete().eq('id', row.id);
        loadAllowedEmails();
      });
      accessGmailList.appendChild(li);
    });
  }

  accessGmailAddBtn.addEventListener('click', async () => {
    const surveyId = surveyIdInput.value;
    if (!surveyId) return;
    const email = accessGmailInput.value.trim().toLowerCase();
    if (!email) return;
    const maxSubmissions = Math.max(1, Number(accessGmailMaxInput.value) || 1);
    const { error } = await supabase
      .from('survey_allowed_emails')
      .insert({ survey_id: surveyId, email, max_submissions: maxSubmissions });
    if (error) {
      alert(`新增失敗：${error.message}`);
      return;
    }
    accessGmailInput.value = '';
    accessGmailMaxInput.value = '1';
    loadAllowedEmails();
  });

  accessQrGenerateBtn.addEventListener('click', async () => {
    const surveyId = surveyIdInput.value;
    if (!surveyId) return;
    const minutes = Math.max(1, Number(accessQrMinutesInput.value) || 30);
    const token = crypto.randomUUID();
    const expiresAt = new Date(Date.now() + minutes * 60000).toISOString();
    const { error } = await supabase
      .from('surveys')
      .update({ qr_token: token, qr_token_expires_at: expiresAt })
      .eq('id', surveyId);
    if (error) {
      alert(`產生失敗：${error.message}`);
      return;
    }
    const surveyUrl = `${window.location.origin}/survey/${surveyId}?qr=${token}`;
    accessQrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(surveyUrl)}`;
    accessQrExpiry.textContent = `有效至：${new Date(expiresAt).toLocaleString('zh-Hant-TW')}（連結：${surveyUrl}）`;
    accessQrDisplay.classList.remove('hidden');
  });

  accessPasswordActivateBtn.addEventListener('click', async () => {
    const surveyId = surveyIdInput.value;
    if (!surveyId) return;
    const password = accessPasswordInput.value.trim();
    if (!password) {
      alert('請先輸入密碼');
      return;
    }
    const minutes = Math.max(1, Number(accessPasswordMinutesInput.value) || 30);
    const expiresAt = new Date(Date.now() + minutes * 60000).toISOString();
    const { error } = await supabase
      .from('surveys')
      .update({ access_password: password, access_password_expires_at: expiresAt })
      .eq('id', surveyId);
    if (error) {
      alert(`啟用失敗：${error.message}`);
      return;
    }
    alert(`密碼已啟用，有效至 ${new Date(expiresAt).toLocaleString('zh-Hant-TW')}`);
  });

  let removedQuestionIds: string[] = [];

  function setSurveyPdf(url: string) {
    surveyPdfInput.value = url;
    surveyPdfPreview.href = url;
    surveyPdfPreview.classList.remove('hidden');
    surveyPdfRemoveBtn.classList.remove('hidden');
  }

  function clearSurveyPdf() {
    surveyPdfInput.value = '';
    surveyPdfPreview.href = '';
    surveyPdfPreview.classList.add('hidden');
    surveyPdfRemoveBtn.classList.add('hidden');
    surveyPdfFileInput.value = '';
  }

  surveyPdfFileInput.addEventListener('change', async () => {
    const file = surveyPdfFileInput.files?.[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) {
      alert('檔案太大了，請上傳 10MB 以下的 PDF。');
      return;
    }
    surveyPdfStatus.textContent = '上傳中...';
    const path = `${crypto.randomUUID()}.pdf`;
    const { error } = await supabase.storage.from('timeline-files').upload(path, file);
    if (error) {
      alert(`PDF 上傳失敗：${error.message}`);
      surveyPdfStatus.textContent = '';
      return;
    }
    const { data } = supabase.storage.from('timeline-files').getPublicUrl(path);
    surveyPdfStatus.textContent = '上傳完成！';
    setSurveyPdf(data.publicUrl);
  });

  surveyPdfRemoveBtn.addEventListener('click', clearSurveyPdf);

  function createOptionRow(option?: SurveyOption) {
    const row = document.createElement('div');
    row.className = 'grid gap-1.5';
    row.dataset.optionId = option?.id ?? crypto.randomUUID();
    row.innerHTML = `
      <div class="flex items-center gap-2">
        <input type="checkbox" data-option-correct class="w-4 h-4 shrink-0" title="標準答案" ${option?.correct ? 'checked' : ''} />
        <input type="text" data-option-text placeholder="選項內容" value="${esc(option?.text ?? '')}" class="flex-1 border-2 border-ink bg-cream px-3 py-1.5 focus:outline-none" />
        <button type="button" data-remove-option class="text-clay text-sm font-semibold shrink-0">移除</button>
      </div>
      <div class="flex flex-wrap items-center gap-3 pl-6 text-xs text-ink-light">
        <label class="flex items-center gap-1.5">
          <input type="checkbox" data-option-other class="w-4 h-4" ${option?.isOther ? 'checked' : ''} />
          其他（自由輸入文字）
        </label>
        <label data-option-goto-wrapper class="hidden items-center gap-1.5">
          跳題：
          <select data-option-goto class="border-2 border-ink bg-cream px-2 py-1 focus:outline-none"></select>
        </label>
      </div>
    `;
    row.querySelector('[data-remove-option]')?.addEventListener('click', () => {
      row.remove();
      refreshAllGotoSelects();
    });
    const gotoSelect = row.querySelector('[data-option-goto]') as HTMLSelectElement;
    (gotoSelect as any)._pendingValue = option?.goto ?? '';
    return row;
  }

  function refreshAllGotoSelects() {
    const blocks = Array.from(questionList.children) as HTMLElement[];
    const positionById = new Map(blocks.map((b, i) => [b.dataset.questionId, i + 1]));
    blocks.forEach((block, index) => {
      const numberEl = block.querySelector('[data-question-number]');
      if (numberEl) numberEl.textContent = String(index + 1);
      block.querySelectorAll<HTMLSelectElement>('[data-option-goto]').forEach((sel) => {
        const pending = (sel as any)._pendingValue ?? sel.value;
        const optionsHtml = [
          '<option value="">（依序繼續下一題）</option>',
          ...blocks
            .filter((_, i) => i !== index)
            .map((b) => `<option value="${b.dataset.questionId}">跳到第 ${positionById.get(b.dataset.questionId)} 題</option>`),
          '<option value="__submit__">直接送出問卷</option>',
          '<option value="__close__">結束問卷（不記錄這次填答）</option>',
        ].join('');
        sel.innerHTML = optionsHtml;
        if ([...sel.options].some((o) => o.value === pending)) sel.value = pending;
        (sel as any)._pendingValue = undefined;
      });
    });
  }

  function createQuestionBlock(question?: SurveyQuestion) {
    const block = document.createElement('div');
    block.className = 'border-2 border-ink bg-cream p-4 grid gap-3';
    block.dataset.questionId = question?.id ?? crypto.randomUUID();
    block.dataset.existing = question ? 'true' : 'false';

    block.innerHTML = `
      <div class="flex flex-wrap gap-3 items-center">
        <span data-question-number class="shrink-0 w-7 h-7 grid place-items-center bg-ink text-cream text-xs font-semibold rounded-full"></span>
        <input type="text" data-question-text placeholder="題目內容" value="${esc(question?.question_text ?? '')}" required class="flex-1 min-w-[12rem] border-2 border-ink bg-cream px-3 py-1.5 focus:outline-none" />
        <select data-question-type class="border-2 border-ink bg-cream px-3 py-1.5 focus:outline-none">
          <option value="text">簡答</option>
          <option value="single">單選</option>
          <option value="multiple">複選</option>
        </select>
        <label class="flex items-center gap-1.5 text-sm">
          <input type="checkbox" data-question-required ${question?.required ? 'checked' : ''} class="w-4 h-4" />
          必填
        </label>
        <button type="button" data-remove-question class="text-clay text-sm font-semibold">刪除題目</button>
      </div>
      <div data-options-wrapper class="hidden grid gap-2 pl-2 border-l-4 border-ink/20">
        <div data-options-list class="grid gap-3"></div>
        <button type="button" data-add-option class="justify-self-start text-sm font-semibold text-clay">+ 新增選項</button>
        <p class="text-xs text-ink-light">「標準答案」選填，設定後統計顯示答對率；「跳題」只在單選題生效。</p>
      </div>
    `;

    const typeSelect = block.querySelector('[data-question-type]') as HTMLSelectElement;
    const optionsWrapper = block.querySelector('[data-options-wrapper]') as HTMLElement;
    const optionsList = block.querySelector('[data-options-list]') as HTMLElement;

    typeSelect.value = question?.type ?? 'text';
    const syncOptionsVisibility = () => {
      optionsWrapper.classList.toggle('hidden', typeSelect.value === 'text');
      block.querySelectorAll<HTMLElement>('[data-option-goto-wrapper]').forEach((w) => {
        w.classList.toggle('hidden', typeSelect.value !== 'single');
        w.classList.toggle('flex', typeSelect.value === 'single');
      });
    };
    typeSelect.addEventListener('change', syncOptionsVisibility);
    syncOptionsVisibility();

    if (question?.options?.length) {
      question.options.forEach((opt) => optionsList.appendChild(createOptionRow(opt)));
      syncOptionsVisibility();
    }

    block.querySelector('[data-add-option]')?.addEventListener('click', () => {
      optionsList.appendChild(createOptionRow());
      refreshAllGotoSelects();
      syncOptionsVisibility();
    });

    block.querySelector('[data-remove-question]')?.addEventListener('click', () => {
      if (block.dataset.existing === 'true') removedQuestionIds.push(block.dataset.questionId!);
      block.remove();
      refreshAllGotoSelects();
    });

    return block;
  }

  document.getElementById('add-question-btn')?.addEventListener('click', () => {
    questionList.appendChild(createQuestionBlock());
    refreshAllGotoSelects();
  });

  function resetSurveyForm() {
    surveyForm.reset();
    surveyIdInput.value = '';
    questionList.innerHTML = '';
    removedQuestionIds = [];
    clearSurveyPdf();
    surveyThemeSelect.value = 'clay';
    surveyAccessModeSelect.value = 'public';
    accessGmailList.innerHTML = '';
    accessQrDisplay.classList.add('hidden');
    accessPasswordInput.value = '';
    syncAccessPanels();
  }

  document.getElementById('new-survey-btn')?.addEventListener('click', () => {
    resetSurveyForm();
    showView('edit');
  });

  async function openEditView(survey: Survey) {
    resetSurveyForm();
    surveyIdInput.value = survey.id;
    surveyTitleInput.value = survey.title;
    surveyDescriptionInput.value = survey.description ?? '';
    surveyActiveInput.checked = survey.is_active;
    surveyThemeSelect.value = survey.theme ?? 'clay';
    surveyOpensAtInput.value = toLocalInputValue(survey.opens_at);
    surveyClosesAtInput.value = toLocalInputValue(survey.closes_at);
    surveyLinkInput.value = survey.link_url ?? '';
    if (survey.pdf_url) setSurveyPdf(survey.pdf_url);

    surveyAccessModeSelect.value = survey.access_mode;
    syncAccessPanels();
    if (survey.access_mode === 'gmail_whitelist') loadAllowedEmails();
    if (survey.access_mode === 'qr_code' && survey.qr_token && survey.qr_token_expires_at) {
      const surveyUrl = `${window.location.origin}/survey/${survey.id}?qr=${survey.qr_token}`;
      accessQrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(surveyUrl)}`;
      const stillValid = new Date(survey.qr_token_expires_at).getTime() > Date.now();
      accessQrExpiry.textContent = `${stillValid ? '有效至' : '已過期（'}${new Date(survey.qr_token_expires_at).toLocaleString('zh-Hant-TW')}${stillValid ? '' : '）'}：${surveyUrl}`;
      accessQrDisplay.classList.remove('hidden');
    }
    if (survey.access_mode === 'password' && survey.access_password) {
      accessPasswordInput.value = survey.access_password;
      const stillValid = survey.access_password_expires_at && new Date(survey.access_password_expires_at).getTime() > Date.now();
      accessPasswordHint.textContent = stillValid
        ? `目前密碼有效至 ${new Date(survey.access_password_expires_at!).toLocaleString('zh-Hant-TW')}`
        : '目前密碼已過期，需要重新啟用。';
    }

    const { data: questions } = await supabase
      .from('survey_questions')
      .select('*')
      .eq('survey_id', survey.id)
      .order('position', { ascending: true });
    (questions ?? []).forEach((q) => questionList.appendChild(createQuestionBlock(q)));
    refreshAllGotoSelects();

    showView('edit');
  }

  function collectQuestionRows(surveyIdForRows: string | null) {
    const questionBlocks = Array.from(questionList.children) as HTMLElement[];
    return questionBlocks.map((block, index) => {
      const type = (block.querySelector('[data-question-type]') as HTMLSelectElement).value;
      const options =
        type === 'text'
          ? []
          : Array.from(block.querySelectorAll('[data-options-list] > div')).map((row) => {
              const el = row as HTMLElement;
              const gotoValue =
                type === 'single' ? (el.querySelector('[data-option-goto]') as HTMLSelectElement).value : '';
              return {
                id: el.dataset.optionId,
                text: (el.querySelector('[data-option-text]') as HTMLInputElement).value.trim(),
                correct: (el.querySelector('[data-option-correct]') as HTMLInputElement).checked,
                isOther: (el.querySelector('[data-option-other]') as HTMLInputElement).checked,
                goto: gotoValue || null,
              };
            });
      return {
        id: block.dataset.questionId,
        survey_id: surveyIdForRows,
        position: index,
        question_text: (block.querySelector('[data-question-text]') as HTMLInputElement).value.trim(),
        type,
        required: (block.querySelector('[data-question-required]') as HTMLInputElement).checked,
        options,
      };
    });
  }

  const SURVEY_THEME_COLORS: Record<string, string> = {
    clay: '#e2481f',
    sage: '#3f7a4a',
    butter: '#f2b705',
    ink: '#1c1c1a',
  };

  // ---------- 預覽模式 ----------
  const previewModal = document.getElementById('survey-preview-modal')!;
  const previewBody = document.getElementById('survey-preview-body')!;

  function renderQuestionPreviewHtml(rows: ReturnType<typeof collectQuestionRows>, accent: string) {
    return rows
      .map((q, i) => {
        const optionsHtml =
          q.type === 'text'
            ? `<textarea disabled rows="3" class="w-full border-2 border-ink bg-cream px-3 py-2 opacity-60" placeholder="（簡答題，受訪者會在這裡打字）"></textarea>`
            : `<div class="grid gap-1.5">${q.options
                .map(
                  (opt) => `
                <label class="flex items-center gap-2 text-ink-light">
                  <input type="${q.type === 'single' ? 'radio' : 'checkbox'}" disabled class="w-4 h-4" />
                  <span>${esc(opt.text || '（未填寫選項文字）')}${opt.isOther ? '（其他）' : ''}</span>
                </label>`
                )
                .join('')}</div>`;
        return `
          <div class="border-2 border-ink bg-cream p-5 mb-4">
            <p class="font-semibold text-ink mb-3">
              <span class="text-ink-light font-normal">Q${i + 1}.</span> ${esc(q.question_text || '（尚未填寫題目）')}
              ${q.required ? `<span style="color:${accent}" class="ml-1">*</span>` : ''}
            </p>
            ${optionsHtml}
          </div>
        `;
      })
      .join('');
  }

  document.getElementById('survey-preview-btn')?.addEventListener('click', () => {
    const rows = collectQuestionRows(surveyIdInput.value || null);
    const accent = SURVEY_THEME_COLORS[surveyThemeSelect.value] ?? SURVEY_THEME_COLORS.clay;
    previewBody.innerHTML = `
      <p class="inline-block bg-ink text-cream text-sm font-medium px-3 py-1 mb-4">問卷</p>
      <h1 class="font-display text-2xl text-ink mb-2">${esc(surveyTitleInput.value.trim() || '（尚未填寫標題）')}</h1>
      ${surveyDescriptionInput.value.trim() ? `<p class="text-ink-light mb-6">${esc(surveyDescriptionInput.value.trim())}</p>` : ''}
      ${rows.length === 0 ? '<p class="text-ink-light">還沒有新增題目。</p>' : renderQuestionPreviewHtml(rows, accent)}
      <button type="button" disabled style="background-color:${accent}" class="px-7 py-3 text-cream text-sm font-semibold opacity-60 mt-2">下一題（預覽模式無法作答）</button>
    `;
    previewModal.classList.remove('hidden');
  });

  document.getElementById('survey-preview-close')?.addEventListener('click', () => {
    previewModal.classList.add('hidden');
  });

  // ---------- 紙本問卷（列印） ----------
  document.getElementById('survey-print-btn')?.addEventListener('click', () => {
    const rows = collectQuestionRows(surveyIdInput.value || null);
    const title = surveyTitleInput.value.trim() || '（尚未填寫標題）';
    const description = surveyDescriptionInput.value.trim();

    const positionById = new Map(rows.map((r, i) => [r.id, i + 1]));
    function gotoLabel(goto: string | null) {
      if (!goto) return '';
      if (goto === '__submit__') return '（選此項將直接送出問卷）';
      if (goto === '__close__') return '（選此項將結束問卷，不記錄這次填答）';
      const targetPos = positionById.get(goto);
      return targetPos ? `（選此項將跳到第 ${targetPos} 題）` : '';
    }

    const bodyHtml = rows
      .map((q, i) => {
        const inner =
          q.type === 'text'
            ? `<div class="blank-lines"><div></div><div></div><div></div></div>`
            : q.options
                .map(
                  (opt) =>
                    `<div class="opt"><span class="box${q.type === 'single' ? ' round' : ''}"></span>${esc(opt.text || '')}${opt.isOther ? '（其他，請說明：__________）' : ''}${opt.goto ? ` <span class="goto">${gotoLabel(opt.goto)}</span>` : ''}</div>`
                )
                .join('');
        return `
          <div class="q">
            <p class="q-title">${i + 1}. ${esc(q.question_text || '')}${q.required ? ' ＊必填' : ''}</p>
            ${inner}
          </div>
        `;
      })
      .join('');

    const printHtml = `<!doctype html>
<html lang="zh-Hant"><head><meta charset="UTF-8" /><title>${esc(title)}（紙本問卷）</title>
<style>
  body { font-family: "Noto Sans TC", "Microsoft JhengHei", sans-serif; color: #1c1c1a; padding: 48px; max-width: 720px; margin: 0 auto; }
  h1 { font-size: 24px; margin-bottom: 6px; }
  p.desc { color: #5a5952; margin-bottom: 8px; }
  .fill-in { color: #5a5952; margin-bottom: 28px; border-bottom: 1px solid #999; padding-bottom: 8px; }
  .q { margin-bottom: 22px; page-break-inside: avoid; }
  .q-title { font-weight: 600; margin-bottom: 8px; }
  .opt { margin: 6px 0 6px 22px; }
  .goto { color: #b8360f; font-size: 12px; }
  .box { display: inline-block; width: 14px; height: 14px; border: 1.5px solid #1c1c1a; margin-right: 8px; vertical-align: middle; }
  .box.round { border-radius: 50%; }
  .blank-lines div { border-bottom: 1px solid #999; height: 30px; margin-left: 22px; }
  @media print { body { padding: 24px; } }
</style>
</head><body>
  <h1>${esc(title)}</h1>
  ${description ? `<p class="desc">${esc(description)}</p>` : ''}
  <p class="fill-in">姓名／班級（選填）：＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</p>
  ${bodyHtml}
</body></html>`;

    const printWin = window.open('', '_blank');
    if (!printWin) {
      alert('無法開啟列印視窗，請確認瀏覽器沒有擋彈出視窗。');
      return;
    }
    printWin.document.write(printHtml);
    printWin.document.close();
    printWin.onload = () => printWin.print();
  });

  surveyForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    surveyFormStatus.textContent = '儲存中...';

    const surveyPayload = {
      title: surveyTitleInput.value.trim(),
      description: surveyDescriptionInput.value.trim(),
      is_active: surveyActiveInput.checked,
      theme: surveyThemeSelect.value,
      opens_at: surveyOpensAtInput.value ? new Date(surveyOpensAtInput.value).toISOString() : null,
      closes_at: surveyClosesAtInput.value ? new Date(surveyClosesAtInput.value).toISOString() : null,
      access_mode: surveyAccessModeSelect.value,
      link_url: surveyLinkInput.value.trim() || null,
      pdf_url: surveyPdfInput.value || null,
    };

    let surveyId = surveyIdInput.value;
    if (surveyId) {
      const { error } = await supabase.from('surveys').update(surveyPayload).eq('id', surveyId);
      if (error) {
        surveyFormStatus.textContent = `儲存失敗：${error.message}`;
        return;
      }
    } else {
      const { data, error } = await supabase.from('surveys').insert(surveyPayload).select().single();
      if (error || !data) {
        surveyFormStatus.textContent = `儲存失敗：${error?.message}`;
        return;
      }
      surveyId = data.id;
      surveyIdInput.value = surveyId;
      syncAccessPanels();
    }

    if (removedQuestionIds.length) {
      await supabase.from('survey_questions').delete().in('id', removedQuestionIds);
      removedQuestionIds = [];
    }

    const questionRows = collectQuestionRows(surveyId);

    if (questionRows.length) {
      const { error } = await supabase.from('survey_questions').upsert(questionRows);
      if (error) {
        surveyFormStatus.textContent = `題目儲存失敗：${error.message}`;
        return;
      }
    }

    surveyFormStatus.textContent = '已儲存！';
    loadSurveyList();
  });

  // ---------- 回覆統計 ----------
  const statsTitle = document.getElementById('stats-title')!;
  const statsReportTitle = document.getElementById('stats-report-title')!;
  const statsCount = document.getElementById('stats-count')!;
  const statsContent = document.getElementById('stats-content')!;
  const copyLinkBtn = document.getElementById('copy-link-btn')!;
  const copyLinkStatus = document.getElementById('copy-link-status')!;
  const exportCsvBtn = document.getElementById('export-csv-btn')!;
  const printBtn = document.getElementById('print-btn')!;

  let currentStatsSurvey: Survey | null = null;
  let currentStatsQuestions: SurveyQuestion[] = [];
  let currentStatsResponses: { id: string; answers: Record<string, string | string[]>; submitted_at: string }[] = [];
  let currentStatsProgress: { furthest_position: number; status: string }[] = [];

  const DONUT_PALETTE = ['#e2481f', '#3f7a4a', '#f2b705', '#2c5a35', '#b8360f', '#c79a00', '#5a5952', '#1c1c1a'];

  function buildDonutHtml(labels: string[], counts: number[], total: number) {
    if (!total) return '';
    let cursor = 0;
    const stops = counts
      .map((c, idx) => {
        const pct = (c / total) * 100;
        const start = cursor;
        cursor += pct;
        return `${DONUT_PALETTE[idx % DONUT_PALETTE.length]} ${start}% ${cursor}%`;
      })
      .join(', ');
    const legend = labels
      .map(
        (label, idx) => `
        <div class="flex items-center gap-1.5 text-xs text-ink-light">
          <span class="inline-block w-2.5 h-2.5 shrink-0" style="background:${DONUT_PALETTE[idx % DONUT_PALETTE.length]}"></span>
          <span class="truncate">${esc(label)}</span>
        </div>
      `
      )
      .join('');
    return `
      <div class="flex items-center gap-4 mt-3">
        <div class="w-20 h-20 rounded-full shrink-0" style="background:conic-gradient(${stops})"></div>
        <div class="grid gap-1 min-w-0">${legend}</div>
      </div>
    `;
  }

  function renderQuestionStats(
    questions: SurveyQuestion[],
    responses: { answers: Record<string, string | string[]> }[],
    container: HTMLElement
  ) {
    container.innerHTML = '';
    questions.forEach((q, i) => {
      const block = document.createElement('div');
      block.className = 'border-2 border-ink bg-cream p-5';

      if (q.type === 'text') {
        const texts = responses
          .map((r) => r.answers[q.id])
          .filter((v): v is string => typeof v === 'string' && v.trim() !== '');
        block.innerHTML = `
          <p class="font-semibold text-ink mb-3">${i + 1}. ${esc(q.question_text)}（簡答，共 ${texts.length} 筆回覆）</p>
          <ul class="grid gap-2">
            ${texts.length ? texts.map((t) => `<li class="text-ink-light bg-cream-dark px-3 py-2 whitespace-pre-wrap break-words">${esc(t)}</li>`).join('') : '<li class="text-ink-light">還沒有回覆</li>'}
          </ul>
        `;
      } else {
        const total = responses.filter((r) => r.answers[q.id] !== undefined).length;
        const correctIds = new Set(q.options.filter((o) => o.correct).map((o) => o.id));
        const hasCorrectAnswer = correctIds.size > 0;
        const otherOption = q.options.find((o) => o.isOther);
        let correctCount = 0;

        const counts: Record<string, number> = {};
        q.options.forEach((o) => (counts[o.id] = 0));
        const otherTexts: string[] = [];

        const normalize = (v: string) => {
          if (v.startsWith('other:')) {
            if (otherOption) otherTexts.push(v.slice('other:'.length));
            return otherOption?.id ?? v;
          }
          return v;
        };

        responses.forEach((r) => {
          const value = r.answers[q.id];
          if (value === undefined) return;
          const selected = (Array.isArray(value) ? value : [value]).map(normalize);
          selected.forEach((v) => {
            if (counts[v] !== undefined) counts[v]++;
          });
          if (hasCorrectAnswer) {
            const selectedSet = new Set(selected);
            const isCorrect =
              selectedSet.size === correctIds.size && [...selectedSet].every((v) => correctIds.has(v));
            if (isCorrect) correctCount++;
          }
        });

        const optionRows = q.options
          .map((o) => {
            const count = counts[o.id] ?? 0;
            const pct = total ? Math.round((count / total) * 100) : 0;
            return `
              <div>
                <div class="flex items-center justify-between text-sm mb-1">
                  <span class="text-ink">${esc(o.text)}${o.correct ? ' ✅' : ''}</span>
                  <span class="text-ink-light">${count} 票・${pct}%</span>
                </div>
                <div class="h-2 bg-cream-dark"><div class="h-2 bg-clay" style="width:${pct}%"></div></div>
              </div>
            `;
          })
          .join('');

        const otherTextsHtml = otherTexts.length
          ? `<div class="mt-3"><p class="text-xs font-semibold text-ink-light mb-1.5">「${esc(otherOption?.text ?? '其他')}」填寫內容：</p><ul class="grid gap-1.5">${otherTexts.map((t) => `<li class="text-sm text-ink-light bg-cream-dark px-3 py-1.5 whitespace-pre-wrap break-words">${esc(t)}</li>`).join('')}</ul></div>`
          : '';

        const donutHtml =
          q.type === 'single' && total > 0
            ? buildDonutHtml(
                q.options.map((o) => o.text),
                q.options.map((o) => counts[o.id] ?? 0),
                total
              )
            : '';

        block.innerHTML = `
          <p class="font-semibold text-ink mb-1">${i + 1}. ${esc(q.question_text)}（${q.type === 'single' ? '單選' : '複選'}，共 ${total} 筆回覆${hasCorrectAnswer ? `・答對率 ${total ? Math.round((correctCount / total) * 100) : 0}%` : ''}）</p>
          <div class="grid gap-3 mt-3">${optionRows}</div>
          ${donutHtml}
          ${otherTextsHtml}
        `;
      }

      container.appendChild(block);
    });
  }

  function renderCompletionSummary() {
    const container = document.getElementById('completion-summary')!;
    const started = currentStatsProgress.length;
    const submitted = currentStatsProgress.filter((p) => p.status === 'submitted').length;
    const closed = currentStatsProgress.filter((p) => p.status === 'closed').length;
    const abandoned = started - submitted - closed;
    const rate = started ? Math.round((submitted / started) * 100) : 0;

    const cards = [
      { label: '開始填寫', value: started },
      { label: '完成送出', value: `${submitted}（${rate}%）` },
      { label: '中途離開／未送出', value: Math.max(abandoned, 0) },
    ];
    container.innerHTML = cards
      .map(
        (c) => `
        <div class="bg-sage-light border-2 border-ink p-4 text-center">
          <p class="font-display text-2xl text-ink">${c.value}</p>
          <p class="text-xs text-ink-light mt-1">${c.label}</p>
        </div>
      `
      )
      .join('');
  }

  function renderTrendChart() {
    const container = document.getElementById('trend-chart')!;
    if (currentStatsResponses.length === 0) {
      container.innerHTML = '';
      return;
    }
    const countsByDay: Record<string, number> = {};
    currentStatsResponses.forEach((r) => {
      const day = new Date(r.submitted_at).toLocaleDateString('zh-Hant-TW', { month: 'numeric', day: 'numeric' });
      countsByDay[day] = (countsByDay[day] ?? 0) + 1;
    });
    const days = Object.keys(countsByDay);
    const max = Math.max(...Object.values(countsByDay));
    container.innerHTML = `
      <p class="text-xs font-semibold text-ink-light mb-2">回覆趨勢</p>
      <div class="flex items-end gap-2 h-24 border-b-2 border-ink px-1">
        ${days
          .map((d) => {
            const h = Math.max(4, Math.round((countsByDay[d] / max) * 88));
            return `<div class="flex-1 flex flex-col items-center gap-1" title="${d}：${countsByDay[d]} 筆">
              <span class="text-xs text-ink-light">${countsByDay[d]}</span>
              <div class="w-full bg-clay" style="height:${h}px"></div>
            </div>`;
          })
          .join('')}
      </div>
      <div class="flex gap-2 px-1 mt-1">
        ${days.map((d) => `<span class="flex-1 text-center text-xs text-ink-light">${d}</span>`).join('')}
      </div>
    `;
  }

  function setupCrosstabControls() {
    const controls = document.getElementById('crosstab-controls')!;
    const questionSelect = document.getElementById('crosstab-question') as HTMLSelectElement;
    const optionSelect = document.getElementById('crosstab-option') as HTMLSelectElement;
    const summary = document.getElementById('crosstab-summary')!;

    const choiceQuestions = currentStatsQuestions.filter((q) => q.type !== 'text');
    if (choiceQuestions.length === 0) {
      controls.classList.add('hidden');
      return;
    }
    controls.classList.remove('hidden');
    questionSelect.innerHTML =
      '<option value="">不篩選</option>' +
      choiceQuestions.map((q) => `<option value="${q.id}">${esc(q.question_text)}</option>`).join('');

    function applyFilter() {
      const qid = questionSelect.value;
      const oid = optionSelect.value;
      if (!qid || !oid) {
        renderQuestionStats(currentStatsQuestions, currentStatsResponses, statsContent);
        summary.textContent = '';
        return;
      }
      const filtered = currentStatsResponses.filter((r) => {
        const value = r.answers[qid];
        if (value === undefined) return false;
        return Array.isArray(value) ? value.includes(oid) : value === oid;
      });
      renderQuestionStats(currentStatsQuestions, filtered, statsContent);
      summary.textContent = `符合條件：${filtered.length} / ${currentStatsResponses.length} 筆`;
    }

    questionSelect.onchange = () => {
      const q = choiceQuestions.find((q) => q.id === questionSelect.value);
      if (!q) {
        optionSelect.classList.add('hidden');
        applyFilter();
        return;
      }
      optionSelect.classList.remove('hidden');
      optionSelect.innerHTML =
        '<option value="">全部</option>' + q.options.map((o) => `<option value="${o.id}">${esc(o.text)}</option>`).join('');
      applyFilter();
    };
    optionSelect.onchange = applyFilter;
  }

  async function openStatsView(survey: Survey) {
    currentStatsSurvey = survey;
    statsTitle.textContent = survey.title;
    statsReportTitle.textContent = `${survey.title}｜問卷統計報告`;
    statsContent.innerHTML = '';
    copyLinkStatus.textContent = '';

    const { data: questions } = await supabase
      .from('survey_questions')
      .select('*')
      .eq('survey_id', survey.id)
      .order('position', { ascending: true });
    currentStatsQuestions = (questions ?? []) as SurveyQuestion[];

    const { data: responses } = await supabase
      .from('survey_responses')
      .select('*')
      .eq('survey_id', survey.id)
      .order('submitted_at', { ascending: false });
    currentStatsResponses = (responses ?? []) as { id: string; answers: Record<string, string | string[]>; submitted_at: string }[];

    const { data: progress } = await supabase
      .from('survey_progress')
      .select('furthest_position, status')
      .eq('survey_id', survey.id);
    currentStatsProgress = progress ?? [];

    statsCount.textContent = `共 ${currentStatsResponses.length} 筆回覆`;

    renderCompletionSummary();
    renderTrendChart();
    setupCrosstabControls();
    renderQuestionStats(currentStatsQuestions, currentStatsResponses, statsContent);

    showView('stats');
  }

  // ---------- 問卷比較 ----------
  const compareBtn = document.getElementById('compare-btn')!;
  const compareSurveyASelect = document.getElementById('compare-survey-a') as HTMLSelectElement;
  const compareSurveyBSelect = document.getElementById('compare-survey-b') as HTMLSelectElement;
  const compareContent = document.getElementById('compare-content')!;

  async function loadCompareData(surveyId: string) {
    const { data: questions } = await supabase
      .from('survey_questions')
      .select('*')
      .eq('survey_id', surveyId)
      .order('position', { ascending: true });
    const { data: responses } = await supabase.from('survey_responses').select('*').eq('survey_id', surveyId);
    return { questions: (questions ?? []) as SurveyQuestion[], responses: responses ?? [] };
  }

  function miniBars(q: SurveyQuestion, responses: { answers: Record<string, string | string[]> }[]) {
    if (q.type === 'text') {
      const count = responses.filter((r) => typeof r.answers[q.id] === 'string' && (r.answers[q.id] as string).trim()).length;
      return `<p class="text-sm text-ink-light">簡答題，共 ${count} 筆回覆</p>`;
    }
    const total = responses.filter((r) => r.answers[q.id] !== undefined).length;
    const counts: Record<string, number> = {};
    q.options.forEach((o) => (counts[o.id] = 0));
    responses.forEach((r) => {
      const value = r.answers[q.id];
      if (value === undefined) return;
      const selected = Array.isArray(value) ? value : [value];
      selected.forEach((v) => {
        const normalized = v.startsWith('other:') ? q.options.find((o) => o.isOther)?.id : v;
        if (normalized && counts[normalized] !== undefined) counts[normalized]++;
      });
    });
    return `
      <p class="text-xs text-ink-light mb-2">共 ${total} 筆回覆</p>
      <div class="grid gap-2">
        ${q.options
          .map((o) => {
            const count = counts[o.id] ?? 0;
            const pct = total ? Math.round((count / total) * 100) : 0;
            return `
              <div>
                <div class="flex items-center justify-between text-xs mb-0.5">
                  <span class="text-ink">${esc(o.text)}</span>
                  <span class="text-ink-light">${count}・${pct}%</span>
                </div>
                <div class="h-1.5 bg-cream-dark"><div class="h-1.5 bg-clay" style="width:${pct}%"></div></div>
              </div>
            `;
          })
          .join('')}
      </div>
    `;
  }

  async function renderCompare() {
    const idA = compareSurveyASelect.value;
    const idB = compareSurveyBSelect.value;
    if (!idA || !idB) return;
    compareContent.innerHTML = '<p class="text-ink-light">載入中...</p>';
    const [a, b] = await Promise.all([loadCompareData(idA), loadCompareData(idB)]);
    const maxLen = Math.max(a.questions.length, b.questions.length);
    const blocks: string[] = [];
    for (let i = 0; i < maxLen; i++) {
      const qa = a.questions[i];
      const qb = b.questions[i];
      blocks.push(`
        <div class="border-2 border-ink bg-cream p-5">
          <p class="font-semibold text-ink mb-4">第 ${i + 1} 題</p>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <p class="text-xs font-semibold text-clay mb-2">A：${qa ? esc(qa.question_text) : '（此問卷沒有這一題）'}</p>
              ${qa ? miniBars(qa, a.responses) : ''}
            </div>
            <div>
              <p class="text-xs font-semibold text-sage-dark mb-2">B：${qb ? esc(qb.question_text) : '（此問卷沒有這一題）'}</p>
              ${qb ? miniBars(qb, b.responses) : ''}
            </div>
          </div>
        </div>
      `);
    }
    compareContent.innerHTML = blocks.join('');
  }

  compareBtn.addEventListener('click', async () => {
    const { data: allSurveys } = await supabase.from('surveys').select('*').order('created_at', { ascending: false });
    const options = (allSurveys ?? [])
      .map((s) => `<option value="${s.id}">${esc(s.title)}</option>`)
      .join('');
    compareSurveyASelect.innerHTML = options;
    compareSurveyBSelect.innerHTML = options;
    if (currentStatsSurvey) {
      compareSurveyASelect.value = currentStatsSurvey.id;
      const other = (allSurveys ?? []).find((s) => s.id !== currentStatsSurvey!.id);
      if (other) compareSurveyBSelect.value = other.id;
    }
    showView('compare');
    renderCompare();
  });

  compareSurveyASelect.addEventListener('change', renderCompare);
  compareSurveyBSelect.addEventListener('change', renderCompare);

  copyLinkBtn.addEventListener('click', async () => {
    if (!currentStatsSurvey) return;
    const url = `${window.location.origin}/survey/${currentStatsSurvey.id}`;
    await navigator.clipboard.writeText(url);
    copyLinkStatus.textContent = `已複製：${url}`;
  });

  function csvEscape(value: string) {
    if (/[",\n]/.test(value)) {
      return `"${value.replace(/"/g, '""')}"`;
    }
    return value;
  }

  exportCsvBtn.addEventListener('click', () => {
    if (!currentStatsSurvey) return;
    const optionTextById: Record<string, string> = {};
    currentStatsQuestions.forEach((q) => q.options.forEach((o) => (optionTextById[o.id] = o.text)));

    const resolveOption = (v: string) => (v.startsWith('other:') ? `其他：${v.slice('other:'.length)}` : optionTextById[v] ?? v);

    const headers = ['送出時間', ...currentStatsQuestions.map((q) => q.question_text)];
    const rows = currentStatsResponses.map((r) => {
      const cells = currentStatsQuestions.map((q) => {
        const value = r.answers[q.id];
        if (value === undefined) return '';
        if (Array.isArray(value)) return value.map(resolveOption).join('、');
        if (q.type === 'text') return value;
        return resolveOption(value);
      });
      return [new Date(r.submitted_at).toLocaleString('zh-Hant-TW'), ...cells];
    });

    const csv = [headers, ...rows].map((row) => row.map((cell) => csvEscape(String(cell))).join(',')).join('\n');
    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${currentStatsSurvey.title || 'survey'}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  printBtn.addEventListener('click', () => window.print());
</script>
