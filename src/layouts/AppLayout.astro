---
// TransitGo（交通即時查）App 的獨立版型：不使用個人網站的導覽列、頁尾、頭像、結構化資料。
// App 的使用者看到的只有 App 本身與客服聯絡方式。
import { APP_NAME } from '../lib/app';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = `${title}｜${APP_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://yayalin.com').toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { href: '/app', label: '首頁' },
  { href: '/app/business', label: '商家後台' },
  { href: '/app/support', label: '客服與意見回饋' },
  { href: '/app/privacy', label: '隱私權政策' },
  { href: '/app/terms', label: '服務條款' },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/app-assets/app-touch-icon.png" />
    <link rel="apple-touch-icon" href="/app-assets/app-touch-icon-180.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/app-assets/logo.png', Astro.site ?? 'https://yayalin.com').toString()} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/app">
        <img class="logo" src="/app-assets/logo-icon.png" width="34" height="34" alt="" />
        <span>{APP_NAME}</span>
      </a>
      <nav aria-label="頁面">
        {tabs.map((t) => (
          <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>{APP_NAME}　·　客服信箱 <a href="mailto:app&#64;yayalin.com">app&#64;yayalin.com</a></p>
      <p><a href="/app/privacy">隱私權政策</a>　·　<a href="/app/terms">服務條款</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    /* 跟正式 App 圖示同一套顏色（圖示本身是藍到綠的漸層、深藍字），取代先前暫時借用個人網站的紅筆色 */
    --bg: #fbfdff; --card: #ffffff; --text: #0e2038; --muted: #57667e; --line: #e2e8f1;
    --accent: #0a6cf0; --accent-soft: #e6f1ff; --accent2: #0fb88a; --accent2-soft: #e3faf3; --warn-soft: #fff7b0;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0b1626; --card: #101d33; --text: #eef3fa; --muted: #9fb0c6; --line: #24344c; --accent: #4da3ff; --accent-soft: #0a6cf033; --accent2: #2bd9ac; --accent2-soft: #0fb88a33; --warn-soft: #ffe94a26; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.8 -apple-system, "PingFang TC", "Noto Sans TC", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  header.top { max-width: 780px; margin: 0 auto; padding: 22px 20px 6px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 20px; color: var(--text); text-decoration: none; }
  .logo { display: block; width: 34px; height: 34px; object-fit: contain; }
  header.top nav { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  header.top nav a { padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--muted); text-decoration: none; border: 1px solid transparent; }
  header.top nav a[aria-current='page'] { background: var(--accent-soft); color: var(--accent); border-color: var(--accent-soft); }
  main { max-width: 780px; margin: 0 auto; padding: 8px 20px 40px; }
  footer { max-width: 780px; margin: 0 auto; padding: 0 20px 44px; color: var(--muted); font-size: 13px; text-align: center; }
  footer p { margin: 4px 0; }
  a { color: var(--accent); }
</style>
