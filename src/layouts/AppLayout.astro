---
// TransitGo（交通即時查）App 的獨立版型：不使用個人網站的導覽列、頁尾、頭像、結構化資料。
// App 的使用者看到的只有 App 本身與客服聯絡方式。
import { APP_NAME } from '../lib/app';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = `${title}｜${APP_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://yayalin.com').toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { href: '/app', label: '首頁' },
  { href: '/app/support', label: '客服與意見回饋' },
  { href: '/app/privacy', label: '隱私權政策' },
  { href: '/app/terms', label: '服務條款' },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/app"><span class="logo" aria-hidden="true">🚌</span><span>{APP_NAME}</span></a>
      <nav aria-label="頁面">
        {tabs.map((t) => (
          <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>{APP_NAME}　·　客服信箱 <a href="mailto:app&#64;yayalin.com">app&#64;yayalin.com</a></p>
      <p><a href="/app/privacy">隱私權政策</a>　·　<a href="/app/terms">服務條款</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #f5f7fb; --card: #ffffff; --text: #1a2233; --muted: #5b6579; --line: #dfe4ee;
    --accent: #0a6cf0; --accent-soft: #0a6cf01a; --warn-soft: #ffb4001f;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0d1220; --card: #161d30; --text: #edf0f7; --muted: #9aa5be; --line: #27314a; --accent: #6aa5ff; --accent-soft: #6aa5ff24; --warn-soft: #ffb4002b; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.8 -apple-system, "PingFang TC", "Noto Sans TC", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  header.top { max-width: 780px; margin: 0 auto; padding: 22px 20px 6px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 20px; color: var(--text); text-decoration: none; }
  .logo { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--accent); color: #fff; font-size: 18px; }
  header.top nav { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  header.top nav a { padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--muted); text-decoration: none; border: 1px solid transparent; }
  header.top nav a[aria-current='page'] { background: var(--accent-soft); color: var(--accent); border-color: var(--accent-soft); }
  main { max-width: 780px; margin: 0 auto; padding: 8px 20px 40px; }
  footer { max-width: 780px; margin: 0 auto; padding: 0 20px 44px; color: var(--muted); font-size: 13px; text-align: center; }
  footer p { margin: 4px 0; }
  a { color: var(--accent); }
</style>
